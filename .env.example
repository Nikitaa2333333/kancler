# Адрес сайта для canonical/sitemap (после выбора домена)
PUBLIC_SITE=

# Приёмник заявок с формы (Google Apps Script web app → почта + Telegram + таблица)
# Пока пусто — форма показывает «отправка не подключена».
PUBLIC_LEAD_ENDPOINT=

# Счётчик Яндекс.Метрики (после заведения счётчика)
PUBLIC_METRIKA_ID=

# Выпустить сайт в индекс (true только после запуска на боевом домене)
PUBLIC_INDEXING=false
