---
// Уведомление о cookie и Яндекс Метрике (правка №315, по образцу сайта клиники ctmedspb.ru):
// полоса во всю ширину внизу экрана, «Ок» запоминается на год в localStorage.
// Метрика работает и без нажатия — это уведомление, а не запрос согласия.
import { u } from '../lib/url';
import { typo } from '../lib/typo';
---

<div class="cc" id="cc" role="region" aria-label="Уведомление о файлах cookie" hidden>
  <p class="cc__text">
    {typo('Мы используем cookie и Яндекс Метрику, чтобы сайт работал лучше.')}
    <a href={u('/politika/#cookie')} data-design-ok>Подробнее</a>
  </p>
  <button type="button" class="cc__ok" data-cc-ok>Ок</button>
</div>

<script>
  const KEY = 'kancler-cc';
  const box = document.getElementById('cc');
  const seen = () => {
    try { const t = localStorage.getItem(KEY); return !!t && Date.now() - Number(t) < 365 * 864e5; }
    catch { return false; }
  };
  if (box && !seen()) {
    box.hidden = false;
    // высота полосы — для плавающей кнопки «Написать нам», чтобы встала над полосой
    const root = document.documentElement;
    const setH = () => root.style.setProperty('--cc-h', box.hidden ? '0px' : `${box.offsetHeight}px`);
    setH();
    addEventListener('resize', setH);
    requestAnimationFrame(() => box.classList.add('is-on'));
    box.querySelector('[data-cc-ok]')?.addEventListener('click', () => {
      try { localStorage.setItem(KEY, String(Date.now())); } catch {}
      box.classList.remove('is-on');
      root.style.setProperty('--cc-h', '0px');
      setTimeout(() => { box.hidden = true; }, 300);
    });
  }
</script>

<style>
  .cc {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px var(--gutter);
    padding-bottom: calc(12px + env(safe-area-inset-bottom));
    background: var(--c-primary);
    color: var(--c-white);
    transform: translateY(100%);
    transition: transform .3s cubic-bezier(.2, .7, .2, 1);
  }
  .cc.is-on { transform: none; }
  .cc[hidden] { display: none; }
  .cc__text { flex: 1; margin: 0; font-size: 15px; line-height: 1.35; }
  .cc__text a { color: inherit; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .cc__text a:hover { opacity: .8; }
  .cc__ok {
    flex: none;
    min-height: 44px;
    padding: 0 32px;
    border: 0;
    border-radius: 999px;
    background: var(--c-white);
    color: var(--c-primary);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s;
  }
  .cc__ok:hover { background: var(--c-tint); }
  @media (min-width: 761px) { .cc { justify-content: center; } .cc__text { flex: 0 1 auto; } }
  @media (prefers-reduced-motion: reduce) { .cc { transition: none; } }
</style>
