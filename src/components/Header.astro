---
import { company, nav } from '../data/company';
import { typo } from '../lib/typo';
import { u } from '../lib/url';
---

<!-- Узкая шапка на всю ширину, всегда закреплена (решение пользователя 23.10.2026).
     Линия снизу — структурная граница липкой шапки (разрешена правилами). -->
<header class="hdr">
  <div class="wrap hdr__bar">
    <a class="hdr__logo" href={u('/')} aria-label={`${company.name} — на главную`}>{company.name}</a>

    <nav class="hdr__nav" aria-label="Основное меню">
      <ul class="hdr__links">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="hdr__right">
      {company.phone && (
        <a class="hdr__phone" href={`tel:${company.phoneHref}`}>{company.phone}</a>
      )}
      {company.telegram && <a class="hdr__chip" href={company.telegram} rel="noopener" aria-label="Telegram">TG</a>}
      {company.whatsapp && <a class="hdr__chip" href={company.whatsapp} rel="noopener" aria-label="WhatsApp">WA</a>}
      <a class="btn btn--sm hdr__cta" href="#zayavka">{typo('Оставить заявку')}</a>

      <details class="hdr__burger">
        <summary aria-label="Меню"><span></span><span></span><span></span></summary>
        <ul class="hdr__drop">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  const h = document.querySelector<HTMLElement>('.hdr');
  h?.querySelectorAll('a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => h.querySelector('details')?.removeAttribute('open')),
  );
</script>

<style>
  .hdr {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    right: 0;
    background: rgb(247 246 245 / 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-faint);
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--hdr-h);
  }
  .hdr__logo {
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: 22px;
    letter-spacing: -0.02em;
    text-decoration: none;
    line-height: 1;
  }
  .hdr__nav { margin-right: auto; }
  .hdr__links { display: flex; gap: 24px; }
  .hdr__links a, .hdr__phone { text-decoration: none; font-weight: var(--w-medium); font-size: 15px; }
  .hdr__links a:hover { color: var(--c-ink-deep); text-decoration: underline; text-underline-offset: 4px; }

  .hdr__right { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
  .hdr__phone { margin-right: 6px; white-space: nowrap; }
  .hdr__chip {
    display: inline-grid; place-items: center; min-width: 36px; height: 36px; padding-inline: 8px;
    border-radius: var(--r-sm); background: var(--fill-card-strong);
    font-size: var(--fs-small); font-weight: var(--w-semibold); text-decoration: none;
  }

  .hdr__burger { display: none; position: relative; }
  .hdr__burger summary {
    list-style: none; cursor: pointer; width: 40px; height: 40px; display: grid; align-content: center; gap: 5px; padding-inline: 9px;
  }
  .hdr__burger summary::-webkit-details-marker { display: none; }
  .hdr__burger summary span { display: block; height: 2px; background: var(--c-ink); border-radius: 2px; }
  .hdr__drop {
    position: absolute; right: 0; top: calc(100% + 10px); min-width: 220px; padding: 12px;
    background: var(--c-white-card); color: var(--c-ink); border-radius: var(--r-md); box-shadow: 0 8px 24px rgb(11 46 60 / 0.14);
    display: grid; gap: 4px;
  }
  .hdr__drop a { display: block; padding: 10px 12px; text-decoration: none; font-weight: var(--w-medium); border-radius: var(--r-sm); }
  .hdr__drop a:hover { background: var(--fill-card-strong); }

  @media (max-width: 980px) {
    .hdr__nav { display: none; }
    .hdr__right { margin-left: auto; }
    .hdr__burger { display: block; }
    .hdr__phone { display: none; }
  }
  @media (max-width: 560px) { .hdr__cta { display: none; } }
</style>
