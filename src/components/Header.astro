---
import { company, nav } from '../data/company';
import { typo } from '../lib/typo';
import { u } from '../lib/url';
---

<header class="hdr" data-hdr>
  <div class="hdr__plate">
    <nav class="hdr__nav" aria-label="Основное меню">
      <ul class="hdr__links">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <a class="hdr__logo" href={u('/')} aria-label={`${company.name} — на главную`}>{company.name}</a>

    <div class="hdr__right">
      {company.phone && (
        <a class="hdr__phone" href={`tel:${company.phoneHref}`}>{company.phone}</a>
      )}
      {company.telegram && <a class="hdr__chip" href={company.telegram} rel="noopener" aria-label="Telegram">TG</a>}
      {company.whatsapp && <a class="hdr__chip" href={company.whatsapp} rel="noopener" aria-label="WhatsApp">WA</a>}
      <a class="btn hdr__cta" href="#zayavka">{typo('Оставить заявку')}</a>

      <details class="hdr__burger">
        <summary aria-label="Меню"><span></span><span></span><span></span></summary>
        <ul class="hdr__drop">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  // Прозрачная шапка поверх hero, плашка — после прокрутки.
  const h = document.querySelector<HTMLElement>('[data-hdr]');
  if (h) {
    const set = () => h.classList.toggle('is-top', window.scrollY < 40);
    set();
    window.addEventListener('scroll', set, { passive: true });
    h.querySelectorAll('a[href^="#"]').forEach((a) =>
      a.addEventListener('click', () => h.querySelector('details')?.removeAttribute('open')),
    );
  }
</script>

<style>
  .hdr {
    position: fixed;
    z-index: 50;
    top: calc(var(--hero-frame) + 8px);
    left: 0;
    right: 0;
    padding-inline: calc(var(--hero-frame) + 8px);
    pointer-events: none;
  }
  .hdr__plate {
    pointer-events: auto;
    max-width: calc(var(--page-max) - 2 * var(--gutter));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 8px 8px 8px 20px;
    border-radius: var(--r-md);
    background: var(--c-paper);
    color: var(--c-ink);
    box-shadow: 0 8px 24px rgb(11 46 60 / 0.1);
    transition: background-color .25s, box-shadow .25s, color .25s;
  }
  /* Первый экран светлый: вверху плашка просто прозрачная, цвета те же */
  .hdr.is-top .hdr__plate { background: transparent; box-shadow: none; }

  .hdr__links { display: flex; gap: 24px; }
  .hdr__links a, .hdr__phone { text-decoration: none; font-weight: var(--w-medium); }
  .hdr__links a:hover { text-decoration: underline; text-underline-offset: 4px; }

  .hdr__logo {
    font-family: var(--ff-display);
    font-size: var(--fs-h5);
    letter-spacing: var(--tr-h5);
    text-decoration: none;
    line-height: 1;
  }

  .hdr__right { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
  .hdr__phone { margin-right: 6px; white-space: nowrap; }
  .hdr__chip {
    display: inline-grid; place-items: center; min-width: 38px; height: 38px; padding-inline: 8px;
    border: 1px solid var(--line-subtle); border-radius: var(--r-sm);
    font-size: var(--fs-small); font-weight: var(--w-semibold); text-decoration: none;
  }

  .hdr__burger { display: none; position: relative; }
  .hdr__burger summary {
    list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; align-content: center; gap: 5px; padding-inline: 11px;
  }
  .hdr__burger summary::-webkit-details-marker { display: none; }
  .hdr__burger summary span { display: block; height: 2px; background: var(--c-ink); border-radius: 2px; }
  .hdr__drop {
    position: absolute; right: 0; top: calc(100% + 12px); min-width: 220px; padding: 12px;
    background: var(--c-paper); color: var(--c-ink); border-radius: var(--r-md); box-shadow: 0 8px 24px rgb(11 46 60 / 0.16);
    display: grid; gap: 4px;
  }
  .hdr__drop a { display: block; padding: 10px 12px; text-decoration: none; font-weight: var(--w-medium); border-radius: var(--r-sm); }
  .hdr__drop a:hover { background: var(--fill-card-strong); }

  @media (max-width: 980px) {
    .hdr__nav { display: none; }
    .hdr__plate { grid-template-columns: auto 1fr; }
    .hdr__burger { display: block; }
    .hdr__phone { display: none; }
  }
  @media (max-width: 560px) {
    .hdr__cta { display: none; }
  }
</style>
