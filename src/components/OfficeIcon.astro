---
/* Жирные «канцелярские» знаки к пунктам услуг (правка №56, 30.10; референс пользователя —
   набор офисных пиктограмм: папка, скрепка, стрелка, звезда-клякса). Толстая линия 2.4px,
   прямые концы, один цвет — текста. Знак предметный, по смыслу пункта, не абстракция. */
interface Props { name: string; grad?: boolean }
const { name, grad } = Astro.props;
/* grad — знак с градиентом синий → голубой (№191, первый экран и шаги) */
const gid = `og${Math.random().toString(36).slice(2, 8)}`;
/* звезда-клякса: 12 лучей */
const star = Array.from({ length: 24 }, (_, i) => {
  const a = (Math.PI / 12) * i - Math.PI / 2;
  const r = i % 2 ? 6.2 : 10.5;
  return `${(12 + r * Math.cos(a)).toFixed(2)},${(12 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
const paths: Record<string, string> = {
  folder: '<path d="M2.5 5.5h6.5l2 2.5h10.5v11.5h-19z"/><path d="M2.5 11h19"/>',
  percent: '<circle cx="7" cy="7" r="2.6" fill="currentColor" stroke="none"/><circle cx="17" cy="17" r="2.6" fill="currentColor" stroke="none"/><path d="M19 4.5 5 19.5"/>',
  clip: '<path d="M16.5 7v9a4.5 4.5 0 0 1-9 0V6a3 3 0 0 1 6 0v9.5a1.5 1.5 0 0 1-3 0V8"/>',
  upload: '<circle cx="12" cy="12" r="10.5" fill="currentColor" stroke="none"/><path d="M12 17.5V7.5M7.5 11.5 12 7l4.5 4.5" stroke="var(--icon-bg, #fff)"/>',
  trend: '<path d="M2.5 18.5l6.5-6.5 4 4 8-8"/><path d="M15 8h6v6"/>',
  swap: '<path d="M3.5 8h15M14.5 4l4 4-4 4"/><path d="M20.5 16h-15M9.5 12l-4 4 4 4"/>',
  star: `<polygon points="${star}" fill="currentColor" stroke="none"/>`,
  calendar: '<path d="M3 5.5h18v15.5H3z"/><path d="M3 10.5h18M8 2.5v5M16 2.5v5"/><path d="M13.5 14h4v4h-4z" fill="currentColor" stroke="none"/>',
  check: '<circle cx="12" cy="12" r="9.5"/><path d="m7.5 12.5 3 3 6-7"/>',
  split: '<path d="M3 4h8v16H3z" fill="currentColor" stroke="none"/><path d="M14 5.2h6.8v13.6H14z"/>',
  ruble: '<circle cx="12" cy="12" r="10.5" fill="currentColor" stroke="none"/><path d="M10 18V6.5h3.8a3 3 0 0 1 0 6H8M8 15.5h6" stroke="var(--icon-bg, #fff)"/>',
  /* щит с галочкой — знак гарантии (правка №79) */
  shield: '<path d="M12 1.5 3 5v6.5c0 5.6 3.8 9.6 9 11 5.2-1.4 9-5.4 9-11V5z" fill="currentColor" stroke="none"/><path d="m7.8 11.8 3 3 5.4-6" stroke="var(--icon-bg, #fff)"/>',
  plus: '<circle cx="12" cy="12" r="10.5" fill="currentColor" stroke="none"/><path d="M12 7v10M7 12h10" stroke="var(--icon-bg, #fff)"/>',
  briefcase: '<path d="M2.5 7.5h19v13h-19z" fill="currentColor" stroke="none"/><path d="M8.5 7.5V4h7v3.5"/><path d="M2.5 13h19" stroke="var(--icon-bg, #fff)"/>',
  calc: '<path d="M4.5 2.5h15v19h-15z"/><path d="M8 6.5h8v3H8z" fill="currentColor" stroke="none"/><path d="M8 13.5h1.5M11.25 13.5h1.5M14.5 13.5H16M8 17.5h1.5M11.25 17.5h1.5M14.5 17.5H16"/>',
  /* №183 (02.11): свой знак на каждый смысл, без повторов на главной */
  crane: '<path d="M6 21.5V2.5M6 5h15M6 2.5 9.5 5M16.5 5v5"/><path d="M14.5 10h4v3.5h-4z" fill="currentColor" stroke="none"/><path d="M2.5 21.5h7"/>',
  docCheck: '<path d="M5 2.5h9.5l4.5 4.5v14.5H5z"/><path d="M14.5 2.5V7H19"/><path d="m8.5 14 2.5 2.5 4.5-5"/>',
  roller: '<path d="M3 3h14v5.5H3z" fill="currentColor" stroke="none"/><path d="M17 5.75h3.5v6.5H11V15"/><path d="M9.25 15h3.5v6.5h-3.5z" fill="currentColor" stroke="none"/>',
  compass: '<circle cx="12" cy="4.5" r="2"/><path d="M11 6.5 5.5 21.5M13 6.5l5.5 15M7.6 15.5h8.8"/>',
  key: '<circle cx="7" cy="12" r="4.5"/><path d="M11.5 12h10M18 12v4.5M21.5 12v3.5"/>',
  layers: '<path d="M12 2.5 22 7.5 12 12.5 2 7.5z" fill="currentColor" stroke="none"/><path d="m2 12 10 5 10-5M2 16.5l10 5 10-5"/>',
  restore: '<path d="M20 12.5a8 8 0 1 1-2.6-6.4"/><path d="M20.5 2.5V7H16"/><path d="M12 8v4.5l3 2"/>',
  wallet: '<path d="M2.5 7h19v14h-19z"/><path d="M15 12h6.5v4H15z" fill="currentColor" stroke="none"/><path d="M5 7l11-4.5V7"/>',
  chart: '<path d="M2.5 21.5h19"/><path d="M4.5 12h3.5v7H4.5zM10.25 7.5h3.5V19h-3.5zM16 3h3.5v16H16z" fill="currentColor" stroke="none"/>',
  coins: '<circle cx="9" cy="9" r="6.5"/><path d="M14.8 6.3a6.5 6.5 0 1 1-8.5 8.5"/><path d="M9 6v6"/>',
  alert: '<path d="M12 2 22.5 21h-21z" fill="currentColor" stroke="none"/><path d="M12 9v5.5M12 17v.5" stroke="var(--icon-bg, #fff)"/>',
  team: '<circle cx="12" cy="6.5" r="3.2" fill="currentColor" stroke="none"/><circle cx="4.8" cy="9" r="2.4" fill="currentColor" stroke="none"/><circle cx="19.2" cy="9" r="2.4" fill="currentColor" stroke="none"/><path d="M6.5 21v-3a5.5 5.5 0 0 1 11 0v3z" fill="currentColor" stroke="none"/><path d="M1.5 20v-2.5A3.5 3.5 0 0 1 5 14M22.5 20v-2.5A3.5 3.5 0 0 0 19 14"/>',
  /* каска — специфика строительства (№191) */
  helmet: '<path d="M3.5 16a8.5 8.5 0 0 1 17 0z" fill="currentColor" stroke="none"/><path d="M12 7.5v8.5M8 9.5 9 16M16 9.5 15 16" stroke="var(--icon-bg, #fff)" stroke-width="1.6"/><path d="M1.5 16h21v3h-21z" fill="currentColor" stroke="none"/>',
  phone: '<path d="M5 2.5h4l2 5-2.5 1.8a11 11 0 0 0 6.2 6.2l1.8-2.5 5 2v4a2.5 2.5 0 0 1-2.5 2.5A17.5 17.5 0 0 1 2.5 5 2.5 2.5 0 0 1 5 2.5z" fill="currentColor" stroke="none"/>',
  search: '<circle cx="10" cy="10" r="7"/><path d="m15.2 15.2 6.3 6.3"/>',
  doc: '<path d="M5 2.5h9.5l4.5 4.5v14.5H5z"/><path d="M14.5 2.5V7H19M8.5 12h7M8.5 16h7"/>',
};
---

{grad ? (
  <svg class="oicon" viewBox="0 0 24 24" fill="none" stroke={`url(#${gid})`} stroke-width="2.4" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"
    set:html={`<defs><linearGradient id="${gid}" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#004a85"/><stop offset="1" stop-color="#3fa0e6"/></linearGradient></defs>` + paths[name].replaceAll('currentColor', `url(#${gid})`)} />
) : (
  <svg class="oicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false" set:html={paths[name]} />
)}

<style>
  .oicon { display: block; width: 100%; height: auto; overflow: visible; }
</style>
