---
/* Тонкие линейные «чертежи» для карточек «Для кого» (утверждено пользователем
   23.10.2026: «вот это то, что нужно», акцент на линиях).
   Анимация: при появлении карточки линии прорисовываются по очереди (.dr, pathLength=1),
   потом проявляется заливка (.fl); пунктиры (.flow) тихо «бегут» постоянно.
   tower — генподряд: аксонометрия дома; grid — субподряд: план, выделено помещение;
   arch — отделка: развёртка стены с проёмом и плиткой; gear — инжиниринг: трубы и узлы. */
interface Props { kind: 'tower' | 'grid' | 'arch' | 'gear' }
const { kind } = Astro.props;
const ink = '#0b2e3c';
const sage = '#c9d8cc';
const floors = [0, 1, 2, 3, 4, 5];
const d = (i: number) => `--d:${(i * 0.12).toFixed(2)}s`;
---

<svg class="shape" data-shape viewBox="0 0 200 200" fill="none" stroke={ink} stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
  {kind === 'tower' && (
    <g>
      <path class="fl" d="M60 60 L100 40 L150 62 L110 82 Z" fill={sage} stroke="none" />
      <path class="dr" pathLength="1" style={d(0)} d="M60 60 L100 40 L150 62 L110 82 Z" />
      <path class="dr" pathLength="1" style={d(1)} d="M60 60 V160 L110 182 V82" />
      <path class="dr" pathLength="1" style={d(2)} d="M110 182 L150 162 V62" />
      {floors.map((f) => <path class="dr" pathLength="1" style={d(3 + f)} d={`M60 ${76 + f * 16} L110 ${98 + f * 16} L150 ${78 + f * 16}`} stroke-width="0.75" />)}
      {[0, 1, 2].map((c) => <path class="flow" d={`M${72 + c * 13} ${66 + c * 6} V${166 + c * 6}`} stroke-width="0.6" />)}
    </g>
  )}
  {kind === 'grid' && (
    <g>
      <rect class="fl" x="100" y="30" width="70" height="60" fill={sage} stroke="none" />
      <rect class="dr" pathLength="1" style={d(0)} x="30" y="30" width="140" height="140" />
      <path class="dr" pathLength="1" style={d(2)} d="M100 30 V170" />
      <path class="dr" pathLength="1" style={d(3)} d="M30 90 H170" />
      <path class="dr" pathLength="1" style={d(4)} d="M30 130 H100" />
      <path class="dr" pathLength="1" style={d(5)} d="M140 90 V170" />
      <path class="dr" pathLength="1" style={d(6)} d="M100 52 a14 14 0 0 1 14 -14" stroke-width="0.75" />
      <path class="flow" d="M20 30 V170" stroke-width="0.6" />
      <path class="flow" d="M30 182 H170" stroke-width="0.6" />
    </g>
  )}
  {kind === 'arch' && (
    <g>
      <path class="fl" d="M78 170 V112 a22 22 0 0 1 44 0 V170 Z" fill={sage} stroke="none" />
      <rect class="dr" pathLength="1" style={d(0)} x="30" y="40" width="140" height="130" />
      <path class="dr" pathLength="1" style={d(2)} d="M78 170 V112 a22 22 0 0 1 44 0 V170" />
      {[0, 1, 2, 3, 4, 5].map((r) => <path class="dr" pathLength="1" style={d(3 + r)} d={`M30 ${62 + r * 18} H78 M122 ${62 + r * 18} H170`} stroke-width="0.5" />)}
      {[0, 1, 2].map((c) => <path class="dr" pathLength="1" style={d(5 + c)} d={`M${46 + c * 16} 40 V170 M${138 + c * 16} 40 V170`} stroke-width="0.5" />)}
      <path class="flow" d="M30 30 H170" stroke-width="0.6" />
    </g>
  )}
  {kind === 'gear' && (
    <g>
      <path class="dr" pathLength="1" style={d(0)} d="M30 60 H120 V140 H170" />
      <path class="dr" pathLength="1" style={d(2)} d="M30 100 H80 V170" />
      <path class="dr" pathLength="1" style={d(4)} d="M120 30 V60 M150 140 V110 H170" stroke-width="0.75" />
      <path class="flow flow--fast" d="M30 60 H120 V140 H170" stroke-width="2.5" stroke={sage} />
      <path class="flow flow--fast" d="M30 100 H80 V170" stroke-width="2.5" stroke={sage} />
      <circle class="fl" cx="120" cy="60" r="7" fill={sage} />
      <circle class="fl" cx="80" cy="100" r="7" fill={sage} />
      <circle class="fl" cx="120" cy="140" r="7" fill="#ffffff" />
      <rect class="dr" pathLength="1" style={d(6)} x="140" y="128" width="22" height="24" stroke-width="0.75" />
    </g>
  )}
</svg>

<style>
  .shape { width: 100%; height: auto; display: block; overflow: visible; }

  /* прорисовка: до появления линии «пустые», по .is-on — рисуются по очереди */
  .dr { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(.4,0,.2,1) var(--d, 0s); }
  .fl { opacity: 0; transition: opacity .8s ease 1s; }
  :global(.is-on) .dr { stroke-dashoffset: 0; }
  :global(.is-on) .fl { opacity: 1; }

  /* постоянное тихое движение пунктиров */
  .flow { stroke-dasharray: 3 5; animation: flow 6s linear infinite; }
  .flow--fast { stroke-dasharray: 6 10; animation-duration: 3s; }
  @keyframes flow { to { stroke-dashoffset: -64; } }

  @media (prefers-reduced-motion: reduce) {
    .dr { stroke-dashoffset: 0; transition: none; }
    .fl { opacity: 1; transition: none; }
    .flow { animation: none; }
  }
</style>

<script>
  // Прорисовка — когда чертёж появился на экране (один раз)
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); }
  }, { threshold: 0.35 });
  document.querySelectorAll('[data-shape]').forEach((s) => io.observe(s));
</script>
