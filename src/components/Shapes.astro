---
/* Тонкие линейные «чертежи» для карточек «Для кого» (утверждено пользователем
   23.10.2026, акцент на линиях). ТОЛЬКО тонкие линии: 0.75 / 0.5px, без жирных
   контуров и без обводок у кругов-узлов (решение пользователя).
   Чертёж стоит готовым (классы .dr/.fl остались от прорисовки — сейчас без эффекта);
   по чертежу ползёт маленький квадрат (.mover, CSS offset-path), пунктиры (.flow) бегут.
   tower — генподряд: аксонометрия дома; grid — субподряд: план, выделено помещение;
   arch — отделка: развёртка стены с проёмом и плиткой; gear — инжиниринг: трубы и узлы;
   ledger — бухучёт: лист акта с наклоном, без обводки — строки, графа, печать; chart — управленческий:
   оси, столбцы по объектам и растущая линия.
   Цифры — условные чертёжные отметки (уровни, размеры), не данные клиента.
   26.10.2026: клиент — чертежи стройки делают сайт похожим на стройкомпанию; в «Для кого»
   теперь финансовые сюжеты в том же стиле: objects — генподряд: таблица объект/аванс/остаток;
   ks2 — субподряд: листы КС-2 и КС-3 с печатью; margin — отделка: выручка и затраты по заказам,
   маржа выделена; contracts — инжиниринг: расход по договорам против плана.
   tower/grid/arch/gear больше не используются, оставлены про запас. */
interface Props { kind: 'tower' | 'grid' | 'arch' | 'gear' | 'ledger' | 'chart' | 'objects' | 'ks2' | 'margin' | 'contracts' }
const { kind } = Astro.props;
/* цвета из токенов — перекрашиваются вместе с палитрой (?palette=…) */
const ink = 'var(--c-ink)';         /* графит */
const sage = 'var(--c-sage-soft)';  /* заливки */
const green = 'var(--c-sage)';      /* акцент иллюстраций */
const floors = [0, 1, 2, 3, 4, 5];
const d = (i: number) => `--d:${(i * 0.12).toFixed(2)}s`;
const mv = (path: string, dur = 7) => `offset-path: path('${path}'); --dur:${dur}s`;
---

<svg class="shape" data-shape viewBox="0 0 200 200" fill="none" stroke={ink} stroke-width="0.75" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
  {kind === 'tower' && (
    <g>
      <path class="fl" d="M60 60 L100 40 L150 62 L110 82 Z" fill={sage} stroke="none" />
      <path class="dr" pathLength="1" style={d(0)} d="M60 60 L100 40 L150 62 L110 82 Z" />
      <path class="dr" pathLength="1" style={d(1)} d="M60 60 V160 L110 182 V82" />
      <path class="dr" pathLength="1" style={d(2)} d="M110 182 L150 162 V62" />
      {floors.map((f) => <path class="dr" pathLength="1" style={d(3 + f)} d={`M60 ${76 + f * 16} L110 ${98 + f * 16} L150 ${78 + f * 16}`} stroke-width="0.5" />)}
      {[0, 1, 2].map((c) => <path class="flow" d={`M${72 + c * 13} ${66 + c * 6} V${166 + c * 6}`} stroke-width="0.5" />)}
      <g class="fl" font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">
        <text x="156" y="82">+15.000</text>
        <text x="156" y="130">+6.000</text>
        <text x="156" y="162">±0.000</text>
      </g>
      <path class="dr" pathLength="1" style={d(9)} d="M152 78 h3 M152 126 h3 M152 158 h3" stroke-width="0.5" />
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={green} stroke="none" style={mv('M110 178 V86', 6)} />
    </g>
  )}
  {kind === 'grid' && (
    <g>
      <rect class="fl" x="100" y="30" width="70" height="60" fill={sage} stroke="none" />
      <rect class="dr" pathLength="1" style={d(0)} x="30" y="30" width="140" height="140" />
      <path class="dr" pathLength="1" style={d(2)} d="M100 30 V170" />
      <path class="dr" pathLength="1" style={d(3)} d="M30 90 H170" />
      <path class="dr" pathLength="1" style={d(4)} d="M30 130 H100" />
      <path class="dr" pathLength="1" style={d(5)} d="M140 90 V170" />
      <path class="dr" pathLength="1" style={d(6)} d="M100 52 a14 14 0 0 1 14 -14" stroke-width="0.5" />
      <path class="dr" pathLength="1" style={d(7)} d="M30 184 H170 M30 180 v8 M100 180 v8 M170 180 v8" stroke-width="0.5" />
      <g class="fl" font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif" text-anchor="middle">
        <text x="65" y="196">3600</text>
        <text x="135" y="196">3600</text>
      </g>
      <path class="flow" d="M20 30 V170" stroke-width="0.5" />
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={green} stroke="none" style={mv('M30 184 H170', 5)} />
    </g>
  )}
  {kind === 'arch' && (
    <g>
      <path class="fl" d="M78 170 V112 a22 22 0 0 1 44 0 V170 Z" fill={sage} stroke="none" />
      <rect class="dr" pathLength="1" style={d(0)} x="30" y="40" width="140" height="130" />
      <path class="dr" pathLength="1" style={d(2)} d="M78 170 V112 a22 22 0 0 1 44 0 V170" />
      {[0, 1, 2, 3, 4, 5].map((r) => <path class="dr" pathLength="1" style={d(3 + r)} d={`M30 ${62 + r * 18} H78 M122 ${62 + r * 18} H170`} stroke-width="0.5" />)}
      {[0, 1, 2].map((c) => <path class="dr" pathLength="1" style={d(5 + c)} d={`M${46 + c * 16} 40 V170 M${138 + c * 16} 40 V170`} stroke-width="0.5" />)}
      <path class="dr" pathLength="1" style={d(9)} d="M78 30 H122 M78 26 v8 M122 26 v8" stroke-width="0.5" />
      <g class="fl" font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif" text-anchor="middle">
        <text x="100" y="22">900</text>
      </g>
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={green} stroke="none" style={mv('M30 62 H78 V170 H30 Z', 9)} />
    </g>
  )}
  {kind === 'gear' && (
    <g>
      <path class="dr" pathLength="1" style={d(0)} d="M30 60 H120 V140 H170" />
      <path class="dr" pathLength="1" style={d(2)} d="M30 100 H80 V170" />
      <path class="dr" pathLength="1" style={d(4)} d="M120 30 V60 M150 140 V110 H170" stroke-width="0.5" />
      <path class="flow" d="M30 60 H120 V140 H170" stroke-width="0.5" stroke={green} />
      <path class="flow" d="M30 100 H80 V170" stroke-width="0.5" stroke={green} />
      <circle class="fl" cx="120" cy="60" r="5" fill={green} stroke="none" />
      <circle class="fl" cx="80" cy="100" r="5" fill={green} stroke="none" />
      <circle class="fl" cx="120" cy="140" r="5" fill={sage} stroke="none" />
      <rect class="dr" pathLength="1" style={d(6)} x="140" y="128" width="22" height="24" stroke-width="0.5" />
      <g class="fl" font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">
        <text x="34" y="54">Ø32</text>
        <text x="34" y="94">Ø25</text>
      </g>
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M30 60 H120 V140 H170', 6)} />
    </g>
  )}
  {kind === 'ledger' && (
    <g transform="rotate(-9 100 100)">
      <rect x="58" y="22" width="104" height="146" rx="3" fill="#ffffff" stroke="none" />
      <rect x="44" y="34" width="104" height="146" rx="3" fill={sage} stroke="none" />
      <path d="M56 52 H108" stroke-width="0.75" />
      {[0, 1, 2, 3, 4, 5, 6].map((r) => <path d={`M56 ${70 + r * 12} H136`} stroke-width="0.5" />)}
      <path d="M100 66 V148 M120 66 V148" stroke-width="0.5" />
      <path d="M56 162 H94" stroke-width="0.75" />
      <circle cx="122" cy="162" r="11" fill={green} stroke="none" opacity="0.55" />
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M56 70 H136', 4)} />
    </g>
  )}
  {kind === 'chart' && (
    <g>
      <path d="M30 170 H180 M30 170 V30" />
      {[0, 1, 2, 3, 4].map((r) => <path d={`M30 ${140 - r * 28} H180`} stroke-width="0.4" stroke-dasharray="2 4" />)}
      {[[48, 60], [78, 90], [108, 72], [138, 110]].map(([x, h]) => <rect x={x} y={170 - h} width="18" height={h} fill={sage} stroke="none" />)}
      <path d="M44 128 L84 104 L114 116 L150 64 L172 48" stroke={green} stroke-width="0.75" />
      {[[44, 128], [84, 104], [114, 116], [150, 64], [172, 48]].map(([x, y]) => <circle cx={x} cy={y} r="2.5" fill={green} stroke="none" />)}
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M44 128 L84 104 L114 116 L150 64 L172 48', 6)} />
    </g>
  )}
  {kind === 'objects' && (
    <g>
      <rect x="24" y="40" width="152" height="18" fill={sage} stroke="none" />
      <path d="M24 40 H176 M24 58 H176 M24 166 H176" />
      {[0, 1, 2, 3].map((r) => <path d={`M24 ${85 + r * 27} H176`} stroke-width="0.5" />)}
      <path d="M76 40 V166 M126 40 V166" stroke-width="0.5" />
      <g font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">
        <text x="30" y="52">объект</text>
        <text x="82" y="52">аванс</text>
        <text x="132" y="52">остаток</text>
        {[1, 2, 3, 4].map((n, r) => <text x="30" y={75 + r * 27}>№ {n}</text>)}
        <text x="30" y="180">итого</text>
      </g>
      {[34, 22, 40, 16].map((w, r) => <rect x="82" y={68 + r * 27} width={w} height="8" fill={sage} stroke="none" />)}
      {[18, 30, 10, 26].map((w, r) => <rect x="132" y={68 + r * 27} width={w} height="8" fill={green} stroke="none" />)}
      <path class="flow" d="M82 176 H170" stroke-width="0.5" />
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M70 72 V153', 6)} />
    </g>
  )}
  {kind === 'ks2' && (
    <g>
      <g transform="rotate(6 120 100)">
        <rect x="76" y="30" width="96" height="136" rx="3" fill="var(--c-band)" stroke="none" />
        <path d="M88 48 H128" />
        {[0, 1, 2, 3, 4, 5].map((r) => <path d={`M88 ${66 + r * 12} H160`} stroke-width="0.5" />)}
        <text x="136" y="50" font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">КС-3</text>
      </g>
      <g transform="rotate(-5 90 100)">
        <rect x="32" y="40" width="100" height="140" rx="3" fill={sage} stroke="none" />
        <path d="M44 58 H86" />
        <text x="96" y="61" font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">КС-2</text>
        {[0, 1, 2, 3, 4, 5, 6].map((r) => <path d={`M44 ${76 + r * 11} H120`} stroke-width="0.5" />)}
        <path d="M74 72 V150 M98 72 V150" stroke-width="0.5" />
        <path d="M44 166 H80" />
        <circle cx="106" cy="164" r="11" fill={green} stroke="none" opacity="0.55" />
        <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M44 76 V142', 5)} />
      </g>
    </g>
  )}
  {kind === 'margin' && (
    <g>
      <path d="M28 168 H180 M28 168 V30" />
      {[0, 1, 2, 3].map((r) => <path d={`M28 ${138 - r * 30} H180`} stroke-width="0.4" stroke-dasharray="2 4" />)}
      {[[40, 96, 70], [76, 118, 92], [112, 84, 70], [148, 126, 90]].map(([x, rev, cost]) => (
        <g>
          <rect x={x} y={168 - cost} width="22" height={cost} fill={sage} stroke="none" />
          <rect x={x} y={168 - rev} width="22" height={rev - cost} fill={green} stroke="none" />
          <path d={`M${x} ${168 - rev} H${x + 22}`} stroke-width="0.5" />
        </g>
      ))}
      <g font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif" text-anchor="middle">
        {[1, 2, 3, 4].map((n, i) => <text x={51 + i * 36} y="180">заказ {n}</text>)}
      </g>
      <g font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">
        <rect x="34" y="26" width="6" height="6" fill={green} stroke="none" />
        <text x="44" y="32">маржа</text>
        <rect x="84" y="26" width="6" height="6" fill={sage} stroke="none" />
        <text x="94" y="32">затраты</text>
      </g>
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M51 72 L87 50 L123 84 L159 42', 6)} />
    </g>
  )}
  {kind === 'contracts' && (
    <g>
      {[0, 1, 2, 3].map((r) => (
        <g>
          <rect x="60" y={52 + r * 34} width="110" height="12" stroke-width="0.5" />
          <rect x="60" y={52 + r * 34} width={[78, 96, 52, 104][r]} height="12" fill={r === 3 ? green : sage} stroke="none" />
        </g>
      ))}
      <path class="flow" d="M150 40 V180" stroke-width="0.5" stroke={green} />
      <g font-size="7" fill={ink} stroke="none" font-family="Manrope, sans-serif">
        {[1, 2, 3, 4].map((n, r) => <text x="26" y={61 + r * 34}>дог. {n}</text>)}
        <text x="140" y="34">план</text>
      </g>
      <rect class="mover" x="-3" y="-3" width="6" height="6" fill={ink} stroke="none" style={mv('M60 46 H164', 5)} />
    </g>
  )}
</svg>

<style>
  .shape { width: 100%; height: auto; display: block; overflow: visible; }

  /* Чертёж стоит готовым сразу (прорисовку с нуля пользователь снял 23.10.2026);
     двигаются только квадрат и пунктиры. */
  .mover { offset-rotate: 0deg; offset-distance: 0%; animation: crawl var(--dur, 7s) ease-in-out infinite alternate; }
  @keyframes crawl { to { offset-distance: 100%; } }

  .flow { stroke-dasharray: 2 4; animation: flow 6s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -48; } }

  @media (prefers-reduced-motion: reduce) {
    .mover, .flow { animation: none; }
  }
</style>

