---
// Плавающая кнопка «Написать нам» со знаком Макса (09.11.2026, по образцу сайта клиники
// ctmedspb.ru): прилипает справа внизу на всех страницах, ведёт в профиль клиента в Максе.
// Встаёт над полосой cookie (--cc-h задаёт CookieNotice). Ссылка — company.max.
// Нет на первом экране страницы; уезжает вниз, когда на экране форма заявки или подвал
// (там свои кнопки и контакты), и пока открыто мобильное меню (10.11.2026, пользователь).
import { company } from '../data/company';
---

{company.max && (
  <a class="wu wu--away" href={company.max} target="_blank" rel="noopener" aria-label="Написать нам в Максе" data-design-ok>
    <span class="wu__label">Написать нам</span>
    <span class="wu__ic" aria-hidden="true">
      <svg viewBox="0 0 24 24"><g transform="translate(.6 .6) scale(.228)"><path fill="currentColor" fill-rule="evenodd" d="M50.7571 0.261719C78.2929 0.261719 99.8857 22.5974 99.8857 50.1474C99.8857 77.6974 77.6071 99.4903 51.0214 99.4903C41.5857 99.4903 37.0143 98.1617 29.65 92.9474C29.1429 92.5903 28.45 92.6831 28.0214 93.1403C22.3571 99.1831 7.85 103.426 7.18571 95.176C7.18571 80.7903 0 71.4474 0 49.876C0 21.5546 23.2214 0.261719 50.7571 0.261719ZM51.5286 24.8117C38.4643 24.126 28.2643 33.1974 26.0143 47.3831C24.15 59.1332 27.45 73.4546 30.2786 74.176C31.4786 74.4832 34.3571 72.276 36.4571 70.2974C36.85 69.926 37.45 69.8617 37.9071 70.1474C41.1786 72.1474 44.8786 73.6474 48.9571 73.8617C62.3714 74.5617 74.2571 64.0617 74.9643 50.6474C75.6643 37.2331 64.9429 25.5046 51.5286 24.8046V24.8117Z"/></g></svg>
    </span>
  </a>
)}

<script>
  // Одно правило для всех страниц: кнопки нет, пока на экране первый блок страницы
  // (main > первый элемент), форма заявки или подвал. Появляется при прокрутке.
  const wu = document.querySelector<HTMLElement>('.wu');
  const zones = [...document.querySelectorAll<HTMLElement>('main > :first-child, .req, .ftr, [data-wu-hide]')];
  if (wu && zones.length && 'IntersectionObserver' in window) {
    const seen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      wu.classList.toggle('wu--away', seen.size > 0);
    }, { rootMargin: '0px 0px -60px 0px' });
    zones.forEach((z) => io.observe(z));
  } else wu?.classList.remove('wu--away');
</script>

<style>
  .wu {
    position: fixed;
    right: var(--gutter);
    bottom: calc(16px + var(--cc-h, 0px) + env(safe-area-inset-bottom));
    z-index: 55;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 8px 8px 8px 24px;
    border-radius: 999px;
    background: var(--c-primary);
    color: var(--c-white);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color .2s, bottom .3s cubic-bezier(.2, .7, .2, 1),
      transform .35s cubic-bezier(.2, .7, .2, 1), opacity .25s ease, visibility 0s linear 0s;
  }
  /* уезжает вниз и гаснет: форма, подвал, открытое меню */
  .wu--away, :global(html.no-scroll) .wu {
    transform: translateY(calc(100% + 32px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: background-color .2s, bottom .3s cubic-bezier(.2, .7, .2, 1),
      transform .35s cubic-bezier(.2, .7, .2, 1), opacity .25s ease, visibility 0s linear .35s;
  }
  .wu:hover { background: var(--c-primary-deep); text-decoration: none; }
  .wu__ic {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--c-white);
    color: var(--c-primary);
  }
  .wu__ic svg { width: 24px; height: 24px; }
  @media (max-width: 640px) {
    .wu { right: 16px; min-height: 52px; padding: 6px 6px 6px 18px; gap: 10px; font-size: 15px; }
    .wu__ic { width: 40px; height: 40px; }
    .wu__ic svg { width: 22px; height: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .wu, .wu--away { transition: none; } }
  @media print { .wu { display: none; } }
</style>
