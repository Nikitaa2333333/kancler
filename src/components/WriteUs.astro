---
// Плавающая кнопка «Написать нам» со знаком Макса (09.11.2026, по образцу сайта клиники
// ctmedspb.ru): прилипает справа внизу на всех страницах, ведёт в профиль клиента в Максе.
// Встаёт над полосой cookie (--cc-h задаёт CookieNotice). Ссылка — company.max.
// Нет на первом экране страницы; уезжает вниз, когда на экране форма заявки или подвал
// (там свои кнопки и контакты), и пока открыто мобильное меню (10.11.2026, пользователь).
import { company } from '../data/company';
import MaxIcon from './MaxIcon.astro';
---

{company.max && (
  <a class="wu wu--away" href={company.max} target="_blank" rel="noopener" aria-label="Написать нам в Максе" data-design-ok>
    <span class="wu__label">Написать нам</span>
    <span class="wu__ic" aria-hidden="true">
      <MaxIcon />
    </span>
  </a>
)}

<script>
  // Одно правило для всех страниц: кнопки нет, пока на экране первый блок страницы
  // (main > первый элемент), форма заявки или подвал. Появляется при прокрутке.
  const wu = document.querySelector<HTMLElement>('.wu');
  const zones = [...document.querySelectorAll<HTMLElement>('main > :first-child, .req, .ftr, [data-wu-hide]')];
  if (wu && zones.length && 'IntersectionObserver' in window) {
    const seen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      wu.classList.toggle('wu--away', seen.size > 0);
    }, { rootMargin: '0px 0px -60px 0px' });
    zones.forEach((z) => io.observe(z));
  } else wu?.classList.remove('wu--away');
</script>

<style>
  .wu {
    position: fixed;
    right: var(--gutter);
    bottom: calc(16px + var(--cc-h, 0px) + env(safe-area-inset-bottom));
    z-index: 55;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 8px 8px 8px 24px;
    border-radius: 999px;
    background: var(--c-primary);
    color: var(--c-white);
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    /* появление — мягкое: всплывает на 24px с лёгким увеличением и проявляется */
    transition: background-color .2s, bottom .4s cubic-bezier(.16, 1, .3, 1),
      transform .7s cubic-bezier(.16, 1, .3, 1), opacity .5s ease-out, visibility 0s linear 0s;
  }
  /* уезжает вниз и гаснет: форма, подвал, открытое меню */
  .wu--away, :global(html.no-scroll) .wu {
    transform-origin: right center;
    transform: translateY(24px) scale(.94);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* уход — быстрее появления */
    transition: background-color .2s, bottom .4s cubic-bezier(.16, 1, .3, 1),
      transform .4s cubic-bezier(.4, 0, .6, 1), opacity .3s ease-in, visibility 0s linear .4s;
  }
  .wu:hover { background: var(--c-primary-deep); text-decoration: none; }
  .wu__ic {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--c-white);
    color: var(--c-primary);
  }
  .wu__ic :global(svg) { width: 24px; height: 24px; }
  @media (max-width: 640px) {
    .wu { right: 16px; min-height: 52px; padding: 6px 6px 6px 18px; gap: 10px; font-size: 15px; }
    .wu__ic { width: 40px; height: 40px; }
    .wu__ic :global(svg) { width: 22px; height: 22px; }
  }
  /* «уменьшить движение» в системе — без сдвига, только проявление */
  @media (prefers-reduced-motion: reduce) {
    .wu, .wu--away { transform: none; transition: opacity .4s ease, visibility 0s linear 0s, background-color .2s; }
    .wu--away { transition: opacity .3s ease, visibility 0s linear .3s, background-color .2s; }
  }
  @media print { .wu { display: none; } }
</style>
