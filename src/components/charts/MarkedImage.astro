---
import type { CaseImage } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Картинка со слайда клиента + «маркер» поверх: жёлтая полоса проходит по важной строке
   (mix-blend multiply — текст под ней читается). Красную рамку сняли (правка №1, 28.10). Под картинкой — крупный вывод (result). Координаты — в % картинки. */
interface Props { im: CaseImage }
const { im } = Astro.props;
---

<figure class="mi" data-reveal>
  <a class="mi__frame" href={u(im.src)} target="_blank" rel="noopener" data-zoom aria-label={`Открыть крупно: ${im.alt}`}>
    <img src={u(im.src)} alt={im.alt} width={im.w} height={im.h} loading="lazy" decoding="async" />
    {im.mark?.map((m, i) => (
      <span class="mi__mark" style={`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%;--i:${i}`} aria-hidden="true"></span>
    ))}
  </a>
  <figcaption>
    {im.result && <p class="mi__result"><span>{typo(im.result)}</span></p>}
    <p class="mi__alt">{typo(im.alt)}</p>
  </figcaption>
</figure>

<script>
  /* нажатие на картинку — открывается крупно поверх страницы (правка №242); без JS — в новой вкладке */
  const open = (src: string, alt: string) => {
    let d = document.querySelector<HTMLDialogElement>('dialog.zoom');
    if (!d) {
      d = document.createElement('dialog');
      d.className = 'zoom';
      d.innerHTML = '<button type="button" class="zoom__x" aria-label="Закрыть">×</button><img alt="">';
      d.addEventListener('click', () => d!.close());
      document.body.append(d);
    }
    const img = d.querySelector('img')!;
    img.src = src; img.alt = alt;
    d.showModal();
  };
  document.querySelectorAll<HTMLAnchorElement>('a[data-zoom]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || !('showModal' in HTMLDialogElement.prototype)) return;
      e.preventDefault();
      open(a.href, a.querySelector('img')?.alt ?? '');
    });
  });
</script>

<style is:global>
  dialog.zoom { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(20 24 32 / 0.97); cursor: zoom-out; }
  dialog.zoom[open] { display: grid; place-items: center; overflow: auto; }
  dialog.zoom::backdrop { background: rgb(20 24 32 / 0.6); }
  dialog.zoom img { max-width: calc(100vw - 16px); max-height: calc(100dvh - 72px); width: auto; height: auto; background: var(--c-white); }
  .zoom__x { position: fixed; top: 10px; right: 10px; width: 48px; height: 48px; border: 0; border-radius: 50%; background: var(--c-white); color: var(--c-ink); font-size: 28px; line-height: 1; cursor: pointer; }
</style>

<style>
  .mi { display: grid; gap: 14px; align-content: start; }
  .mi__frame { position: relative; display: block; overflow: hidden; cursor: zoom-in;  /* без скругления (№242) */ background: var(--c-white-card); box-shadow: 0 1px 0 var(--line-faint); }
  .mi__frame img { width: 100%; height: auto; }
  .mi__mark {
    position: absolute; transform: scale(1.06, 1.25);
    background: linear-gradient(var(--c-accent), var(--c-accent)) no-repeat 0 0 / 0% 100%;
    mix-blend-mode: multiply; border-radius: 4px;
    transition: background-size .8s cubic-bezier(.3, .6, .2, 1); transition-delay: calc(var(--i) * 0.5s + 0.3s);
  }
  .is-in .mi__mark { background-size: 100% 100%; }
  .mi__result { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h4); line-height: 1.25; letter-spacing: var(--tr-h4); }
  .mi__result span {
    background: linear-gradient(var(--c-accent), var(--c-accent)) no-repeat 0 90% / 0% 32%;
    transition: background-size 1s ease 1.4s;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .is-in .mi__result span { background-size: 100% 32%; }
  .mi__alt { font-size: var(--fs-small); max-width: 60ch; opacity: 0.8; }
</style>
