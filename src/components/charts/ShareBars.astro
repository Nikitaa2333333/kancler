---
import { typo } from '../../lib/typo';
import { num } from '../../lib/num';

/* Доли направлений: строка = показатель, полоса 100% по сериям. Подсвеченная серия (hi)
   — жёлтым маркером и в цифрах; крошечные доли видны в подписи, не в полосе. */
interface Props {
  series: string[];
  rows: { label: string; total: string; values: number[]; note?: string }[];
  hi?: number;
}
const { series, rows, hi } = Astro.props;
const tone = (i: number) => (i === hi ? 'hi' : i === 0 ? 'main' : 'rest');
---

<div class="sb" data-reveal>
  <ul class="sb__legend">
    {series.map((s, i) => <li class={`sb__key sb__key--${tone(i)}`}>{typo(s)}</li>)}
  </ul>
  {rows.map((r, ri) => (
    <div class="sb__row" style={`--r:${ri}`}>
      <div class="sb__head">
        <p class="sb__label">{typo(r.label)}</p>
        <p class="sb__total">{r.total}</p>
      </div>
      <div class="sb__bar" role="img" aria-label={`${r.label}: ${series.map((s, i) => `${s} ${num(r.values[i])}%`).join(', ')}`}>
        {r.values.map((v, i) => (
          <span class={`sb__seg sb__seg--${tone(i)}`} style={`--w:${Math.max(v, 0.6)}%`}></span>
        ))}
      </div>
      <p class="sb__vals">
        {r.values.map((v, i) => (
          <span class={i === hi ? 'sb__hi' : ''}>{series[i]} {num(v)}%</span>
        ))}
        {r.note && <span class="sb__note">{typo(r.note)}</span>}
      </p>
    </div>
  ))}
</div>

<style>
  .sb { display: grid; gap: clamp(18px, 2vw, 26px); }
  .sb__legend { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: var(--fs-small); font-weight: var(--w-semibold); }
  .sb__key { display: flex; align-items: center; gap: 8px; }
  .sb__key::before { content: ''; width: 14px; height: 14px; border-radius: 3px; }
  .sb__key--main::before { background: var(--c-primary); }
  .sb__key--hi::before { background: var(--c-warn); }
  .sb__key--rest::before { background: var(--line-subtle); }
  .sb__head { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 8px; }
  .sb__label { font-weight: var(--w-semibold); }
  .sb__total { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h6); white-space: nowrap; }
  .sb__bar { display: flex; height: 28px; gap: 2px; overflow: hidden; border-radius: 6px; background: var(--c-white-card); }
  .sb__seg {
    flex: 0 0 auto; width: 0;
    transition: width 1.1s cubic-bezier(.2, .7, .2, 1);
    transition-delay: calc(var(--r) * 0.2s);
  }
  .is-in .sb__seg { width: var(--w); }
  .sb__seg--main { background: var(--c-primary); }
  .sb__seg--hi { background: var(--c-warn); }
  .sb__seg--rest { background: var(--line-subtle); }
  .sb__vals { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 8px; font-size: var(--fs-small); }
  .sb__hi {
    padding: 0 4px; margin: 0 -4px;
    background: linear-gradient(var(--c-accent), var(--c-accent)) no-repeat 0 0 / 0% 100%;
    transition: background-size .7s ease;
    transition-delay: calc(var(--r) * 0.2s + 1s);
  }
  .is-in .sb__hi { background-size: 100% 100%; }
  .sb__note { opacity: 0.75; }
</style>
