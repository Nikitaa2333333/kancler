---
import type { Case } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Карточки кейсов: 3D-иллюстрация кейса сверху (№212), заголовок, строка результата.
   Используется на главной, в списке кейсов и внизу страниц услуг. */
interface Props { items: Case[] }
const { items } = Astro.props;
---

<ul class="cc bleed">
  {items.map((c) => (
    <li class="cc__card">
      <a class="cc__link" href={u(`/keysy/${c.slug}/`)}>
        <div class="cc__img">
          <img src={u(`/images/ill/case-${c.slug}.webp`)} alt="" width="560" height="560" loading="lazy" decoding="async" />
        </div>
        <div class="cc__body">
          <h3>{typo(c.title)}</h3>
          <p>{typo(c.short)}</p>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  /* №223: каждый кейс — одна широкая плашка до краёв: обложка слева, текст справа;
     фон плашки — цвет фона иллюстрации */
  .cc { display: grid; gap: var(--card-gap); }
  .cc__card { display: flex; }
  /* плашка — ссылка внутри li, поэтому поля .bleed на li не нужны: иначе плашка отступала от края (№240) */
  .cc.bleed > .cc__card { padding-inline: 0 !important; }
  .cc__link { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(20px, 4vw, 64px); width: 100%; padding: var(--card-pad); border-radius: var(--r-xl); background: var(--c-hero); }
  .cc__img { display: grid; place-items: center; aspect-ratio: 4 / 3; }
  .cc__img img { width: 82%; height: auto; transition: transform .4s; mix-blend-mode: multiply;  /* картинка на белом фоне растворяется в цвете плашки — без вырезки (№257) */ }
  .cc__link:hover .cc__img img { transform: scale(1.03); }
  .cc__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--card-in); }
  .cc__body h3 { max-width: 26ch; font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); transition: color .2s; }
  .cc__body p { max-width: 48ch; font-size: var(--fs-lead); line-height: 1.45; }
  .cc__link:hover h3 { color: var(--c-primary); }
  @media (max-width: 760px) {
    .cc__link { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .cc__img { aspect-ratio: 16 / 10; }
    .cc__img img { width: 62%; }
  }
</style>
