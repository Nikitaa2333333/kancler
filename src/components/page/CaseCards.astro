---
import type { Case } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Карточки кейсов: картинка со слайда клиента сверху, заголовок, строка результата.
   Используется на главной, в списке кейсов и внизу страниц услуг. */
interface Props { items: Case[] }
const { items } = Astro.props;
---

<ul class={`cc ${items.length === 1 ? 'cc--one' : ''} ${items.length === 2 ? 'cc--two' : ''}`}>
  {items.map((c) => (
    <li class="cc__card">
      <a class="cc__link" href={u(`/keysy/${c.slug}/`)}>
        <div class="cc__img">
          <img src={u(c.images[0].src)} alt="" width={c.images[0].w} height={c.images[0].h} loading="lazy" decoding="async" />
        </div>
        <div class="cc__body">
          <h3>{typo(c.title)}</h3>
          <p>{typo(c.short)}</p>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .cc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.6vw, 36px); }
  .cc__card { display: flex; }
  /* без «плашки в плашке» (правка №7, 28.10): карточки не красим, картинка в скруглённой
     рамке, текст прямо на фоне блока; вся карточка — ссылка (кнопку «Читать кейс» сняли, №30) */
  .cc__link { display: flex; flex-direction: column; gap: 18px; width: 100%; }
  /* фото прямоугольные, без скругления; переход по картинке или тексту, без кнопки (правка №30, 30.10) */
  .cc__img { aspect-ratio: 16 / 10; overflow: hidden; background: var(--c-white-card); box-shadow: 0 0 0 1px var(--line-faint); }
  .cc__img img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; transition: transform .4s; }
  .cc__link:hover .cc__img img { transform: scale(1.03); }
  .cc__body { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .cc__body h3 { font-size: var(--fs-h5); line-height: 1.2; letter-spacing: var(--tr-h5); }
  .cc__body p { flex: 1; }
  .cc__link:hover h3 { color: var(--c-primary); }
  .cc__body h3 { transition: color .2s; }
  .cc--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* один кейс (внизу страниц услуг) — широко: картинка слева, текст справа */
  .cc--one { grid-template-columns: minmax(0, 1fr); }
  .cc--one .cc__link { flex-direction: row; align-items: center; gap: clamp(24px, 4vw, 56px); }
  .cc--one .cc__img { flex: 0 0 45%; aspect-ratio: 16 / 10; }
  .cc--one .cc__body h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); max-width: 24ch; }
  .cc--one .cc__body p { flex: none; max-width: 48ch; }
  @media (max-width: 760px) { .cc--one .cc__link { flex-direction: column; align-items: stretch; } .cc--one .cc__img { flex: none; } }
  @media (max-width: 980px) { .cc { grid-template-columns: minmax(0, 1fr); gap: 40px; } .cc__img { aspect-ratio: 16 / 9; } }
</style>
