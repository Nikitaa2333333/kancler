---
import { typo } from '../../lib/typo';

/* Вопрос — ответ на <details>; каждый вопрос — своя плашка (№202). */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

<div class="faq bleed">
  {items.map((it, i) => (
    <details open={i === 0}>
      <summary><span>{typo(it.q)}</span><span class="faq__mark" aria-hidden="true"></span></summary>
      <div class="faq__a"><p>{typo(it.a)}</p></div>
    </details>
  ))}
</div>

<script>
  /* Плавное раскрытие ответа (правка №83, 30.10): высота ответа анимируется, а не прыгает.
     Без JS и при «уменьшить движение» <details> работает как обычно. */
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!calm) document.querySelectorAll('.faq').forEach((f) => f.classList.add('js'));
  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d) => {
    d.classList.toggle('is-open', d.open);
    const sum = d.querySelector('summary')!;
    const box = d.querySelector<HTMLElement>('.faq__a')!;
    let anim: Animation | null = null;
    sum.addEventListener('click', (e) => {
      if (calm) return;
      e.preventDefault();
      anim?.cancel();
      const opening = !d.open;
      if (opening) d.open = true;
      const h = box.scrollHeight;
      d.classList.toggle('is-open', opening);
      anim = box.animate(
        [{ height: opening ? '0px' : `${h}px`, opacity: opening ? 0 : 1 }, { height: opening ? `${h}px` : '0px', opacity: opening ? 1 : 0 }],
        { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' },
      );
      anim.onfinish = () => { if (!opening) d.open = false; anim = null; };
    });
  });
</script>

<style>
  /* №202: как у Яндекса 360 — каждый вопрос отдельной плашкой, плюс в белом квадратике */
  .faq { display: grid; gap: 8px; max-width: 920px; margin-inline: auto; }  /* по центру (№275) */
  details { padding: 0 var(--card-px); border-radius: var(--r-xl); background: var(--c-band); }  /* единые поля (№206) */
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: var(--card-pt) 0;
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h5);
    line-height: 1.25;
    letter-spacing: var(--tr-h5);
    color: var(--c-title);
  }
  summary::-webkit-details-marker { display: none; }
  .faq__mark { position: relative; flex: none; width: 40px; height: 40px; border-radius: 12px; background: var(--c-white); }
  .faq__mark::before, .faq__mark::after { content: ''; position: absolute; left: 13px; right: 13px; top: 19px; height: 2px; background: var(--c-ink); transition: transform .2s; }
  .faq__mark::after { transform: rotate(90deg); }
  .faq:not(.js) details[open] .faq__mark::after, .faq.js details.is-open .faq__mark::after { transform: rotate(0); }
  .faq__a { overflow: hidden; }
  details p { max-width: var(--measure-text); padding-bottom: var(--card-pb); }
  details:not([open]) summary { padding-bottom: var(--card-pt); }
</style>
