---
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Первый экран внутренних страниц: светлая плашка как блоки главной, сразу H1, лид, кнопки
   (крошки ушли вниз страницы, надзаголовок снят — правки №61–62, 30.10). Справа — крупная цифра (stat) из текстов клиента: акцент на цифры
   вместо тонких чертежей (правка №13, 28.10.2026). */
interface Action { label: string; href: string; light?: boolean }
interface Props {
  title: string;
  lead?: string;
  actions?: Action[];
  stat?: { value: string; label: string };
}
const { title, lead, actions = [], stat } = Astro.props;
const href = (h: string) => (h.startsWith('#') ? h : u(h));
---

<section class="ph" aria-labelledby="ph-title">
  <div class="ph__frame">
    <div class="ph__copy">
      <h1 id="ph-title">{typo(title)}</h1>
      {lead && <p class="ph__lead">{typo(lead)}</p>}
      {actions.length > 0 && (
        <div class="ph__actions">
          {actions.map((a) => <a class={`btn ${a.light ? 'btn--light' : ''}`} href={href(a.href)}>{typo(a.label)}</a>)}
        </div>
      )}
      <slot />
    </div>
    {stat && (
      <div class="ph__stat">
        <p class="ph__stat-v">{stat.value}</p>
        <p class="ph__stat-l">{typo(stat.label)}</p>
      </div>
    )}
  </div>
</section>

<style>
  .ph { padding: calc(var(--hdr-h) + 4px) var(--hero-frame) 0; }
  .ph__frame {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px;
    padding: clamp(32px, 5vw, 72px) clamp(20px, 4vw, 56px);
    border-radius: var(--r-lg);
    background: var(--c-band);
  }
  .ph__copy { display: grid; gap: clamp(14px, 1.6vw, 20px); justify-items: start; max-width: 860px; }
  h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--tr-h1); max-width: 22ch; }
  .ph__lead { max-width: 40ch; font-size: var(--fs-h5); line-height: 1.4; }  /* крупнее, как на главной (правка №62) */
  .ph__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .ph__stat { display: grid; gap: 8px; }  /* без линии слева (№63) */
  .ph__stat-v { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h2); line-height: 1.05; letter-spacing: var(--tr-h2); white-space: nowrap; }  /* цветом текста (№98) */
  .ph__stat-l { max-width: 26ch; font-size: var(--fs-lead); line-height: 1.35; }  /* подпись к цифре — крупнее (№107) */
  @media (max-width: 860px) {
    .ph__frame { grid-template-columns: minmax(0, 1fr); }
    .ph__stat { width: auto; }
    .ph__stat-v { font-size: var(--fs-h2); }
  }
  /* кнопки на телефоне — во всю ширину (правка №14) */
  @media (max-width: 560px) { .ph__actions, .ph__actions .btn { width: 100%; } }
</style>
