---
import { typo } from '../../lib/typo';

/* Таблица цен в стиле «Что влияет на стоимость» главной: линии сверху строк, первая
   колонка — антиквой, последняя (цена) — справа. foot — итоговые строки (выделены
   подложкой, без жирного). На телефоне строки складываются в карточку с подписями. */
interface Props {
  head: string[];
  rows: string[][];
  foot?: string[][];
  caption?: string;
}
const { head, rows, foot = [], caption } = Astro.props;
const last = head.length - 1;
---

<div class="pt">
  <table>
    {caption && <caption>{typo(caption)}</caption>}
    <thead>
      <tr>{head.map((h, i) => <th scope="col" class={i === last ? 'pt__price' : ''}>{typo(h)}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          {r.map((c, i) =>
            i === 0 ? (
              <th scope="row" data-label={head[0]}>{typo(c)}</th>
            ) : (
              <td class={i === last ? 'pt__price' : ''} data-label={head[i]}>{typo(c)}</td>
            ),
          )}
        </tr>
      ))}
    </tbody>
    {foot.length > 0 && (
      <tfoot>
        {foot.map((r) => (
          <tr>
            <th scope="row" colspan={last}>{typo(r[0])}</th>
            <td class="pt__price">{typo(r[r.length - 1])}</td>
          </tr>
        ))}
      </tfoot>
    )}
  </table>
</div>

<style>
  .pt table { width: 100%; border-collapse: collapse; text-align: left; }
  .pt caption {
    text-align: left;
    padding-bottom: 16px;
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    letter-spacing: var(--tr-h4);
  }
  .pt th, .pt td {
    vertical-align: top;
    padding: clamp(12px, 1.4vw, 18px) 16px clamp(12px, 1.4vw, 18px) 0;
    border-top: 1px solid var(--line-subtle);
    font-weight: var(--w-body);
  }
  .pt thead th { font-size: var(--fs-small); font-weight: var(--w-semibold); padding-top: 10px; padding-bottom: 10px; border-top: 0; }
  .pt tbody th {
    font-family: var(--ff-display);
    font-weight: var(--w-display-sm);
    font-size: var(--fs-h6);
    line-height: 1.25;
    letter-spacing: var(--tr-h6);
  }
  .pt .pt__price { text-align: right; padding-right: 0; white-space: nowrap; }
  .pt td.pt__price { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h6); letter-spacing: var(--tr-h6); }
  .pt tbody tr:last-child > * { border-bottom: 1px solid var(--line-subtle); }
  .pt tfoot th, .pt tfoot td { border-top: 0; padding-left: 16px; padding-right: 16px; background: var(--c-tint); }
  .pt tfoot tr:first-child > * { border-top: 8px solid transparent; background-clip: padding-box; }
  .pt tfoot th { border-radius: var(--r-sm) 0 0 var(--r-sm); font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h6); }
  .pt tfoot td { border-radius: 0 var(--r-sm) var(--r-sm) 0; }
  .pt tfoot tr + tr > * { border-top: 4px solid transparent; }

  @media (max-width: 720px) {
    .pt thead { display: none; }
    .pt tr { display: grid; gap: 4px; padding: 14px 0; border-top: 1px solid var(--line-subtle); }
    .pt tbody tr:last-child { border-bottom: 1px solid var(--line-subtle); }
    .pt th, .pt td, .pt tbody tr:last-child > * { border: 0; padding: 0; }
    .pt .pt__price { text-align: left; white-space: normal; }
    .pt tbody td[data-label]::before { content: attr(data-label) ': '; font-size: var(--fs-small); font-weight: var(--w-medium); opacity: 0.75; }
    .pt tbody td.pt__price::before { content: ''; }
    .pt tfoot tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; padding: 12px 14px; margin-top: 6px; border: 0; border-radius: var(--r-sm); background: var(--c-tint); }
    .pt tfoot th, .pt tfoot td, .pt tfoot tr:first-child > *, .pt tfoot tr + tr > * { background: none; padding: 0; border: 0; }
    .pt tfoot td.pt__price { text-align: right; }
  }
</style>
