---
import { typo } from '../../lib/typo';

/* Таблица цен: первая колонка — название (Manrope), средние — пояснение мельче, последняя —
   цена справа. foot — итоговые строки, первая из них (Итого) крупно. На телефоне строка
   складывается столбиком без подписей колонок. */
interface Props {
  head: string[];
  rows: string[][];
  foot?: string[][];
  caption?: string;
}
const { head, rows, foot = [], caption } = Astro.props;
const last = head.length - 1;
---

<div class="pt">
  <table>
    {caption && <caption>{typo(caption)}</caption>}
    <thead>
      <tr>{head.map((h, i) => <th scope="col" class={i === last ? 'pt__price' : ''}>{typo(h)}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          {r.map((c, i) =>
            i === 0 ? (
              <th scope="row" data-label={head[0]}>{typo(c)}</th>
            ) : (
              <td class={i === last ? 'pt__price' : ''} data-label={head[i]}>{typo(c)}</td>
            ),
          )}
        </tr>
      ))}
    </tbody>
    {foot.length > 0 && (
      <tfoot>
        {foot.map((r) => (
          <tr>
            <th scope="row" colspan={last}>{typo(r[0])}</th>
            <td class="pt__price">{typo(r[r.length - 1])}</td>
          </tr>
        ))}
      </tfoot>
    )}
  </table>
</div>

<style>
  /* Правки №69–71 (30.10): заголовок таблицы крупно антиквой; строки — обычный Manrope, без
     «заголовков» на каждой строке; пояснение — тем же цветом, мельче; цена — Manrope жирнее,
     справа. Линии только между строками. Итог — без подложки (не плашка в плашке). */
  .pt table { width: 100%; border-collapse: collapse; text-align: left; }
  .pt caption {
    text-align: left;
    padding-bottom: 12px;
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--tr-h3);
  }
  .pt th, .pt td {
    vertical-align: baseline;
    padding: 14px 20px 14px 0;
    font-weight: var(--w-body);
  }
  .pt tbody tr + tr > *, .pt tfoot tr > * { border-top: 1px solid var(--line-subtle); }
  .pt thead th { font-size: var(--fs-small); font-weight: var(--w-semibold); padding-top: 4px; padding-bottom: 8px; border-bottom: 1px solid var(--line-subtle); }
  .pt tbody th { font-size: var(--fs-lead); line-height: 1.35; }
  .pt tbody td { font-size: var(--fs-body); line-height: 1.4; }
  .pt .pt__price { text-align: right; padding-right: 0; white-space: nowrap; }
  .pt td.pt__price { font-size: var(--fs-lead); font-weight: var(--w-semibold); }
  .pt tfoot th, .pt tfoot td { font-size: var(--fs-lead); }
  .pt tfoot tr:first-child > * { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h4); letter-spacing: var(--tr-h4); border-top: 2px solid var(--c-ink); }

  @media (max-width: 720px) {
    .pt thead { display: none; }
    .pt tr { display: grid; gap: 4px; padding: 14px 0; }
    .pt tbody tr + tr, .pt tfoot tr { border-top: 1px solid var(--line-subtle); }
    .pt tfoot tr:first-child { border-top: 2px solid var(--c-ink); }
    .pt th, .pt td, .pt tbody tr + tr > *, .pt tfoot tr > *, .pt tfoot tr:first-child > * { border: 0; padding: 0; }
    .pt tbody td { font-size: var(--fs-small); }
    .pt .pt__price { text-align: left; white-space: normal; }
    .pt td.pt__price { margin-top: 4px; font-size: var(--fs-lead); }
  }
</style>
