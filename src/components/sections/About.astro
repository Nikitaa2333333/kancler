---
import { about } from '../../data/home';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<!-- Светлый блок вместо тёмного «депрессивного» (решение 23.10.2026) -->
<section class="sec sec--block about" id="o-kompanii" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <!-- Фото основателя клиент не прислала — пока сгенерированный кадр рабочего места
         (public/images/about.jpg). Появится портрет — заменить файл и alt. -->
    <figure class="about__photo">
      <img src={u('/images/about.jpg')} alt="" width="1400" height="1045" loading="lazy" decoding="async" />
    </figure>

    <div class="about__card">
      <h2 id="about-title">{typo(about.title)}</h2>
      <div class="about__person">
        <p class="about__name">{typo(company.founder.name)}</p>
        <p class="about__role">{company.founder.role}</p>
      </div>
      <ul class="about__facts">
        <li><span>На рынке</span><b>{typo(`с ${company.since} года`)}</b></li>
        <li><span>Регион</span><b>{typo(company.region)}</b></li>
        <li><span>Формат</span><b>{typo(company.remote)}</b></li>
        <li><span>На связи</span><b>{typo(company.hours)}</b></li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* Приём «Архимеда» (23.10.2026): карточка с текстом заезжает на фотографию */
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
  }
  .about__photo {
    overflow: hidden;
    min-height: clamp(320px, 34vw, 520px);
    border-radius: var(--r-lg);
  }
  .about__photo img { width: 100%; height: 100%; object-fit: cover; }
  .about__card {
    position: relative;
    z-index: 1;
    margin-left: calc(-1 * clamp(56px, 7vw, 112px));
    box-shadow: 0 20px 48px rgb(43 40 51 / 0.1);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 32px);
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: var(--grad-card);
  }
  .about__name {
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    letter-spacing: var(--tr-h4);
  }
  .about__role { margin-top: 4px; font-size: var(--fs-lead); }
  .about__facts { margin-top: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .about__facts li {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: var(--r-md);
    background: var(--c-band);
  }
  .about__facts span { font-size: var(--fs-small); }
  /* <b> здесь не внутри фразы, а значение в служебной плашке — вес задаём явно */
  .about__facts b { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h6); line-height: var(--lh-h6); }
  @media (max-width: 860px) {
    .about__grid { grid-template-columns: minmax(0, 1fr); }
    .about__card { margin: -70px 12px 0; }
  }
</style>
