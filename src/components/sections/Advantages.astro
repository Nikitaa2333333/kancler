---
import { advantages } from '../../data/home';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';

/* монограмма вместо фото основателя, пока клиент его не прислала (открытый вопрос 3) */
const initials = company.founder.name.split(' ').slice(0, 2).reverse().map((w) => w[0]).join('');
const founderShort = company.founder.name.split(' ').slice(0, 2).reverse().join(' ');
/* Мессенджеры — знаки на нашем синем, внахлёст в один ряд, без подписей и без тени
   (правки №45, №51, №86, 30.10).
   Telegram и Макс — те же знаки, что на сайте КТМ (src/data/icons.ts там), WhatsApp — Simple Icons. */
const icons: Record<string, { color: string; svg: string }> = {
  Telegram: { color: 'var(--c-primary)', svg: '<g transform="translate(11.4 12.3) scale(1.05) translate(-11.35 -12.7)"><path fill="#fff" d="M16.906 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.230-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.830-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></g>' },
  WhatsApp: { color: 'var(--c-primary)', svg: '<g transform="translate(5 5) scale(.583)"><path fill="#fff" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.480-8.413Z"/></g>' },
  'Макс': { color: 'var(--c-primary)', svg: '<g transform="translate(5.4 5.4) scale(.132)"><path fill="#fff" fill-rule="evenodd" d="M50.7571 0.261719C78.2929 0.261719 99.8857 22.5974 99.8857 50.1474C99.8857 77.6974 77.6071 99.4903 51.0214 99.4903C41.5857 99.4903 37.0143 98.1617 29.65 92.9474C29.1429 92.5903 28.45 92.6831 28.0214 93.1403C22.3571 99.1831 7.85 103.426 7.18571 95.176C7.18571 80.7903 0 71.4474 0 49.876C0 21.5546 23.2214 0.261719 50.7571 0.261719ZM51.5286 24.8117C38.4643 24.126 28.2643 33.1974 26.0143 47.3831C24.15 59.1332 27.45 73.4546 30.2786 74.176C31.4786 74.4832 34.3571 72.276 36.4571 70.2974C36.85 69.926 37.45 69.8617 37.9071 70.1474C41.1786 72.1474 44.8786 73.6474 48.9571 73.8617C62.3714 74.5617 74.2571 64.0617 74.9643 50.6474C75.6643 37.2331 64.9429 25.5046 51.5286 24.8046V24.8117Z"/></g>' },
};
---

<!-- Горизонтальная прокрутка (решение 23.10.2026): карточки не вываливаются все сразу,
     листаются стрелками, колесом/свайпом; snap по карточкам. -->
<section class="sec sec--block sec--white adv" id="preimushchestva" aria-labelledby="adv-title">
  <div class="wrap">
    <div class="adv__head">
      <div class="adv__title">
        <h2 id="adv-title">{typo(advantages.title)}</h2>
        <p class="adv__lead">{typo(advantages.lead)}</p>
      </div>
      <div class="adv__nav">
        <button class="adv__arrow" type="button" data-dir="-1" aria-label="Назад">←</button>
        <button class="adv__arrow" type="button" data-dir="1" aria-label="Вперёд">→</button>
      </div>
    </div>

    <ul class="adv__track" data-track>
      {advantages.items.map((it) => (
        <li>
          <h3>{typo(it.title)}</h3>
          <p class="adv__text">{typo(it.text)}</p>
          {it.chips && <ul class="adv__chips">{it.chips.map((c) => <li>{typo(c)}</li>)}</ul>}
          {it.guarantee && <p class="adv__guar">{typo(it.guarantee)}</p>}
          {it.person && (
            <div class="adv__person">
              <span class="adv__ava" aria-hidden="true">{initials}</span>
              <p><b>{typo(founderShort)}</b><span>основатель, лично контролирует отчётность</span></p>
            </div>
          )}
          {it.messengers && (
            <ul class="adv__msg">
              {it.messengers.map((m, k) => (
                <li style={`--bg:${icons[m].color}`} title={m}><svg viewBox="0 0 24 24" role="img" aria-label={m} set:html={icons[m].svg} /></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-track]');
  document.querySelectorAll<HTMLButtonElement>('.adv__arrow').forEach((b) =>
    b.addEventListener('click', () => {
      if (!track) return;
      const card = track.firstElementChild as HTMLElement | null;
      const step = card ? card.offsetWidth + 16 : 300;
      track.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
    }),
  );
</script>

<style>
  .adv__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--head-gap);
    margin-bottom: var(--head-gap);
  }
  .adv__title { display: grid; gap: 16px; }
  .adv__lead { max-width: var(--measure-lead); font-size: var(--fs-lead); line-height: 1.45; }
  .adv__nav { display: flex; gap: 8px; flex: none; }
  .adv__arrow {
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--c-tint);
    color: var(--c-ink);
    font-size: 20px;
    cursor: pointer;
    transition: background-color .2s, color .2s;
  }
  .adv__arrow:hover { background: var(--c-ink); color: var(--c-white); }

  /* лента уходит за край экрана, а не обрезается полями блока (правка №8, 28.10):
     растягиваем на всю ширину окна, а отступ слева/справа возвращаем паддингом */
  .adv__track {
    display: flex;
    gap: var(--card-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* --edge — расстояние от края окна до текста блока (поле блока + отступ .wrap) */
    --edge: calc(var(--hero-frame) + max(var(--gutter), (100vw - 2 * var(--hero-frame) - var(--page-max)) / 2));
    /* --pad — первая карточка у края экрана, узко, как у «Последовательности работы» (№149) */
    --pad: calc(var(--hero-frame) + max(0px, (100vw - 2 * var(--hero-frame) - var(--page-max)) / 2 - var(--gutter)));
    margin-inline: calc(-1 * var(--edge));
    padding-inline: var(--pad);
    scroll-padding-inline: var(--pad);
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .adv__track::-webkit-scrollbar { display: none; }
  .adv__track > li {
    flex: 0 0 clamp(310px, 30vw, 400px);
    min-height: clamp(380px, 32vw, 440px);  /* крупнее (№126), компактнее внутри (№139) */  /* карточки вытянуты в высоту, крупнее (правка №54); на телефоне — по содержимому */
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(18px, 1.8vw, 24px);  /* компактнее внутри (№139) */
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white-card));
  }
  .adv__track h3 { font-size: clamp(22px, 1.95vw, 26px); font-weight: var(--w-display-sm); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); }
  .adv__text { font-size: var(--fs-lead); line-height: 1.4; }
  /* конкретика прижата к низу карточки и набрана одним стилем (правки №31, №41–45) */
  .adv__chips, .adv__guar, .adv__person, .adv__msg { margin-top: auto; }
  /* как пункты услуг: без тире, тонкие линии между строками (правка №56) */
  .adv__chips { display: grid; font-size: 16px; line-height: 1.3; font-weight: var(--w-semibold); }
  .adv__chips li { padding: 9px 0; }
  .adv__chips li + li { border-top: 1px solid var(--line-subtle); }  /* над первой строкой линии нет (№77) */
  .adv__guar { font-family: var(--ff-display); font-weight: var(--w-display-sm); font-size: var(--fs-h6); line-height: 1.25; }  /* цветом текста, не синим (правка №76) */
  .adv__person { display: flex; align-items: center; gap: 14px; }
  .adv__person p { display: grid; gap: 2px; font-size: 14px; line-height: 1.25; }
  /* <b> — имя на отдельной строке, не выделение внутри фразы */
  .adv__person b { font-family: var(--ff-display); font-weight: var(--w-display); font-size: 17px; }
  .adv__ava { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid var(--c-ink); font-family: var(--ff-display); font-weight: var(--w-display); font-size: 19px; }  /* обводка вместо подложки (№124) */
  /* мессенджеры — круги внахлёст в один ряд; разделяет их кольцо цвета карточки (рамка), тени нет */
  .adv__msg { display: flex; }
  .adv__msg li + li { margin-left: -18px; }
  .adv__msg svg { display: block; box-sizing: content-box; width: 60px; height: 60px; border: 4px solid var(--card-bg, var(--c-band)); border-radius: 50%; background: var(--bg); }
  @media (max-width: 760px) { .adv__nav { display: none; } .adv__head { display: block; } .adv__track > li { min-height: 0; } }  /* низ карточки прижат к низу и на телефоне (№97) */
</style>
