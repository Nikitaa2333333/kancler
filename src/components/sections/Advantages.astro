---
import { advantages } from '../../data/home';
import { typo } from '../../lib/typo';
---

<section class="sec sec--block sec--white adv" id="preimushchestva" aria-labelledby="adv-title">
  <div class="wrap">
    <div class="adv__head">
      <h2 id="adv-title">{typo(advantages.title)}</h2>
      <p class="adv__lead">{typo(advantages.lead)}</p>
    </div>

    <ul class="adv__grid">
      {advantages.items.map((it) => (
        <li>
          <h3>{typo(it.title)}</h3>
          <p>{typo(it.text)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .adv__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--head-gap);
    align-items: end;
    margin-bottom: var(--head-gap);
  }
  .adv__lead { max-width: var(--measure-lead); font-size: var(--fs-lead); line-height: var(--lh-lead); }
  .adv__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .adv__grid li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white-card));
  }
  .adv__grid h3 { font-size: var(--fs-h5); line-height: var(--lh-h5); letter-spacing: var(--tr-h5); max-width: 20ch; }
  .adv__grid p { max-width: 36ch; }
  @media (max-width: 980px) { .adv__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .adv__head { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .adv__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
