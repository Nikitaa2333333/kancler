---
import { advantages } from '../../data/home';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';

/* монограмма вместо фото основателя, пока клиент его не прислала (открытый вопрос 3) */
const initials = company.founder.name.split(' ').slice(0, 2).reverse().map((w) => w[0]).join('');
const founderShort = company.founder.name.split(' ').slice(0, 2).reverse().join(' ');
/* простые знаки мессенджеров одним цветом — без чужих фирменных цветов */
const icons: Record<string, string> = {
  Telegram: '<path d="M20.5 4.2 3.6 10.7c-.9.4-.9 1.6.1 1.9l4.1 1.3 1.6 5c.3.8 1.3 1 1.9.4l2.3-2.2 4.3 3.2c.7.5 1.7.1 1.9-.7L22 5.5c.2-1-.7-1.7-1.5-1.3Zm-3.2 3.6-7.6 6.9-.3 3-1.1-3.6 9-6.3Z"/>',
  WhatsApp: '<path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.5 21.5l4.8-1.3A9.5 9.5 0 1 0 12 2.5Zm0 2a7.5 7.5 0 1 1-3.9 13.9l-.3-.2-2.4.7.7-2.3-.2-.4A7.5 7.5 0 0 1 12 4.5Zm-3 3.4c-.3 0-.7.1-1 .5-.3.4-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 2.4 1 2.9.8 3.4.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.4l-1.9-.9c-.3-.1-.5-.1-.7.2l-.8 1c-.2.2-.3.2-.6.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.9-2c-.2-.6-.5-.5-.7-.5H9Z"/>',
  'Макс': '<path d="M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19Zm-4 5h1.8l2.2 4 2.2-4H16v9h-1.8v-5.6l-2.2 3.9-2.2-3.9v5.6H8v-9Z"/>',
};
---

<!-- Горизонтальная прокрутка (решение 23.10.2026): карточки не вываливаются все сразу,
     листаются стрелками, колесом/свайпом; snap по карточкам. -->
<section class="sec sec--block sec--white adv" id="preimushchestva" aria-labelledby="adv-title">
  <div class="wrap">
    <div class="adv__head">
      <div class="adv__title">
        <h2 id="adv-title">{typo(advantages.title)}</h2>
        <p class="adv__lead">{typo(advantages.lead)}</p>
      </div>
      <div class="adv__nav">
        <button class="adv__arrow" type="button" data-dir="-1" aria-label="Назад">←</button>
        <button class="adv__arrow" type="button" data-dir="1" aria-label="Вперёд">→</button>
      </div>
    </div>

    <ul class="adv__track" data-track>
      {advantages.items.map((it) => (
        <li>
          <span class="adv__mark" aria-hidden="true"></span>
          <h3>{typo(it.title)}</h3>
          <p class="adv__text">{typo(it.text)}</p>
          {it.chips && <ul class="adv__chips">{it.chips.map((c) => <li>{typo(c)}</li>)}</ul>}
          {it.guarantee && <p class="adv__guar">{typo(it.guarantee)}</p>}
          {it.person && (
            <div class="adv__person">
              <span class="adv__ava" aria-hidden="true">{initials}</span>
              <span>{typo(founderShort)}, основатель, лично контролирует отчётность</span>
            </div>
          )}
          {it.messengers && (
            <ul class="adv__msg">
              {it.messengers.map((m) => (
                <li><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor" set:html={icons[m]} /><span>{m}</span></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-track]');
  document.querySelectorAll<HTMLButtonElement>('.adv__arrow').forEach((b) =>
    b.addEventListener('click', () => {
      if (!track) return;
      const card = track.firstElementChild as HTMLElement | null;
      const step = card ? card.offsetWidth + 16 : 300;
      track.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
    }),
  );
</script>

<style>
  .adv__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--head-gap);
    margin-bottom: var(--head-gap);
  }
  .adv__title { display: grid; gap: 16px; }
  .adv__lead { max-width: var(--measure-lead); font-size: var(--fs-lead); line-height: 1.45; }
  .adv__nav { display: flex; gap: 8px; flex: none; }
  .adv__arrow {
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--c-tint);
    color: var(--c-ink);
    font-size: 20px;
    cursor: pointer;
    transition: background-color .2s, color .2s;
  }
  .adv__arrow:hover { background: var(--c-ink); color: var(--c-white); }

  /* лента уходит за край экрана, а не обрезается полями блока (правка №8, 28.10):
     растягиваем на всю ширину окна, а отступ слева/справа возвращаем паддингом */
  .adv__track {
    display: flex;
    gap: var(--card-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* --edge — расстояние от края окна до текста блока (поле блока + отступ .wrap) */
    --edge: calc(var(--hero-frame) + max(var(--gutter), (100vw - 2 * var(--hero-frame) - var(--page-max)) / 2));
    margin-inline: calc(-1 * var(--edge));
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
    padding-bottom: 8px;
    scrollbar-width: none;
  }
  .adv__track::-webkit-scrollbar { display: none; }
  .adv__track > li {
    flex: 0 0 clamp(240px, 24vw, 300px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: clamp(260px, 22vw, 300px);
    padding: clamp(20px, 2vw, 28px);
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white-card));
  }
  .adv__mark { width: 8px; height: 8px; background: var(--c-purple); }  /* фиолетовый — только мелкий акцент */
  .adv__track h3 { font-size: var(--fs-h5); font-weight: var(--w-display-sm); line-height: var(--lh-h5); letter-spacing: var(--tr-h5); }
  .adv__text { line-height: 1.35; }
  /* конкретика прижата к низу карточки (правка №31) */
  .adv__chips, .adv__guar, .adv__person, .adv__msg { margin-top: auto; }
  .adv__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .adv__chips li { padding: 5px 12px; border-radius: 999px; background: var(--c-tint); font-size: 14px; font-weight: var(--w-medium); line-height: 1.3; }
  .adv__guar { padding-top: 12px; border-top: 2px solid var(--c-primary); font-family: var(--ff-display); font-weight: var(--w-display-sm); font-size: var(--fs-h6, 18px); line-height: 1.3; color: var(--c-primary); }
  .adv__person { display: flex; align-items: center; gap: 12px; font-size: 14px; line-height: 1.3; }
  .adv__ava { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--c-tint); font-family: var(--ff-display); font-weight: var(--w-display); font-size: 18px; color: var(--c-primary); }
  .adv__msg { display: flex; gap: 16px; }
  .adv__msg li { display: grid; justify-items: center; gap: 6px; font-size: 13px; font-weight: var(--w-medium); }
  .adv__msg svg { box-sizing: content-box; padding: 11px; border-radius: 50%; background: var(--c-tint); color: var(--c-primary); }
  @media (max-width: 760px) { .adv__nav { display: none; } .adv__head { display: block; } }
</style>
