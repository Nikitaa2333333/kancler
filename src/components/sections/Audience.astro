---
import { audience } from '../../data/home';
import { typo } from '../../lib/typo';
import Shapes from '../Shapes.astro';

const kinds = ['tower', 'grid', 'arch', 'gear'] as const;
---

<section class="sec sec--block aud" id="dlya-kogo" aria-labelledby="aud-title">
  <div class="wrap">
    <div class="aud__head">
      <h2 id="aud-title">{typo(audience.title)}</h2>

      <!-- Печатная машинка без плашки (решение 23.10.2026): виды работ из текста
           клиента печатаются и стираются, мигает курсор -->
      <p class="aud__works" aria-label={`${audience.works.join(', ')} ${audience.worksSuffix}`}>
        <span aria-hidden="true"><span data-type data-words={JSON.stringify(audience.works)}>{audience.works[0]}</span><span class="aud__caret"></span></span>
        <span aria-hidden="true">{audience.worksSuffix}</span>
      </p>

    </div>

    <ul class="aud__grid">
      {audience.cards.map((c, i) => (
        <li>
          <div class="aud__text">
            <h3>{typo(c.title)}</h3>
            <p>{typo(c.text)}</p>
          </div>
          <div class="aud__art"><Shapes kind={kinds[i]} /></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-type]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let w = 0;
    let n = words[0].length;
    let deleting = true;
    const tick = () => {
      if (deleting) {
        n--;
        if (n <= 0) { deleting = false; w = (w + 1) % words.length; n = 0; }
      } else {
        n++;
      }
      el.textContent = words[w].slice(0, n);
      let delay = deleting ? 35 : 70;
      if (!deleting && n === words[w].length) { deleting = true; delay = 1800; }
      if (deleting && n === 0) delay = 250;
      setTimeout(tick, delay);
    };
    setTimeout(tick, 1800);
  }
</script>

<style>
  .aud__head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(16px, 2vw, 24px);
    margin-bottom: var(--head-gap);
  }
  .aud__head h2 { max-width: 22ch; }

  .aud__works {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.3em;
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--tr-h3);
  }
  .aud__caret {
    display: inline-block;
    width: 0.06em;
    height: 0.95em;
    margin-left: 0.04em;
    vertical-align: -0.1em;
    background: currentColor;
    animation: aud-blink 1s steps(1) infinite;
  }
  @keyframes aud-blink { 50% { opacity: 0; } }


  .aud__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  /* вертикальные высокие карточки с формой посередине (решение 23.10.2026) */
  .aud__grid li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: clamp(320px, 28vw, 400px);
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--r-lg);
    /* лёгкий градиент: сверху цвет карточки, книзу едва зеленоватый */
    background: linear-gradient(180deg, var(--card-bg, var(--c-white-card)) 35%, #eef3ef 100%);
  }
  .aud__text { display: grid; gap: 8px; }
  /* чертёж крупно, на всю ширину карточки, прижат к низу */
  .aud__art { flex: 1; display: grid; align-items: end; justify-items: center; padding: 20px 4px 4px; }
  .aud__art :global(.shape) { max-width: 260px; }
  .aud__grid h3 { font-size: var(--fs-h5); line-height: var(--lh-h5); letter-spacing: var(--tr-h5); }
  @media (max-width: 1100px) { .aud__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .aud__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .aud__caret { animation: none; } }
</style>
