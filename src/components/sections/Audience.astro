---
import { audience } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<section class="sec aud" id="dlya-kogo" aria-labelledby="aud-title">
  <div class="wrap">
    <div class="aud__head">
      <h2 id="aud-title">{typo(audience.title)}</h2>
      <p class="aud__lead">{typo(audience.lead)}</p>
    </div>

    <div class="aud__body">
      <!-- 3D-каска (public/images/hardhat.png) — визуал секции вместо иконок -->
      <figure class="aud__visual">
        <img src={u('/images/hardhat.png')} alt="" width="900" height="900" loading="lazy" decoding="async" />
      </figure>

      <ul class="aud__list">
        {audience.cards.map((c) => (
          <li>
            <h3>{typo(c.title)}</h3>
            <p>{typo(c.text)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .aud__head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(20px, 2.4vw, 32px);
    margin-bottom: var(--head-gap);
  }
  .aud__head h2 { max-width: 24ch; }
  .aud__lead { max-width: var(--measure-lead); font-size: var(--fs-lead); line-height: var(--lh-lead); }

  .aud__body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--card-gap);
    align-items: stretch;
  }
  .aud__visual {
    display: grid;
    place-items: center;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: #e9e5dc; /* = фон рендера каски, чтобы картинка не «плавала» прямоугольником */
  }
  .aud__visual img { width: min(100%, 420px); height: auto; mix-blend-mode: multiply; }

  .aud__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .aud__list li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(20px, 2.2vw, 28px);
    border-radius: var(--r-lg);
    background: var(--fill-card);
  }
  .aud__list h3 { font-size: var(--fs-h5); line-height: var(--lh-h5); letter-spacing: var(--tr-h5); }
  .aud__list p { max-width: 34ch; }

  @media (max-width: 860px) {
    .aud__body { grid-template-columns: minmax(0, 1fr); }
    .aud__visual img { width: min(100%, 300px); }
  }
  @media (max-width: 520px) { .aud__list { grid-template-columns: minmax(0, 1fr); } }
</style>
