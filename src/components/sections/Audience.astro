---
import { audience } from '../../data/home';
import { typo } from '../../lib/typo';
import AudienceUI from '../AudienceUI.astro';

/* мини-интерфейсы вместо чертежей: финансы, не стройка (клиент + пользователь, 26.10.2026) */
const kinds = ['objects', 'ks2', 'margin', 'contracts'] as const;
---

<section class="sec sec--block aud" id="dlya-kogo" aria-labelledby="aud-title">
  <div class="wrap">
    <div class="aud__head">
      <h2 id="aud-title">{typo(audience.title)}</h2>

      <!-- Печатная машинка снята (правка №11, 28.10.2026) -->

    </div>

    <ul class="aud__grid">
      {audience.cards.map((c, i) => (
        <li>
          <div class="aud__text">
            <h3>{typo(c.title)}</h3>
            <p>{typo(c.text)}</p>
          </div>
          <div class="aud__art"><AudienceUI kind={kinds[i]} /></div>
        </li>
      ))}
    </ul>
  </div>
</section>


<style>
  .aud__head {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(16px, 2vw, 24px);
    margin-bottom: var(--head-gap);
  }
  .aud__head h2 { max-width: 22ch; }



  .aud__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  /* вертикальные высокие карточки с формой посередине (решение 23.10.2026) */
  .aud__grid li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: clamp(320px, 28vw, 400px);
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--r-lg);
    /* лёгкий градиент: сверху цвет карточки, книзу едва зеленоватый */
    background: var(--card-bg, var(--c-white-card));
  }
  .aud__text { display: grid; gap: 14px; }
  .aud__text p { line-height: 1.35; }
  /* чертёж крупно, на всю ширину карточки, прижат к низу */
  /* виджет на всю ширину карточки, прижат к низу, без своей подложки */
  .aud__art { flex: 1; display: grid; align-items: end; padding-top: 24px; }
  .aud__grid h3 { font-size: var(--fs-h5); font-weight: var(--w-display-sm); line-height: var(--lh-h5); letter-spacing: var(--tr-h5); }
  @media (max-width: 1100px) { .aud__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .aud__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
