---
import { audience } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* вырезки к карточкам — по порядку audience.cards (генподрядчики, субподрядчики,
   ремонт и отделка, инжиниринг); сцены el-aud-* в хабе image-styler */
const art = ['aud-general', 'aud-sub', 'aud-finish', 'aud-eng'];
---

<!-- «Для кого» в коллажной подаче (только /variant-collage/, тема «брут»). Тексты —
     из home.ts, как на главной; вместо тонких чертежей — фото-вырезки на светло-зелёном
     поле с миллиметровкой (решение пользователя 23.10.2026). Свой компонент, а не
     правка Audience.astro: тот принадлежит строгой главной. -->
<section class="sec sec--block audc" id="dlya-kogo" aria-labelledby="audc-title">
  <div class="wrap">
    <div class="audc__head">
      <h2 id="audc-title">{typo(audience.title)}</h2>
      <p class="audc__works" aria-label={`${audience.works.join(', ')} ${audience.worksSuffix}`}>
        <span aria-hidden="true"><span data-type-c data-words={JSON.stringify(audience.works)}>{audience.works[0]}</span><span class="audc__caret"></span></span>
        <span aria-hidden="true">{audience.worksSuffix}</span>
      </p>
    </div>

    <ul class="audc__grid">
      {audience.cards.map((c, i) => (
        <li>
          <div class="audc__art" aria-hidden="true">
            <img src={u(`/images/collage/${art[i]}.webp`)} alt="" width="900" height="900" loading="lazy" decoding="async" style={`--i: ${i}`} />
          </div>
          <h3>{typo(c.title)}</h3>
          <p>{typo(c.text)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Печатная машинка: виды работ из текста клиента печатаются и стираются
  const el = document.querySelector<HTMLElement>('[data-type-c]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let w = 0;
    let n = words[0].length;
    let deleting = true;
    const tick = () => {
      if (deleting) {
        n--;
        if (n <= 0) { deleting = false; w = (w + 1) % words.length; n = 0; }
      } else {
        n++;
      }
      el.textContent = words[w].slice(0, n);
      let delay = deleting ? 35 : 70;
      if (!deleting && n === words[w].length) { deleting = true; delay = 1800; }
      if (deleting && n === 0) delay = 250;
      setTimeout(tick, delay);
    };
    setTimeout(tick, 1800);
  }
</script>

<style>
  .audc__head { display: grid; gap: clamp(14px, 1.6vw, 20px); margin-bottom: var(--head-gap); }
  .audc__head h2 { max-width: 22ch; }
  .audc__works {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3em;
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--tr-h3);
  }
  .audc__caret {
    display: inline-block;
    width: 0.06em;
    height: 0.95em;
    margin-left: 0.04em;
    vertical-align: -0.1em;
    background: currentColor;
    animation: audc-blink 1s steps(1) infinite;
  }
  @keyframes audc-blink { 50% { opacity: 0; } }

  .audc__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .audc__grid li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(12px, 1.2vw, 16px) clamp(12px, 1.2vw, 16px) clamp(20px, 2vw, 28px);
    border: var(--line);
    background: var(--card-bg, var(--c-white-card));
  }
  /* поле под вырезку: светлый зелёный с той же миллиметровкой, что на первом экране */
  .audc__art {
    --grid-cell: 20px;
    aspect-ratio: 1 / 1;
    margin-bottom: 8px;
    border: var(--line);
    background-color: var(--c-green-soft);
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: var(--grid-cell) var(--grid-cell);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .audc__art img {
    width: 88%;
    height: 88%;
    object-fit: contain;
    transform-origin: 50% 90%;
    animation: audc-sway 7s ease-in-out calc(var(--i) * -1.7s) infinite alternate;
  }
  @keyframes audc-sway { from { rotate: -1.2deg; } to { rotate: 1.2deg; } }
  .audc__grid h3 { padding-inline: 6px; font-size: var(--fs-h5); line-height: var(--lh-h5); letter-spacing: var(--tr-h5); }
  .audc__grid p { padding-inline: 6px; line-height: 1.35; }

  @media (max-width: 1100px) { .audc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .audc__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .audc__caret, .audc__art img { animation: none; } }
</style>
