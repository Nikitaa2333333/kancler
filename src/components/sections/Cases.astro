---
import { cases } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<section class="sec cases" id="keysy" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="cases__head">
      <h2 id="cases-title">{typo(cases.title)}</h2>
      <a class="btn" href={u('/keysy/')}>{cases.all}</a>
    </div>

    <ul class="cases__grid">
      {cases.items.map((c) => (
        <li class={`case case--${c.tone}`}>
          <h3>{typo(c.title)}</h3>
          <a class="link" href={u('/keysy/')}>Читать кейс →</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cases__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
  .cases__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .case {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    min-height: clamp(260px, 24vw, 340px);
    padding: clamp(22px, 2.4vw, 32px);
    border-radius: var(--r-lg);
  }
  .case h3 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); max-width: 16ch; }
  .case--beige { background: var(--c-beige); }
  .case--blue { background: var(--c-blue); }
  .case--ink { background: var(--c-ink); color: var(--c-white); }
  .case--ink h3 { color: var(--c-white); }
  @media (max-width: 980px) { .cases__grid { grid-template-columns: minmax(0, 1fr); } .case { min-height: 200px; } }
</style>
