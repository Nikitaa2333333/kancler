---
import { cases } from '../../data/home';
import { cases as items } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
import CaseCards from '../page/CaseCards.astro';
---

<section class="sec sec--block cases" id="keysy" aria-labelledby="cases-title">
  <div class="wrap">
    <div class="cases__head">
      <h2 id="cases-title">{typo(cases.title)}</h2>
      <a class="btn" href={u('/keysy/')}>{cases.all}</a>
    </div>

    <!-- три кейса клиента со слайдов «Проект сайта» (27.10.2026), картинки — со слайдов -->
    <CaseCards items={items} />
  </div>
</section>

<style>
  .cases__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
</style>
