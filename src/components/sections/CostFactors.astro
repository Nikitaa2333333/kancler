---
import { cost } from '../../data/home';
import { typo } from '../../lib/typo';
import FactorGrid from '../page/FactorGrid.astro';

/* В едином стиле со страницами услуг (правка №18, 28.10.2026): вместо таблицы — сетка
   факторов: заголовок антиквой и пояснение, без плашек; номера сняты (№26), линии сняты и
   плотнее (№80); та же сетка — на странице бухучёта (FactorGrid, №64).
   Текст клиента разделён по скобке, как было; пояснение — с заглавной буквы. */
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<section class="sec sec--block sec--white" id="stoimost" aria-labelledby="cost-title">
  <div class="wrap">
    <div class="cost__head">
      <p class="cost__tag">{typo(cost.accounting.title)}</p>
      <h2 id="cost-title">{typo(cost.title)}</h2>
    </div>

    <!-- Колонка «Управленческий учёт» появится, когда клиент пришлёт текст («ДУМАЕМ»). -->
    <FactorGrid items={cost.accounting.rows.map(([factor, why]) => ({ title: factor, text: cap(why) }))} />
  </div>
</section>

<style>
  .cost__head { display: grid; gap: 12px; margin-bottom: clamp(20px, 2.4vw, 32px); }
  /* «Бухгалтерское сопровождение» — бирка над заголовком (правка №96) */
  /* бирка-«марка»: прямоугольник со срезанным уголком, как у жирных знаков (№113) */
  .cost__tag { justify-self: start; padding: 7px 18px 7px 14px; background: var(--c-tint); clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%); font-size: var(--fs-small); font-weight: var(--w-semibold); }
</style>
