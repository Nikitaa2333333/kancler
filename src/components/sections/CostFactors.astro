---
import { cost } from '../../data/home';
import { typo } from '../../lib/typo';

/* В едином стиле со страницами услуг (правка №18, 28.10.2026): вместо таблицы — сетка
   факторов: заголовок антиквой и пояснение, линия сверху, без плашек; номера сняты (№26).
   Текст клиента разделён по скобке, как было; пояснение — с заглавной буквы. */
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<section class="sec sec--block sec--white" id="stoimost" aria-labelledby="cost-title">
  <div class="wrap">
    <div class="cost__head">
      <h2 id="cost-title">{typo(cost.title)}</h2>
      <p class="cost__sub">{typo(cost.accounting.title)}</p>
    </div>

    <!-- Колонка «Управленческий учёт» появится, когда клиент пришлёт текст («ДУМАЕМ»). -->
    <ol class="cost__grid">
      {cost.accounting.rows.map(([factor, why]) => (
        <li>
          <h3>{typo(factor)}</h3>
          <p>{typo(cap(why))}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cost__head { display: grid; gap: 12px; margin-bottom: var(--head-gap); }
  .cost__sub { font-size: var(--fs-lead); font-weight: var(--w-semibold); color: var(--c-primary); }
  .cost__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3vw, 44px) clamp(20px, 3vw, 40px); }
  .cost__grid li { display: grid; align-content: start; gap: 10px; padding-top: clamp(18px, 2vw, 24px); border-top: 1px solid var(--line-subtle); }
  .cost__grid h3 { font-size: var(--fs-h5); line-height: 1.2; letter-spacing: var(--tr-h5); }
  @media (max-width: 980px) { .cost__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cost__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
