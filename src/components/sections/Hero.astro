---
import { hero } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<!-- Первый экран «плашкой» (решение 23.10.2026). №208 (03.11.2026): вместо стокового фото —
     3D-иллюстрация в стиле сайта (docs/иллюстрации-стиль.md): папка, калькулятор, каска,
     чертежи. Предметы справа, слева чистое поле того же цвета под текст — ничего не налезает.
     На телефоне — своя обрезка (только предметы) над текстом. -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__frame">
    <picture>
      <source media="(max-width: 760px)" srcset={u('/images/hero-ill-m.webp')} width="922" height="769" />
      <img class="hero__img" src={u('/images/hero-ill.webp')} alt="" width="1536" height="864" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__copy">
      <h1 id="hero-title">{typo(hero.title)}</h1>
      <p class="hero__lead">{typo(hero.lead)}</p>
      <div class="hero__actions">
        <a class="btn" href="#zayavka">{typo(hero.primary)}</a>
      </div>
      <ul class="hero__facts">
        {hero.facts.map((f) => (
          <li>
            <span class="hero__ftext">{typo(f.text)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { padding: calc(var(--hdr-h) + 4px) var(--hero-frame) 0; }
  .hero__frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* плашка шире картинки: картинка прижата вправо, слева — её же фон под текст (№208) */
    min-height: clamp(560px, 48vw, 720px);
    display: flex;
    align-items: center;
    border-radius: var(--r-lg);
    background: var(--c-hero);  /* = фон иллюстрации */
  }
  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 100% 50%;
  }
  /* светлая подложка слева под текст — плавная, по кривой */
  .hero__shade {
    display: none;  /* фон иллюстрации ровный, подложка под текст не нужна (№208) */
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg,
      rgb(248 249 247 / 0.94) 0%, rgb(248 249 247 / 0.9) 22%, rgb(248 249 247 / 0.78) 34%,
      rgb(248 249 247 / 0.58) 44%, rgb(248 249 247 / 0.34) 54%, rgb(248 249 247 / 0.14) 64%,
      rgb(248 249 247 / 0) 74%);
  }
  .hero__copy {
    display: grid;
    gap: clamp(14px, 1.6vw, 20px);
    justify-items: start;
    max-width: calc(min(560px, 46vw) + var(--edge-in));
    padding: clamp(32px, 4vw, 56px) clamp(32px, 4vw, 56px) clamp(32px, 4vw, 56px) var(--edge-in);  /* по линии текста (№164) */
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tr-h1);
    max-width: 20ch;
  }
  .hero__lead { max-width: 34ch; font-size: var(--fs-h5); line-height: 1.4; }  /* крупнее (правка №34) */
  .hero__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }  /* кнопки ближе (№127) */
  /* Телефон — как на сайте КТМ (правка №10, 28.10): сначала фото во всю ширину, низ фото
     плавно уходит в фон страницы, текст ниже на фоне. Компьютер не трогаем (утверждён). */
  /* знаки без плашек, крупно, с градиентом (№191) */
  .hero__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 170px)); gap: 24px; margin-top: 16px; }
  .hero__facts li { display: grid; align-content: start; }
  /* №233: иконки сняты — три пункта текстом, крупно; что поставить вместо иконок — решим позже */
  .hero__ftext { font-size: clamp(16px, 1.3vw, 18px); font-weight: 700; line-height: 1.25; color: var(--c-title); }
  @media (max-width: 760px) {
    .hero { padding: var(--hdr-h) 0 0; }
    .hero__frame { display: block; aspect-ratio: auto; border-radius: 0; background: var(--c-paper); overflow: visible; min-height: 0; }
    .hero__img { position: relative; inset: auto; z-index: auto; height: auto; aspect-ratio: auto; object-fit: cover; }
    .hero__shade {
      display: block;
      inset: 0 0 auto; z-index: 0; aspect-ratio: 922 / 769;
      background: linear-gradient(180deg, rgb(233 241 250 / 0) 60%, var(--c-paper) 100%);
    }
    .hero__copy { position: relative; z-index: 1; max-width: none; margin-top: -24px; padding: 0 var(--gutter) 8px; }
    .hero__actions { width: 100%; }
    .hero__facts { grid-template-columns: minmax(0, 1fr); gap: 6px; width: 100%; margin-top: 16px; }  /* столбиком, каждый пункт в одну строку (№233) */
    .hero__actions .btn { flex: 1 1 100%; }
  }
</style>
