---
import { hero } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<!-- Первый экран «плашкой», как в шаблоне Avenir (решение 23.10.2026): фото внутри
     скруглённой рамки с полем по краям, текст на фото поверх светлой подложки слева.
     Фото — черновик, пользователь ищет референс на замену. -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__frame">
    <img class="hero__img" src={u('/images/hero-office-warm.jpg')} alt="" width="2560" height="1429" fetchpriority="high" decoding="async" />
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__copy">
      <h1 id="hero-title">{typo(hero.title)}</h1>
      <p class="hero__lead">{typo(hero.lead)}</p>
      <div class="hero__actions">
        <a class="btn" href="#zayavka">{typo(hero.primary)}</a>
        <a class="btn btn--light" href="#keysy">{typo(hero.secondary)}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: calc(var(--hdr-h) + 4px) var(--hero-frame) 0; }
  .hero__frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* рамка в пропорции фото (16:9), чтобы меловые расчёты по краям не срезались (23.10.2026) */
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    border-radius: var(--r-lg);
    background: var(--c-depth);
  }
  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }
  /* светлая подложка слева под текст — плавная, по кривой */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg,
      rgb(248 249 247 / 0.94) 0%, rgb(248 249 247 / 0.9) 22%, rgb(248 249 247 / 0.78) 34%,
      rgb(248 249 247 / 0.58) 44%, rgb(248 249 247 / 0.34) 54%, rgb(248 249 247 / 0.14) 64%,
      rgb(248 249 247 / 0) 74%);
  }
  .hero__copy {
    display: grid;
    gap: clamp(14px, 1.6vw, 20px);
    justify-items: start;
    max-width: 600px;
    padding: clamp(32px, 4vw, 56px);
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tr-h1);
    max-width: 20ch;
  }
  .hero__lead { max-width: 46ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  /* Телефон — как на сайте КТМ (правка №10, 28.10): сначала фото во всю ширину, низ фото
     плавно уходит в фон страницы, текст ниже на фоне. Компьютер не трогаем (утверждён). */
  @media (max-width: 760px) {
    .hero { padding: var(--hdr-h) 0 0; }
    .hero__frame { display: block; aspect-ratio: auto; border-radius: 0; background: var(--c-paper); overflow: visible; }
    .hero__img { position: relative; inset: auto; z-index: auto; height: auto; aspect-ratio: 4 / 3.6; object-position: 62% 50%; }
    .hero__shade {
      inset: 0 0 auto; z-index: 0; aspect-ratio: 4 / 3.6;
      background: linear-gradient(180deg, rgb(247 246 242 / 0) 52%, rgb(247 246 242 / 0.75) 80%, var(--c-paper) 100%);
    }
    .hero__copy { position: relative; z-index: 1; max-width: none; margin-top: -56px; padding: 0 var(--gutter) 8px; }
    .hero__actions { width: 100%; }
    .hero__actions .btn { flex: 1 1 100%; }
  }
</style>
