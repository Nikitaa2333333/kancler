---
import { hero } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<!-- Коллажный вариант первого экрана (страница /variant-collage/, задача
     docs/ЗАДАЧА-коллаж-вариант.md). Сцена 1000×800: графика — SVG в тех же единицах,
     фото-вырезки (PNG/WebP с прозрачностью) стоят в процентах той же сцены, поэтому
     совпадают с графикой на любой ширине. Порядок слоёв: сетка и поля → стройка,
     чертёж → линия графика → руки с листом и калькулятором. -->
<section class="hc" aria-labelledby="hero-title">
  <div class="hc__frame">
    <div class="hc__copy">
      <h1 id="hero-title">{typo(hero.title)}</h1>
      <p class="hc__lead">{typo(hero.lead)}</p>
      <div class="hc__actions">
        <a class="btn" href="#zayavka">{typo(hero.primary)}</a>
        <a class="btn btn--light" href="#keysy">{typo(hero.secondary)}</a>
      </div>
    </div>

    <div class="hc__stage" aria-hidden="true">
      <svg class="hc__svg" viewBox="0 0 1000 800">
        <defs>
          <pattern id="hc-grid" width="28" height="28" patternUnits="userSpaceOnUse">
            <path d="M28 0H0V28" fill="none" stroke="#b8cdd4" stroke-width="1.2" />
          </pattern>
        </defs>
        <rect class="hc__grid" x="0" y="30" width="560" height="640" fill="url(#hc-grid)" />
        <rect class="hc__field" x="170" y="110" width="650" height="470" fill="#0b2e3c" />
        <circle class="hc__pop" style="--d: 1.1s" cx="880" cy="610" r="84" fill="#b8cdd4" />
        <rect class="hc__pop" style="--d: 0.9s" x="905" y="150" width="52" height="52" fill="#7f9f8a" />
        <rect class="hc__pop" style="--d: 1.25s" x="860" y="110" width="18" height="18" fill="#7f9f8a" />
        <rect class="hc__pop" style="--d: 1s" x="96" y="560" width="74" height="74" fill="#7f9f8a" />
        <rect class="hc__pop" style="--d: 1.35s" x="70" y="660" width="20" height="20" fill="#c9d8cc" />
        <rect class="hc__pop" style="--d: 1.45s" x="290" y="620" width="18" height="18" fill="#c9d8cc" />
      </svg>

      <img class="cut cut--building" style="--d: 0.35s" src={u('/images/collage/building.webp')} alt="" width="710" height="1005" decoding="async" fetchpriority="high" />
      <img class="cut cut--blueprint" style="--d: 0.55s" src={u('/images/collage/blueprint.webp')} alt="" width="900" height="687" decoding="async" />

      <svg class="hc__svg hc__svg--chart" viewBox="0 0 1000 800">
        <polyline
          class="hc__chart"
          pathLength="1"
          points="30,700 150,610 235,668 345,535 430,575 530,445 610,468 705,345 790,372 880,215 975,95"
          fill="none" stroke="#7f9f8a" stroke-width="15" stroke-linejoin="miter" stroke-linecap="square"
        />
      </svg>

      <img class="cut cut--sheet" style="--d: 0.75s" src={u('/images/collage/hand-sheet.webp')} alt="" width="900" height="1739" decoding="async" />
      <img class="cut cut--calc" style="--d: 0.95s" src={u('/images/collage/hand-calc.webp')} alt="" width="900" height="1269" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hc { padding: calc(var(--hdr-h) + 4px) var(--hero-frame) 0; }
  .hc__frame {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
    padding: clamp(28px, 3.6vw, 56px);
    border-radius: var(--r-lg);
    background: var(--c-band);
    overflow: hidden;
  }
  .hc__copy {
    display: grid;
    gap: clamp(14px, 1.6vw, 20px);
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tr-h1);
    max-width: var(--measure-head-lg);
  }
  .hc__lead { max-width: 46ch; }
  .hc__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  /* Сцена: пропорция = viewBox SVG (1000×800), координаты вырезок — в % от неё */
  .hc__stage { position: relative; aspect-ratio: 5 / 4; }
  .hc__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cut { position: absolute; height: auto; }
  .cut--building  { left: 23%; top: 1%;  width: 38%; }
  .cut--blueprint { left: 58%; top: 19%; width: 38%; }
  .cut--sheet     { left: 49%; top: 41%; width: 21%; }
  .cut--calc      { left: 75%; top: 49%; width: 23%; }

  /* ---------- Анимация: поле выезжает, квадраты всплывают, вырезки поднимаются и
     покачиваются, линия графика прорисовывается. Подъём — свойство translate,
     покачивание — rotate: так две анимации не перебивают друг друга. ---------- */
  .hc__field,
  .hc__pop { transform-box: fill-box; }
  .hc__field { transform-origin: left center; animation: hc-slide 0.9s cubic-bezier(.2,.7,.2,1) both; }
  .hc__grid { animation: hc-fade 1.2s ease-out both; }
  .hc__pop { transform-origin: center; animation: hc-pop 0.5s cubic-bezier(.3,1.5,.5,1) var(--d) both; }
  .hc__chart {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hc-draw 1.8s cubic-bezier(.45,0,.2,1) 1.1s forwards;
  }
  .cut {
    transform-origin: 50% 90%;
    animation:
      hc-rise 0.9s cubic-bezier(.2,.8,.2,1) var(--d) both,
      hc-sway 7s ease-in-out calc(var(--d) + 0.9s) infinite alternate;
  }
  .cut--blueprint { animation-duration: 0.9s, 9s; }
  .cut--sheet     { animation-duration: 0.9s, 6s; transform-origin: 50% 100%; }
  .cut--calc      { animation-duration: 0.9s, 8s; animation-direction: normal, alternate-reverse; transform-origin: 60% 100%; }

  @keyframes hc-slide { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes hc-fade  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hc-pop   { from { transform: scale(0); } to { transform: scale(1); } }
  @keyframes hc-draw  { to { stroke-dashoffset: 0; } }
  @keyframes hc-rise  { from { opacity: 0; translate: 0 48px; } to { opacity: 1; translate: 0 0; } }
  @keyframes hc-sway  { from { rotate: -0.8deg; } to { rotate: 0.8deg; } }

  @media (prefers-reduced-motion: reduce) {
    .hc__field, .hc__grid, .hc__pop, .cut { animation: none; }
    .hc__chart { animation: none; stroke-dashoffset: 0; }
  }

  @media (max-width: 860px) {
    .hc__frame { grid-template-columns: minmax(0, 1fr); }
    .hc__stage { width: min(100%, 560px); margin-inline: auto; }
  }
</style>
