---
import { hero } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* узлы линии графика — те же точки, что в polyline */
const chart = [[30, 700], [150, 610], [235, 668], [345, 535], [430, 575], [530, 445], [610, 468], [705, 345], [790, 372], [880, 215], [975, 95]];
const points = chart.map((p) => p.join(',')).join(' ');
---

<!-- Коллажный вариант первого экрана, тема «брут» (страница /variant-collage/, задача
     docs/ЗАДАЧА-коллаж-вариант.md). Сцена 1000×800: графика — SVG в тех же единицах,
     фото-вырезки (WebP с прозрачностью) стоят в процентах той же сцены, поэтому
     совпадают с графикой на любой ширине. Слои: сетка и поля → стройка, чертёж →
     линия графика → руки с листом и калькулятором. Миллиметровка — фоном всей плашки. -->
<section class="hc" aria-labelledby="hero-title">
  <div class="hc__frame">
    <div class="hc__copy">
      <h1 id="hero-title">{typo(hero.title)}</h1>
      <p class="hc__lead">{typo(hero.lead)}</p>
      <div class="hc__actions">
        <a class="btn" href="#zayavka">{typo(hero.primary)}</a>
        <a class="btn btn--light" href="#keysy">{typo(hero.secondary)}</a>
      </div>
    </div>

    <div class="hc__stage" aria-hidden="true">
      <svg class="hc__svg" viewBox="0 0 1000 800">
        <rect class="hc__field" x="170" y="110" width="650" height="470" />
        <circle class="hc__pop hc__soft" style="--d: 1.1s" cx="880" cy="610" r="84" />
        <rect class="hc__pop hc__ink" style="--d: 0.9s" x="905" y="150" width="52" height="52" />
        <rect class="hc__pop hc__green" style="--d: 1.25s" x="860" y="110" width="18" height="18" />
        <rect class="hc__pop hc__soft" style="--d: 1s" x="96" y="560" width="74" height="74" />
        <rect class="hc__pop hc__ink" style="--d: 1.35s" x="70" y="660" width="20" height="20" />
        <rect class="hc__pop hc__green" style="--d: 1.45s" x="290" y="620" width="18" height="18" />
      </svg>

      <img class="cut cut--building" style="--d: 0.35s" src={u('/images/collage/building.webp')} alt="" width="710" height="1005" decoding="async" fetchpriority="high" />
      <img class="cut cut--blueprint" style="--d: 0.55s" src={u('/images/collage/blueprint.webp')} alt="" width="900" height="687" decoding="async" />

      <svg class="hc__svg" viewBox="0 0 1000 800">
        <polyline class="hc__chart" pathLength="1" points={points} />
        {chart.map(([x, y], i) => (
          <circle class="hc__node" style={`--d: ${1.2 + i * 0.15}s`} cx={x} cy={y} r="9" />
        ))}
      </svg>

      <img class="cut cut--sheet" style="--d: 0.75s" src={u('/images/collage/hand-sheet.webp')} alt="" width="900" height="1739" decoding="async" />
      <img class="cut cut--calc" style="--d: 0.95s" src={u('/images/collage/hand-calc.webp')} alt="" width="900" height="1269" decoding="async" />
    </div>
  </div>
</section>

<style>
  .hc { padding: calc(var(--hdr-h) + var(--hero-frame)) var(--hero-frame) 0; }
  .hc__frame {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
    padding: clamp(28px, 3.6vw, 56px);
    border: var(--line, 0);
    border-radius: var(--r-lg);
    /* миллиметровка на всю плашку первого экрана (решение пользователя 23.10.2026);
       --grid-cell — шаг клетки, крутить 16–32px */
    --grid-cell: 24px;
    background-color: var(--c-white-card);
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: var(--grid-cell) var(--grid-cell);
    background-position: -1px -1px;
    overflow: hidden;
  }
  .hc__copy {
    display: grid;
    gap: clamp(18px, 2vw, 28px);
    justify-items: start;
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--tr-h1);
    max-width: var(--measure-head-lg);
  }
  .hc__lead { max-width: 46ch; font-size: var(--fs-lead); line-height: var(--lh-lead); }
  .hc__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 12px; }

  /* ---------- Сцена: пропорция = viewBox SVG (1000×800), вырезки — в % от неё ---------- */
  .hc__stage { position: relative; aspect-ratio: 5 / 4; }
  .hc__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .hc__field { fill: var(--c-green, var(--c-sage)); }
  .hc__soft { fill: var(--c-green-soft, var(--c-sage-soft)); }
  .hc__green { fill: var(--c-green, var(--c-sage)); }
  .hc__ink { fill: var(--c-ink); }
  .hc__chart { fill: none; stroke: var(--c-ink); stroke-width: 6; stroke-linejoin: miter; }
  .hc__node { fill: var(--c-white-card); stroke: var(--c-ink); stroke-width: 4; }

  .cut { position: absolute; height: auto; }
  .cut--building  { left: 23%; top: 1%;  width: 38%; }
  .cut--blueprint { left: 58%; top: 19%; width: 38%; }
  .cut--sheet     { left: 49%; top: 41%; width: 21%; }
  .cut--calc      { left: 75%; top: 49%; width: 23%; }

  /* ---------- Анимация: поле выезжает, квадраты всплывают, вырезки поднимаются и
     покачиваются, линия графика прорисовывается, узлы проявляются по очереди.
     Подъём — свойство translate, покачивание — rotate: так две анимации не
     перебивают друг друга. ---------- */
  .hc__field,
  .hc__pop,
  .hc__node { transform-box: fill-box; transform-origin: center; }
  .hc__field { transform-origin: left center; animation: hc-slide 0.8s cubic-bezier(.7,0,.2,1) both; }
  .hc__pop { animation: hc-pop 0.35s steps(3, end) var(--d) both; }
  .hc__node { animation: hc-pop 0.3s cubic-bezier(.3,1.6,.5,1) var(--d) both; }
  .hc__chart {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hc-draw 1.6s linear 1.1s forwards;
  }
  .cut {
    transform-origin: 50% 90%;
    animation:
      hc-rise 0.7s cubic-bezier(.2,.8,.2,1) var(--d) both,
      hc-sway 7s ease-in-out calc(var(--d) + 0.7s) infinite alternate;
  }
  .cut--blueprint { animation-duration: 0.7s, 9s; }
  .cut--sheet     { animation-duration: 0.7s, 6s; transform-origin: 50% 100%; }
  .cut--calc      { animation-duration: 0.7s, 8s; animation-direction: normal, alternate-reverse; transform-origin: 60% 100%; }

  @keyframes hc-slide { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes hc-pop   { from { transform: scale(0); } to { transform: scale(1); } }
  @keyframes hc-draw  { to { stroke-dashoffset: 0; } }
  @keyframes hc-rise  { from { opacity: 0; translate: 0 48px; } to { opacity: 1; translate: 0 0; } }
  @keyframes hc-sway  { from { rotate: -0.8deg; } to { rotate: 0.8deg; } }

  @media (prefers-reduced-motion: reduce) {
    .hc__field, .hc__pop, .hc__node, .cut { animation: none; }
    .hc__chart { animation: none; stroke-dashoffset: 0; }
  }

  @media (max-width: 860px) {
    .hc__frame { grid-template-columns: minmax(0, 1fr); }
    .hc__stage { width: min(100%, 560px); margin-inline: auto; }
  }
</style>
