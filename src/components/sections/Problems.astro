---
import { problems } from '../../data/home';
import { typo } from '../../lib/typo';
---

<section class="sec sec--block sec--white probs" id="problemy" aria-labelledby="probs-title">
  <div class="wrap probs__grid">
    <div class="probs__side">
      <h2 id="probs-title">{typo(problems.title)}</h2>
    </div>

    <!-- Приём КТМ (SloganScroll): пункты серые, пока до них не докрутили, и
         проявляются в полный цвет по мере прокрутки. Решение пользователя 23.10.2026;
         прозрачность текста здесь — эффект, а не приглушение. -->
    <ul class="probs__lines" data-lines>
      {problems.items.map((t) => <li>{typo(t)}</li>)}
    </ul>
    <!-- кнопка под списком, а не рядом с заголовком (правка №33, 30.10) -->
    <a class="btn probs__cta" href="#zayavka">{typo(problems.cta)}</a>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-lines]');
  if (list && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lines = [...list.children] as HTMLElement[];
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = innerHeight;
      for (const li of lines) {
        const top = li.getBoundingClientRect().top;
        // строка начинает проявляться у нижней трети экрана и полностью видна к середине
        const p = Math.min(1, Math.max(0, (vh * 0.8 - top) / (vh * 0.3)));
        li.style.setProperty('--p', p.toFixed(3));
      }
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    let active = false;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !active) { active = true; addEventListener('scroll', onScroll, { passive: true }); update(); }
      else if (!e.isIntersecting && active) { active = false; removeEventListener('scroll', onScroll); }
    }).observe(list);
    list.classList.add('is-scroll');
    update();
  }
</script>

<style>
  .probs__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--head-gap);
    align-items: start;
  }
  .probs__side { position: sticky; top: 112px; display: grid; gap: 28px; justify-items: start; }
  /* заголовок вширь — в 2–3 строки (решение 23.10.2026) */
  .probs__side h2 { max-width: 26ch; }

  .probs__lines { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .probs__lines li {
    font-family: var(--ff-display);
    font-weight: var(--w-display);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    letter-spacing: var(--tr-h4);
    max-width: 30ch;
  }
  .probs__lines.is-scroll li {
    opacity: calc(0.2 + var(--p, 0) * 0.8);
    transition: opacity .15s linear;
  }
  .probs__cta { grid-column: 2; justify-self: start; margin-top: 8px; }
  @media (max-width: 860px) {
    .probs__grid { grid-template-columns: minmax(0, 1fr); }
    .probs__side { position: static; }
    .probs__cta { grid-column: auto; }
  }
</style>
