---
import { problems } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* №222 (03.11.2026): приём «Как мы помогаем по шагам» с сайта клиники (PlanSteps):
   на компьютере слева список ситуаций без плашек, справа липкий кадр с 3D-иллюстрацией —
   меняется под пункт в середине экрана, неактивные пункты полупрозрачные (это состояние
   прокрутки, а не приглушение текста). На телефоне — картинка над пунктом, пункт
   проявляется по прокрутке. Слова клиента не менялись. */
---

<section class="sec sec--block sec--white probs" id="problemy" aria-labelledby="probs-title">
  <div class="wrap">
    <h2 id="probs-title" class="probs__title">{typo(problems.title)}</h2>
    <div class="probs__grid">
      <ol class="probs__list">
        {problems.items.map((t, i) => (
          <li class={`probs__item${i === 0 ? ' is-active' : ''}`}>
            <img class="probs__mimg" src={u(`/images/ill/sit-${i + 1}.webp`)} alt="" width="640" height="640" loading="lazy" decoding="async" />
            <p>{`${i + 1}. `}{typo(t)}</p>
          </li>
        ))}
      </ol>
      <div class="probs__visual" aria-hidden="true">
        {problems.items.map((_, i) => (
          <img class={`probs__panel${i === 0 ? ' is-on' : ''}`} src={u(`/images/ill/sit-${i + 1}.webp`)} alt="" width="640" height="640" loading="lazy" decoding="async" />
        ))}
      </div>
    </div>
    <a class="btn probs__cta" href="#zayavka">{typo(problems.cta)}</a>
  </div>
</section>

<script>
  /* активный пункт — тот, чей центр ближе к середине экрана (как в PlanSteps клиники) */
  const items = [...document.querySelectorAll<HTMLElement>('.probs__item')];
  const panels = [...document.querySelectorAll<HTMLElement>('.probs__panel')];
  const wide = matchMedia('(min-width: 1001px)');
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!wide.matches) return;
    const mid = innerHeight / 2;
    let best = 0, bestD = Infinity;
    items.forEach((el, k) => {
      const r = el.getBoundingClientRect();
      const d = Math.abs(r.top + r.height / 2 - mid);
      if (d < bestD) { bestD = d; best = k; }
    });
    items.forEach((el, k) => el.classList.toggle('is-active', k === best));
    panels.forEach((el, k) => el.classList.toggle('is-on', k === best));
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>

<style>
  .probs__title { max-width: 26ch; margin-bottom: var(--head-gap); }
  .probs__list { display: grid; gap: clamp(28px, 4vw, 56px); }
  .probs__item p {
    max-width: 30ch;
    font-family: var(--ff-display);
    font-weight: var(--w-display-sm);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--tr-h3);
    color: var(--c-title);
  }
  .probs__visual { display: none; }
  .probs__cta { margin-top: clamp(28px, 3vw, 44px); }

  @media (min-width: 1001px) {
    .probs__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 460px); column-gap: clamp(40px, 6vw, 96px); align-items: start; }
    .probs__mimg { display: none; }
    .probs__list { padding-block: 12vh; }
    .probs__item { opacity: .28; transition: opacity .4s ease; }
    .probs__item.is-active { opacity: 1; }
    .probs__visual {
      display: block; position: sticky; top: calc(50vh - 230px);
      aspect-ratio: 1; border-radius: var(--r-xl); background: var(--c-band); overflow: hidden;
    }
    .probs__panel { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; opacity: 0; transition: opacity .5s ease; }
    .probs__panel.is-on { opacity: 1; }
  }
  @media (max-width: 1000px) {
    .probs__item { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; align-items: center; }
    .probs__mimg { width: 120px; height: auto; border-radius: var(--r-xl); background: var(--c-band); }
    .probs__item p { font-size: var(--fs-h5); line-height: 1.25; }
    /* проявление по прокрутке: внизу экрана бледно, к середине — полностью */
    .probs__item { animation: probs-fade linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
  }
  @keyframes probs-fade { from { opacity: .15; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .probs__item { animation: none; opacity: 1; transition: none; } }
</style>
