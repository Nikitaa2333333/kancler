---
import { problems } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* №198 (03.11.2026): плитки как у Яндекса 360 — две широкие сверху и четыре поменьше
   снизу; текст сверху слева, 3D-иллюстрация в правом нижнем углу, срезана краем плитки.
   Стиль картинок зафиксирован — docs/иллюстрации-стиль.md, промпты — docs/иллюстрации-промпты.md.
   Слова клиента не менялись.
   №232: вёрстка плиток — прежняя; с сайта клиники взят только эффект — плитка бледная внизу
   экрана и проявляется по мере прокрутки к середине. */
---

<section class="sec sec--block sec--white probs" id="problemy" aria-labelledby="probs-title">
  <div class="wrap">
    <h2 id="probs-title" class="probs__title">{typo(problems.title)}</h2>
    <ul class="probs__grid bleed">
      {problems.items.map((t, i) => (
        <li class={i < 2 ? 'probs__big' : ''}>
          <p>{typo(t)}</p>
          <img class="probs__art" src={u(`/images/ill/sit-${i + 1}.webp`)} alt="" width="640" height="640" loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
    <a class="btn probs__cta" href="#zayavka">{typo(problems.cta)}</a>
  </div>
</section>

<style>
  .probs__title { max-width: 26ch; margin-bottom: var(--head-gap); }
  .probs__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--card-gap); }
  .probs__grid li {
    position: relative;
    overflow: hidden;
    min-height: clamp(260px, 22vw, 320px);
    padding: var(--card-pad);
    border-radius: var(--r-xl);
    background: var(--card-bg);
  }
  .probs__big { grid-column: span 2; }
  .probs__grid p { position: relative; z-index: 1; max-width: 22ch; font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.35; }
  /* крупные плитки — тем же Manrope, только крупнее (№207: засечки в тексте не нравятся) */
  .probs__big p { max-width: 24ch; font-size: var(--fs-h6); font-weight: var(--w-semibold); line-height: 1.3; }
  /* картинка в правом нижнем углу, выходит за край и срезается скруглением плитки */
  .probs__art { position: absolute; right: -6%; bottom: -8%; width: 62%; height: auto; pointer-events: none; }
  .probs__big .probs__art { width: 46%; right: -3%; bottom: -10%; }
  /* эффект прозрачности по прокрутке (№232), как в «Как мы помогаем по шагам» на сайте клиники */
  .probs__grid li { animation: probs-fade linear both; animation-timeline: view(); animation-range: entry 0% cover 40%; }
  @keyframes probs-fade { from { opacity: .15; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .probs__grid li { animation: none; } }
  .probs__cta { margin-top: clamp(20px, 2.4vw, 32px); }
  @media (max-width: 1000px) {
    .probs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .probs__big .probs__art { width: 52%; }
  }
  @media (max-width: 560px) {
    .probs__grid { grid-template-columns: minmax(0, 1fr); }
    .probs__big { grid-column: auto; }
    .probs__grid li { min-height: 210px; }
    .probs__grid p, .probs__big p { max-width: 58%; }
    .probs__art, .probs__big .probs__art { width: 50%; right: -4%; bottom: -10%; }
  }
</style>
