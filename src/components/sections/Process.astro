---
import { process as proc } from '../../data/home';
import { typo } from '../../lib/typo';
---

<section class="sec sec--block sec--white sec--over" id="kak-rabotaem" aria-labelledby="proc-title">
  <div class="wrap">
    <div class="proc__head">
      <h2 id="proc-title">{typo(proc.title)}</h2>
      <a class="btn" href="#zayavka">{typo(proc.cta)}</a>
    </div>

    <ol class="proc__grid">
      {proc.steps.map((s, i) => (
        <li>
          <span class="proc__step" aria-hidden="true">Шаг {i + 1}</span>
          <h3>{typo(s.title)}</h3>
          <p>{typo(s.text)}</p>
        </li>
      ))}
    </ol>

    <p class="proc__note">{typo(proc.footnote)}</p>

    <div class="proc__guarantee">
      <h3>{typo(proc.guarantee.title)}</h3>
      <p>{typo(proc.guarantee.text)}</p>
    </div>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
  .proc__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .proc__grid li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(20px, 2vw, 28px);
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white-card));
  }
  .proc__step {
    justify-self: start;
    margin-bottom: 8px;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    background: var(--c-tint);
    font-size: var(--fs-small);
    font-weight: var(--w-semibold);
  }
  .proc__grid h3 { font-size: var(--fs-h6); font-weight: var(--w-display-sm); line-height: var(--lh-h6); letter-spacing: var(--tr-h6); }
  /* гарантия — крупный акцент (правка №17, 28.10): тёмная плашка цвета подвала, заголовок
     размером h2, текст крупным лидом; на компьютере заголовок слева, текст справа */
  .proc__guarantee {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(16px, 4vw, 64px);
    align-items: end;
    margin-top: clamp(24px, 3vw, 40px);
    padding: clamp(28px, 4.4vw, 64px);
    border-radius: var(--r-lg);
    background: var(--c-primary-deep);
    color: var(--c-white);
  }
  .proc__guarantee h3 { font-size: var(--fs-h2); font-weight: var(--w-display); line-height: var(--lh-h2); letter-spacing: var(--tr-h2); max-width: 16ch; }
  .proc__guarantee p { font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 40ch; opacity: 0.9; }
  @media (max-width: 860px) { .proc__guarantee { grid-template-columns: minmax(0, 1fr); align-items: start; } }
  .proc__note { margin-top: 16px; max-width: var(--measure-text); font-size: var(--fs-small); }
  @media (max-width: 1100px) { .proc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .proc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
