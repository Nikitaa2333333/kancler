---
import { process as proc } from '../../data/home';
import { typo } from '../../lib/typo';
---

<section class="sec" id="kak-rabotaem" aria-labelledby="proc-title">
  <div class="wrap">
    <div class="proc__head">
      <h2 id="proc-title">{typo(proc.title)}</h2>
      <a class="btn" href="#zayavka">{typo(proc.cta)}</a>
    </div>

    <!-- Швейцарская сетка: пять шагов одного вида, линия сверху у каждого -->
    <ol class="proc__grid">
      {proc.steps.map((s, i) => (
        <li>
          <span class="proc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{typo(s)}</h3>
        </li>
      ))}
    </ol>

    <p class="proc__note">{typo(proc.footnote)}</p>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
  .proc__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0 var(--card-gap);
  }
  .proc__grid li {
    display: grid;
    gap: clamp(28px, 3.4vw, 48px);
    align-content: start;
    padding: 20px 0 clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--c-ink);
  }
  .proc__num { font-size: var(--fs-small); font-weight: var(--w-semibold); }
  .proc__grid h3 { font-size: var(--fs-h6); line-height: var(--lh-h6); letter-spacing: var(--tr-h6); }
  .proc__note { margin-top: 16px; max-width: var(--measure-text); font-size: var(--fs-small); }
  @media (max-width: 1100px) { .proc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .proc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
