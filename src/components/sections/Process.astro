---
import { process as proc } from '../../data/home';
import { typo } from '../../lib/typo';
import OfficeIcon from '../OfficeIcon.astro';
import { u } from '../../lib/url';
/* №200 (03.11.2026): шаги — тёмные плашки, как «Технологии защиты» у Яндекса 360: номер и
   заголовок сверху, 3D-иллюстрация шага внизу (стиль — docs/иллюстрации-стиль.md) */
---

<section class="sec sec--block sec--white" id="kak-rabotaem" aria-labelledby="proc-title">
  <div class="wrap">
    <div class="proc__head">
      <h2 id="proc-title">{typo(proc.title)}</h2>
    </div>

    <ol class="proc__grid bleed">
      {proc.steps.map((s, i) => (
        <li>
          <h3>{`${i + 1}. `}{typo(s.title)}</h3>  <!-- «N. Заголовок» (№214) -->
          <p>{typo(s.text)}</p>
          <img class="proc__art" src={u(`/images/ill/step-${i + 1}.webp`)} alt="" width="480" height="480" loading="lazy" decoding="async" />
        </li>
      ))}
    </ol>

    <p class="proc__note">{typo(proc.footnote)}</p>
    <!-- кнопка под шагами, а не рядом с заголовком (как в «Типичных ситуациях», №33) -->
    <a class="btn proc__cta" href="#zayavka">{typo(proc.cta)}</a>

    <div class="proc__guarantee" data-reveal>
      <span class="proc__shield"><OfficeIcon name="shield" /></span>
      <h3>{typo(proc.guarantee.title)}</h3>
      <p>{typo(proc.guarantee.text)}</p>
    </div>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
  .proc__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .proc__grid li {
    display: grid;
    gap: var(--card-in);
    grid-template-rows: auto auto 1fr;  /* картинка прижата к низу плашки */
    padding: var(--card-pad);
    border-radius: var(--r-xl);
    background: var(--c-night);
    color: var(--c-white);
  }
  .proc__grid h3, .proc__grid p { color: var(--c-white); }
  .proc__grid p { opacity: 1; }
  .proc__art { display: block; width: 78%; max-width: 200px; height: auto; margin: 8px auto -6px; align-self: end;
    /* картинка на своём тёмном фоне (почти цвет плашки), края мягко гаснут — без вырезки (№257) */
    -webkit-mask-image: radial-gradient(closest-side, #000 72%, transparent); mask-image: radial-gradient(closest-side, #000 72%, transparent); }
  /* номер шага — цифрой прямо в заголовке, без слова «Шаг» (правка №128) */
  /* стрелки на стыке карточек сняты (№264; были с №187) */
  .proc__grid h3 { font-size: var(--fs-h6); font-weight: var(--w-display-sm); line-height: var(--lh-h6); letter-spacing: var(--tr-h6); }
  /* гарантия — крупный текст без плашки, со щитом (№28; щит снимали в №46, вернули в №60, перерисован в стиле знаков услуг — №79) */
  .proc__guarantee {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    justify-items: center;
    text-align: center;  /* по центру (№235) */
    margin-top: clamp(40px, 5vw, 64px);  /* без линии сверху (правка №84) */
    /* отдельный блок — не сливается со следующей секцией («Параметры сопровождения», «Тарифы») (№253) */
    margin-bottom: clamp(48px, 6vw, 88px);
    /* №268: на своём фоне — голубая плашка, как у кейсов */
    padding: clamp(36px, 5vw, 72px) var(--card-px, 28px);
    border-radius: var(--r-xl);
    background: var(--c-hero);
  }
  @media (max-width: 560px) { .proc__guarantee { margin-inline: calc(-1 * var(--gutter)); } }  /* в 6 px от края, как плашки */
  /* появление при прокрутке (№268): плашка выезжает снизу, щит «впрыгивает», заголовок и текст —
     следом. Без JS и при «меньше движения» — сразу видно (скрипт в Base.astro ставит .is-in) */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .proc__guarantee { opacity: 0; transform: translateY(40px); transition: opacity .7s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
    .proc__guarantee > * { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
    .proc__guarantee .proc__shield { transform: scale(.4) rotate(-12deg); transition: opacity .5s ease .25s, transform .7s cubic-bezier(.3, 1.6, .5, 1) .25s; }
    .proc__guarantee h3 { transition-delay: .45s; }
    .proc__guarantee p { transition-delay: .6s; }
    .proc__guarantee:global(.is-in), .proc__guarantee:global(.is-in) > * { opacity: 1; transform: none; }
  }
  /* щит — внутри заголовка, на уровне текста: высотой со строчную, перед первым словом (№123) */
  /* щит над заголовком, текст под заголовком — левый край ровный (№159) */
  .proc__shield { display: block; width: clamp(44px, 4vw, 56px); color: var(--c-heading); }
  .proc__guarantee h3 { font-size: var(--fs-h2); font-weight: var(--w-display); line-height: var(--lh-h2); letter-spacing: var(--tr-h2); max-width: 24ch; }
  .proc__guarantee p { font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 56ch; }
  @media (max-width: 860px) { .proc__guarantee { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 16px; } }
  .proc__note { margin-top: 12px; max-width: var(--measure-text); font-size: var(--fs-body); line-height: 1.4; }  /* обычный кегль, прижата к карточкам (№158) */  /* плотнее (правка №58) */
  .proc__cta { margin-top: 20px; }
  /* телефон — шаги лентой с горизонтальной прокруткой, уходят за край экрана (правка №29) */
  @media (max-width: 760px) {
    .proc__grid {
      --edge: calc(var(--hero-frame) + var(--gutter));
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(-1 * var(--edge)); padding-inline: var(--hero-frame); scroll-padding-inline: var(--hero-frame);  /* узко от экрана (№149) */
    }
    .proc__grid::-webkit-scrollbar { display: none; }
    .proc__grid li { flex: 0 0 78%; scroll-snap-align: start; }
  }
  @media (max-width: 1100px) { .proc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .proc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
