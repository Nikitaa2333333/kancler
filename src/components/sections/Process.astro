---
import { process as proc } from '../../data/home';
import { typo } from '../../lib/typo';
import OfficeIcon from '../OfficeIcon.astro';
---

<section class="sec sec--block sec--white" id="kak-rabotaem" aria-labelledby="proc-title">
  <div class="wrap">
    <div class="proc__head">
      <h2 id="proc-title">{typo(proc.title)}</h2>
    </div>

    <ol class="proc__grid bleed">
      {proc.steps.map((s, i) => (
        <li>
          <h3><span class="proc__n">{i + 1}</span>{typo(s.title)}</h3>
          <p>{typo(s.text)}</p>
        </li>
      ))}
    </ol>

    <p class="proc__note">{typo(proc.footnote)}</p>
    <!-- кнопка под шагами, а не рядом с заголовком (как в «Типичных ситуациях», №33) -->
    <a class="btn proc__cta" href="#zayavka">{typo(proc.cta)}</a>

    <div class="proc__guarantee">
      <h3><span class="proc__shield"><OfficeIcon name="shield" /></span>{typo(proc.guarantee.title)}</h3>
      <p>{typo(proc.guarantee.text)}</p>
    </div>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
  .proc__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .proc__grid li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: clamp(20px, 2vw, 28px);
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white-card));
  }
  /* номер шага — цифрой прямо в заголовке, без слова «Шаг» (правка №128) */
  .proc__n { margin-right: 0.4em; }
  .proc__grid h3 { font-size: var(--fs-h6); font-weight: var(--w-display-sm); line-height: var(--lh-h6); letter-spacing: var(--tr-h6); }
  /* гарантия — крупный текст без плашки, со щитом (№28; щит снимали в №46, вернули в №60, перерисован в стиле знаков услуг — №79) */
  .proc__guarantee {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(16px, 3vw, 48px);
    align-items: center;
    margin-top: clamp(40px, 5vw, 64px);  /* без линии сверху (правка №84) */
  }
  /* щит — внутри заголовка, на уровне текста: высотой со строчную, перед первым словом (№123) */
  .proc__shield { display: inline-block; width: 1.25em; margin-right: 0.25em; vertical-align: -0.24em; color: var(--c-ink); }  /* крупнее, явнее (№137) */
  .proc__guarantee h3 { font-size: var(--fs-h2); font-weight: var(--w-display); line-height: var(--lh-h2); letter-spacing: var(--tr-h2); max-width: 16ch; }
  .proc__guarantee p { font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 40ch; }
  @media (max-width: 860px) { .proc__guarantee { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 16px; } }
  .proc__note { margin-top: 16px; max-width: var(--measure-text); font-size: var(--fs-small); line-height: 1.3; }  /* плотнее (правка №58) */
  .proc__cta { margin-top: 20px; }
  /* телефон — шаги лентой с горизонтальной прокруткой, уходят за край экрана (правка №29) */
  @media (max-width: 760px) {
    .proc__grid {
      --edge: calc(var(--hero-frame) + var(--gutter));
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(-1 * var(--edge)); padding-inline: var(--hero-frame); scroll-padding-inline: var(--hero-frame);  /* узко от экрана (№149) */
    }
    .proc__grid::-webkit-scrollbar { display: none; }
    .proc__grid li { flex: 0 0 78%; scroll-snap-align: start; }
  }
  @media (max-width: 1100px) { .proc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .proc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
