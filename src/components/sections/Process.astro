---
import { process as proc } from '../../data/home';
import { typo } from '../../lib/typo';
import OfficeIcon from '../OfficeIcon.astro';
import { u } from '../../lib/url';
/* №200 (03.11.2026): шаги — тёмные плашки, как «Технологии защиты» у Яндекса 360: номер и
   заголовок сверху, 3D-иллюстрация шага внизу (стиль — docs/иллюстрации-стиль.md) */
---

<section class="sec sec--block sec--white" id="kak-rabotaem" aria-labelledby="proc-title">
  <div class="wrap">
    <div class="proc__head">
      <h2 id="proc-title">{typo(proc.title)}</h2>
    </div>

    <ol class="proc__grid bleed">
      {proc.steps.map((s, i) => (
        <li>
          <h3>{`${i + 1}. `}{typo(s.title)}</h3>  <!-- «N. Заголовок» (№214) -->
          <p>{typo(s.text)}</p>
          <img class="proc__art" style={`--i:${i}`} src={u(`/images/ill/step-${i + 1}.webp`)} alt="" width="480" height="480" loading="lazy" decoding="async" />
        </li>
      ))}
    </ol>

    <p class="proc__note">{typo(proc.footnote)}</p>
    <!-- кнопка под шагами, а не рядом с заголовком (как в «Типичных ситуациях», №33) -->
    <a class="btn proc__cta" href="#zayavka">{typo(proc.cta)}</a>
  </div>
</section>

<!-- №268: гарантия — отдельная полоса во всю ширину страницы, тёмно-синяя, с появлением при прокрутке -->
<section class="proc__guarantee" data-reveal aria-labelledby="guar-title">
  <div class="proc__guar-in">
    <span class="proc__shield"><OfficeIcon name="shield" /></span>
    <h2 id="guar-title">{typo(proc.guarantee.title)}</h2>
    <p>{typo(proc.guarantee.text)}</p>
  </div>
</section>

<style>
  .proc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--head-gap);
  }
  .proc__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .proc__grid li {
    display: grid;
    gap: var(--card-in);
    grid-template-rows: auto auto 1fr;  /* картинка прижата к низу плашки */
    padding: var(--card-pad);
    border-radius: var(--r-xl);
    background: var(--c-night);
    color: var(--c-white);
  }
  .proc__grid h3, .proc__grid p { color: var(--c-white); }
  .proc__grid p { opacity: 1; line-height: 1.35; }  /* плотнее (№301) */
  .proc__art { display: block; width: 78%; max-width: 200px; height: auto; margin: 8px auto -6px; align-self: end;
    /* картинка на своём тёмном фоне (почти цвет плашки), края мягко гаснут — без вырезки (№257) */
    -webkit-mask-image: radial-gradient(closest-side, #000 72%, transparent); mask-image: radial-gradient(closest-side, #000 72%, transparent); }
  /* №280: акцент свода движения — картинки шагов медленно «дышат», по очереди */
  @media (prefers-reduced-motion: no-preference) {
    .proc__art { animation: proc-float 4.8s ease-in-out infinite alternate; animation-delay: calc(var(--i, 0) * -0.9s); }
  }
  @keyframes proc-float { from { transform: translateY(0) rotate(-1.2deg); } to { transform: translateY(-9px) rotate(1.2deg); } }
  /* номер шага — цифрой прямо в заголовке, без слова «Шаг» (правка №128) */
  /* стрелки на стыке карточек сняты (№264; были с №187) */
  .proc__grid h3 { font-size: var(--fs-h6); font-weight: var(--w-display-sm); line-height: var(--lh-h6); letter-spacing: var(--tr-h6); }
  /* гарантия — крупный текст без плашки, со щитом (№28; щит снимали в №46, вернули в №60, перерисован в стиле знаков услуг — №79) */
  /* №268: полоса во всю ширину страницы, тёмно-синяя (--c-night, как шаги), отступы умеренные */
  /* плашкой, как первый экран главной: поле от краёв экрана и скругление (№269) */
  /* №300: крупнее и выше — больше фона, заголовок как H1 */
  .proc__guarantee { margin: var(--block-gap) var(--hero-frame) 0; padding: clamp(56px, 6vw, 88px) var(--gutter); border-radius: var(--r-lg); background: var(--c-night); color: var(--c-white); }
  .proc__guar-in { display: grid; justify-items: center; gap: clamp(16px, 2vw, 24px); max-width: 900px; margin-inline: auto; text-align: center; }  /* по центру (№235) */
  .proc__shield { display: block; width: clamp(56px, 5vw, 72px); color: var(--c-white); --icon-bg: var(--c-night); }
  .proc__guarantee h2 { color: var(--c-white); font-size: var(--fs-h1); font-weight: var(--w-display); line-height: var(--lh-h1); letter-spacing: var(--tr-h1); max-width: 22ch; }
  .proc__guarantee p { color: var(--c-white); font-size: var(--fs-h5); line-height: 1.45; max-width: 52ch; }
  /* появление при прокрутке: полоса проявляется, щит «впрыгивает», заголовок и текст — следом.
     Без JS и при «меньше движения» — сразу видно (скрипт в Base.astro ставит .is-in) */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .proc__guarantee { transition: background-color .8s ease; }
    .proc__guar-in > * { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
    .proc__guarantee .proc__shield { transform: scale(.4) rotate(-12deg); transition: opacity .5s ease .1s, transform .7s cubic-bezier(.3, 1.6, .5, 1) .1s; }
    .proc__guarantee h2 { transition-delay: .3s; }
    .proc__guarantee p { transition-delay: .45s; }
    .proc__guarantee:global(.is-in) .proc__guar-in > * { opacity: 1; transform: none; }
  }
  .proc__note { margin-top: 12px; max-width: var(--measure-text); font-size: var(--fs-body); line-height: 1.4; }  /* обычный кегль, прижата к карточкам (№158) */  /* плотнее (правка №58) */
  .proc__cta { margin-top: 20px; }
  /* телефон — шаги лентой с горизонтальной прокруткой, уходят за край экрана (правка №29) */
  @media (max-width: 760px) {
    .proc__grid {
      --edge: calc(var(--hero-frame) + var(--gutter));
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(-1 * var(--edge)); padding-inline: var(--hero-frame); scroll-padding-inline: var(--hero-frame);  /* узко от экрана (№149) */
    }
    .proc__grid::-webkit-scrollbar { display: none; }
    .proc__grid li { flex: 0 0 78%; scroll-snap-align: start; }
  }
  @media (max-width: 1100px) { .proc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .proc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
