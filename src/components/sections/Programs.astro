---
import { support } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Строка логотипов программ, в которых ведётся учёт (правки №152, №153). Логотипы — официальные,
   с сайтов 1С, Контура и Saby (бывш. СБИС); крупно, без плашек и подписей. */
---

<div class="prog">
  <ul class="prog__row">
    {support.programs.map((p) => (
      <li class={p.wide ? 'prog__wide' : ''}><img src={u(p.logo)} alt={p.name} style={`--h:${p.h}`} loading="lazy" decoding="async" /></li>
    ))}
  </ul>
  <!-- подпись — Manrope, под логотипами, не заголовком (№188) -->
  <p class="prog__title">{typo(support.programsTitle)}</p>
</div>

<style>
  /* логотипы крупно, без плашек и подписей — как ряд партнёров на сайте КТМ (правки №153, №154):
     высота у каждого своя (--h), чтобы на глаз были одного веса; длинные «Контур» на телефоне
     занимают строку целиком */
  .prog { display: grid; gap: 16px; }
  .prog__title { font-size: var(--fs-body); font-weight: var(--w-semibold); line-height: 1.4; }
  /* компьютер: 4 одинаковые ячейки, логотип вписан в ячейку — один оптический вес (№160) */
  /* компьютер: логотипы вплотную друг к другу, по ширине своих картинок (№236) */
  .prog__row { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(16px, 1.6vw, 24px); }
  .prog__row li { display: grid; place-items: center start; height: 80px; flex: none; }
  .prog__row img { display: block; width: auto; max-height: 100%; height: calc(var(--h) * 0.72px); }
  /* телефон — крупные логотипы лентой с горизонтальной прокруткой, узкий край и зазор (№155) */
  @media (max-width: 760px) {
    .prog__row {
      display: flex; flex-wrap: nowrap; justify-content: flex-start; gap: 28px;
      overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter)); padding: 4px calc(var(--hero-frame) + 10px);
      scroll-padding-inline: calc(var(--hero-frame) + 10px);
    }
    .prog__row::-webkit-scrollbar { display: none; }
    /* белый градиент справа — видно, что ленту можно листать (№219) */
    .prog__row { -webkit-mask: linear-gradient(90deg, #000 78%, transparent); mask: linear-gradient(90deg, #000 78%, transparent); }
    .prog__row li { flex: none; height: auto; scroll-snap-align: start; }
    .prog__row img { height: calc(var(--h) * 0.72px); max-width: none; }  /* как на компьютере — не на весь экран (№205) */
  }
</style>
