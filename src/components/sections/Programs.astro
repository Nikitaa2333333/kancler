---
import { support } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Строка логотипов программ, в которых ведётся учёт (правки №152, №153). Логотипы — официальные,
   с сайтов 1С, Контура и Saby (бывш. СБИС); крупно, без плашек и подписей. */
---

<div class="prog">
  <h3 class="prog__title">{typo(support.programsTitle)}</h3>
  <ul class="prog__row">
    {support.programs.map((p) => (
      <li><img src={u(p.logo)} alt={p.name} style={`--h:${p.h}`} loading="lazy" decoding="async" /></li>
    ))}
  </ul>
</div>

<style>
  /* логотипы крупно, без плашек и подписей — как ряд партнёров на сайте КТМ (правка №153) */
  .prog { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .prog__title { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }
  .prog__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: clamp(28px, 4vw, 64px) clamp(36px, 5vw, 80px); }
  .prog__row img { display: block; width: auto; height: calc(var(--h) * 1.9px); max-width: 100%; }
  @media (max-width: 760px) {
    .prog__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); justify-items: start; gap: 32px 24px; }
    .prog__row img { height: calc(var(--h) * 1.25px); }
  }
</style>
