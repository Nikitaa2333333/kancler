---
import { request } from '../../data/home';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';

/* topic — тема обращения страницы (из файлов клиента), уходит в заявку скрытым полем */
interface Props { topic?: string }
const { topic = 'Главная' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || '';
---

<!-- Форма как на сайте КТМ (правка №5, 28.10): слева подводка и контакты, справа крупные
     белые поля прямо на плашке и большая круглая кнопка (без карточки-в-плашке, №15). -->
<section class="sec sec--flush-top req" id="zayavka" aria-labelledby="req-title">
  <div class="wrap">
    <div class="req__band">
      <div class="req__info">
        <h2 id="req-title">{typo(request.title)}</h2>
        <p class="req__lead">{typo(request.lead)}</p>
        <p class="req__note">{typo(request.note)}</p>
        <div class="req__contacts">
          {company.phone && <a class="req__big" href={`tel:${company.phoneHref}`}>{company.phone}</a>}
          <a class="req__mail" href={`mailto:${company.leadEmail}`}>{company.leadEmail}</a>
          <p>{typo(`${company.hours}, ${company.region}`)}</p>
          <p>{typo(company.remote)}</p>
        </div>
      </div>

      <form class="req__form" data-form data-endpoint={endpoint} novalidate>
        <label class="req__field">
          <span class="sr-only">{request.fields.name}</span>
          <input type="text" name="name" autocomplete="name" placeholder="Ваше имя" required />
        </label>
        <label class="req__field">
          <span class="sr-only">{request.fields.phone}</span>
          <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="Телефон, +7" required />
        </label>
        <label class="req__field">
          <span class="sr-only">{request.fields.comment}</span>
          <textarea name="comment" rows="3" placeholder="Коротко о задаче"></textarea>
        </label>
        <input type="hidden" name="topic" value={topic} />
        <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn req__submit" type="submit">{request.submit}</button>
        <label class="req__consent">
          <input type="checkbox" name="consent" required />
          <span>{typo(request.consent)}</span>
        </label>
        {(company.telegram || company.whatsapp) && (
          <div class="req__alt">
            {company.telegram && <a class="btn btn--light" href={company.telegram} rel="noopener">Telegram</a>}
            {company.whatsapp && <a class="btn btn--light" href={company.whatsapp} rel="noopener">WhatsApp</a>}
          </div>
        )}
        <p class="req__status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('website')) return;
      const name = String(data.get('name') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      if (!name || phone.replace(/\D/g, '').length < 10) { status.textContent = 'Укажите имя и телефон.'; return; }
      if (!data.get('consent')) { status.textContent = 'Нужно согласие на обработку персональных данных.'; return; }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) { status.textContent = 'Приём заявок пока не подключён.'; return; }
      btn.disabled = true;
      status.textContent = 'Отправляем…';
      try {
        await fetch(endpoint, {
          method: 'POST', mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ name, phone, comment: String(data.get('comment') || '').trim(), topic: String(data.get('topic') || ''), page: location.href }),
        });
        form.reset();
        status.textContent = 'Заявка отправлена. Мы свяжемся с вами.';
      } catch {
        status.textContent = 'Не получилось отправить. Попробуйте ещё раз.';
      } finally { btn.disabled = false; }
    });
  }
</script>

<style>
  /* поверх последнего прилипшего блока — свой непрозрачный фон */
  .req { position: relative; z-index: 1; background: var(--c-paper); margin-top: var(--block-gap); }
  .req__band {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding: clamp(28px, 5vw, 72px);
    border-radius: var(--r-lg);
    background: var(--c-tint);
  }
  .req__info { display: grid; gap: 16px; align-content: start; }
  .req__info h2 { max-width: 14ch; }
  .req__lead { font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 40ch; }
  .req__note { max-width: 40ch; }
  .req__contacts { display: grid; gap: 6px; justify-items: start; margin-top: 12px; padding-top: 20px; border-top: 1px solid var(--line-subtle); }
  .req__big, .req__mail { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h4); letter-spacing: var(--tr-h4); color: var(--c-primary); }
  /* поля прямо на синей плашке — без внутренней карточки и без теней (правка №15, 28.10) */
  .req__form { display: grid; gap: 12px; }
  .req__field input,
  .req__field textarea {
    width: 100%;
    min-height: 58px;
    padding: 16px 20px;
    border: 1.5px solid transparent;
    border-radius: 18px;
    background: var(--c-white-card);
    font-size: 17px;
    font-weight: var(--w-body);
    box-shadow: inset 0 0 0 1px var(--line-faint);
    transition: border-color .2s, box-shadow .2s;
  }
  .req__field textarea { min-height: 112px; resize: vertical; }
  .req__field input::placeholder, .req__field textarea::placeholder { color: rgb(43 40 51 / 0.5); }
  .req__field input:focus,
  .req__field textarea:focus { outline: none; border-color: var(--c-primary); box-shadow: 0 0 0 4px rgb(47 74 127 / 0.12); }
  .req__submit {
    min-height: 60px;
    margin-top: 6px;
    border-radius: 999px;
    font-size: 18px;
    transition: background-color .2s, transform .15s;
  }
  .req__submit:hover { transform: translateY(-1px); }
  .req__submit:active { transform: translateY(1px); }
  .req__consent { display: flex; align-items: flex-start; gap: 10px; font-size: var(--fs-small); }
  .req__consent input { flex: none; width: 18px; height: 18px; margin-top: 2px; accent-color: var(--c-primary); }
  .req__alt { display: flex; flex-wrap: wrap; gap: 10px; }
  .req__status { min-height: 1.5em; font-size: var(--fs-small); font-weight: var(--w-medium); }
  @media (max-width: 860px) { .req__band { grid-template-columns: minmax(0, 1fr); padding: 28px 16px 20px; } }
</style>
