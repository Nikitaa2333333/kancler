---
import { request } from '../../data/home';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';

const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || '';
---

<section class="sec sec--flush-top req" id="zayavka" aria-labelledby="req-title">
  <div class="wrap">
    <div class="req__band">
      <div class="req__center">
        <h2 id="req-title">{typo(request.title)}</h2>

        <form class="req__form" data-form data-endpoint={endpoint} novalidate>
          <label class="req__field">
            <span>{request.fields.name}</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label class="req__field">
            <span>{request.fields.phone}</span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+7" required />
          </label>
          <label class="req__field req__field--wide">
            <span>{request.fields.comment}</span>
            <textarea name="comment" rows="3"></textarea>
          </label>
          <label class="req__consent req__field--wide">
            <input type="checkbox" name="consent" required />
            <span>{typo(request.consent)}</span>
          </label>
          <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="req__submit req__field--wide">
            <button class="btn" type="submit">{request.submit}</button>
            {company.telegram && <a class="btn btn--soft" href={company.telegram} rel="noopener">Telegram</a>}
            {company.whatsapp && <a class="btn btn--soft" href={company.whatsapp} rel="noopener">WhatsApp</a>}
          </div>
          <p class="req__status req__field--wide" data-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('website')) return;
      const name = String(data.get('name') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      if (!name || phone.replace(/\D/g, '').length < 10) { status.textContent = 'Укажите имя и телефон.'; return; }
      if (!data.get('consent')) { status.textContent = 'Нужно согласие на обработку персональных данных.'; return; }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) { status.textContent = 'Приём заявок пока не подключён.'; return; }
      btn.disabled = true;
      status.textContent = 'Отправляем…';
      try {
        await fetch(endpoint, {
          method: 'POST', mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ name, phone, comment: String(data.get('comment') || '').trim(), page: location.href }),
        });
        form.reset();
        status.textContent = 'Заявка отправлена. Мы свяжемся с вами.';
      } catch {
        status.textContent = 'Не получилось отправить. Попробуйте ещё раз.';
      } finally { btn.disabled = false; }
    });
  }
</script>

<style>
  /* поверх последнего прилипшего блока — свой непрозрачный фон */
  .req { position: relative; z-index: 1; background: var(--c-paper); margin-top: var(--block-gap); }
  .req__band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(40px, 7vw, 104px) clamp(16px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: var(--c-purple-soft);
  }
  .req__center { width: min(100%, 680px); display: grid; justify-items: center; gap: clamp(24px, 3vw, 40px); }
  .req__center h2 { text-align: center; max-width: 20ch; }
  .req__form {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--r-lg);
    background: var(--c-paper);
  }
  .req__field { display: grid; gap: 6px; font-weight: var(--w-medium); }
  .req__field--wide { grid-column: 1 / -1; }
  .req__field input,
  .req__field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    background: var(--c-depth);
    font-weight: var(--w-body);
  }
  .req__field input:focus,
  .req__field textarea:focus { border-color: var(--c-ink); outline: none; }
  .req__consent { display: flex; align-items: flex-start; gap: 10px; font-size: var(--fs-small); }
  .req__consent input { margin-top: 3px; accent-color: var(--c-ink); }
  .req__submit { display: flex; flex-wrap: wrap; gap: 10px; }
  .req__status { min-height: 1.5em; font-size: var(--fs-small); font-weight: var(--w-medium); }
  @media (max-width: 560px) { .req__form { grid-template-columns: minmax(0, 1fr); } }
</style>
