---
import { services } from '../../data/home';
import OfficeIcon from '../OfficeIcon.astro';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* у каждой услуги свой цвет плашки (правка №39, 30.10); чертежи сняты (№50) */
const tones = ['blue', 'sand', 'sky'];
---

<!-- Главный блок сайта (правки №32, №39): заголовок прямо на фоне страницы; три услуги —
     крупные плашки разного цвета, кнопка прижата к низу. -->
<section class="sec svc" id="uslugi" aria-labelledby="svc-title">
  <div class="wrap">
    <h2 id="svc-title">{typo(services.title)}</h2>

    <div class="svc__grid bleed">
      {services.cards.map((c, i) => (
        <article class={`svc__card svc__card--${tones[i % 3]}`}>
          <h3>{typo(c.title)}</h3>
          <p class="svc__text">{typo(c.text)}</p>
          <ul class="svc__list" data-reveal>
            {c.items.map((it, k) => <li style={`--i:${k}`} data-reveal><span class="svc__ico"><OfficeIcon name={c.icons[k]} /></span><span>{typo(it)}</span></li>)}
          </ul>
          <a class="btn" href={u(c.href)}>{services.more}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* соседи — блоки со своими полями, поэтому свой отступ почти нулевой: без дыры над
     заголовком и под плашками (правки №52, №75) */
  .svc { padding-block: var(--block-gap); margin-inline: var(--hero-frame); }  /* та же линия, что у остальных секций (№157) */
  .svc h2 { margin-bottom: var(--head-gap); max-width: 20ch; font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--tr-h1); }
  .svc__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  .svc__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    /* высота по содержимому, без пустоты над кнопкой (№167) */
    padding: var(--card-pad);
    border-radius: var(--r-xl);
    background: var(--tone);
  }  /* наведение — по своду движения в global.css (№280) */
  .svc__card--blue { --tone: var(--c-tone-blue); }
  .svc__card--sand { --tone: var(--c-tone-sand); }
  .svc__card--sky { --tone: var(--c-tone-sky); }
  .svc__card h3 { font-size: var(--fs-h3); font-weight: var(--w-display); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); }
  @media (max-width: 760px) { .svc { margin-inline: 0; } }  /* край на телефоне — как у всех плашек, 6 px (№206) */
  .svc__card h3 + .svc__text { margin-top: calc(var(--card-in) - 20px); }  /* заголовок → текст ближе, чем поле (№206) */
  .svc__text { font-size: var(--fs-lead); line-height: 1.45; }
  /* пункты без тире: знак + текст, тонкие линии между строками, крупно и плотно (№56) */
  .svc__list { align-self: stretch; display: grid; }
  .svc__list li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 14px; align-items: center; padding: 12px 0; font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.3; }
  .svc__list li + li { border-top: 1px solid var(--line-subtle); }  /* линии только между пунктами (правка №87) */
  .svc__ico { color: var(--c-heading); --icon-bg: var(--tone); }
  .svc__card .btn { margin-top: auto; }
  /* телефон: плашки услуг до края экрана, как остальные (№190) */
  @media (max-width: 1100px) {
    .svc__grid { grid-template-columns: minmax(0, 1fr); }
    .svc__card { min-height: 0; }
    .svc__card .btn { margin-top: 8px; }
    .svc__text { max-width: 46ch; }
  }
  /* №307, №309: пункты «что входит» появляются при прокрутке. Компьютер — весь список по очереди,
     строка выезжает слева. Телефон — каждый пункт сам, когда до него дошла прокрутка, плавно снизу
     вверх, без задержек (читать по мере листания). При «меньше движения» — сразу */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) and (min-width: 761px) {
    .svc__list li { opacity: 0; transform: translateX(-14px); transition: opacity .5s ease, transform .55s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i, 0) * .14s + .1s); }
    .svc__list .svc__ico { display: inline-block; transform: scale(.4); transition: transform .6s cubic-bezier(.3, 1.6, .5, 1); transition-delay: calc(var(--i, 0) * .14s + .2s); }
    .svc__list:global(.is-in) li { opacity: 1; transform: none; }
    .svc__list:global(.is-in) .svc__ico { transform: none; }
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) and (max-width: 760px) {
    .svc__list li { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
    .svc__list li:global(.is-in) { opacity: 1; transform: none; }
  }
</style>
