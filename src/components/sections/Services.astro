---
import { services } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
import Shapes from '../Shapes.astro';

const kinds = ['ledger', 'chart'] as const;
---

<!-- Главный блок (23.10.2026): две крупные карточки, у каждой свой тонкий чертёж в стиле
     «Для кого». Первая — светлая, вторая — тёмно-синяя: две услуги читаются как пара. -->
<section class="sec sec--block sec--stack svc" id="uslugi" aria-labelledby="svc-title">
  <div class="wrap">
    <h2 id="svc-title">{typo(services.title)}</h2>

    <div class="svc__grid">
      {services.cards.map((c, i) => (
        <article class={`svc__card ${i === 1 ? 'svc__card--dark' : ''}`}>
          <div class="svc__body">
            <h3>{typo(c.title)}</h3>
            <p class="svc__text">{typo(c.text)}</p>
            <ul class="list svc__list">
              {c.items.map((it) => <li>{typo(it)}</li>)}
            </ul>
            <a class={`btn ${i === 1 ? 'btn--light' : ''}`} href={u(c.href)}>{services.more}</a>
          </div>
          <div class="svc__art"><Shapes kind={kinds[i]} /></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .svc h2 { margin-bottom: var(--head-gap); }
  .svc__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .svc__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(16px, 2vw, 28px);
    min-height: clamp(380px, 32vw, 460px);
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--card-bg, var(--c-white-card)) 45%, rgb(201 216 204 / 0.35) 100%);
  }
  .svc__body { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .svc__card h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); }
  .svc__text { max-width: 34ch; font-size: var(--fs-lead); line-height: 1.4; }
  .svc__list { margin-bottom: 8px; }
  .svc__list li::before { background: var(--c-sage); }
  .svc__card .btn { margin-top: auto; }
  .svc__art { display: grid; align-items: end; justify-items: center; }
  .svc__art :global(.shape) { max-width: 230px; }

  .svc__card--dark { background: linear-gradient(180deg, var(--c-ink) 45%, #143f4e 100%); color: var(--c-white); }
  .svc__card--dark h3, .svc__card--dark .svc__text, .svc__card--dark .svc__list { color: var(--c-white); }
  .svc__card--dark .svc__list li::before { background: var(--c-sage-soft); }
  /* на тёмной карточке основные линии чертежа — белые */
  .svc__card--dark .svc__art :global(.shape) { stroke: var(--c-white); }

  @media (max-width: 1100px) { .svc__card { grid-template-columns: minmax(0, 1fr); } .svc__art :global(.shape) { max-width: 200px; } }
  @media (max-width: 860px) { .svc__grid { grid-template-columns: minmax(0, 1fr); } .svc__card { min-height: 0; } }
</style>
