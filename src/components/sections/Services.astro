---
import { services } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
import Shapes from '../Shapes.astro';

const kinds = ['ledger', 'chart', 'contracts'] as const;
---

<!-- Главный блок (23.10.2026): две крупные карточки, у каждой свой тонкий чертёж в стиле
     «Для кого». Первая — светлая, вторая — тёмно-синяя: две услуги читаются как пара. -->
<section class="sec sec--block svc" id="uslugi" aria-labelledby="svc-title">
  <div class="wrap">
    <h2 id="svc-title">{typo(services.title)}</h2>

    <div class="svc__grid">
      {services.cards.map((c, i) => (
        <article class={`svc__card ${i === 1 ? 'svc__card--dark' : ''} ${i === 2 ? 'svc__card--wide' : ''}`}>
          <div class="svc__body">
            <h3>{typo(c.title)}</h3>
            <p class="svc__text">{typo(c.text)}</p>
            <ul class="list svc__list">
              {c.items.map((it) => <li>{typo(it)}</li>)}
            </ul>
            <a class="btn" href={u(c.href)}>{services.more}</a>
          </div>
          <div class="svc__art"><Shapes kind={kinds[i]} /></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .svc h2 { margin-bottom: var(--head-gap); }
  .svc__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  /* Чертёж — в правом нижнем углу поверх карточки, высоту карточки задаёт текст
     (решение 23.10.2026: «плашки не должны растягиваться») */
  .svc__card {
    position: relative;
    overflow: hidden;
    padding: clamp(24px, 3vw, 40px);
    padding-right: clamp(190px, 21vw, 290px);
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white-card));
  }
  .svc__body { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .svc__card h3 { margin-bottom: 4px; font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); }
  .svc__text { max-width: 34ch; font-size: var(--fs-lead); line-height: 1.4; }
  .svc__list { margin-bottom: 8px; }
  .svc__list li::before { background: var(--c-ink); }
  .svc__card .btn { margin-top: 8px; }
  .svc__art { position: absolute; right: clamp(-8px, 0vw, 0px); bottom: clamp(-12px, -0.5vw, -4px); width: clamp(200px, 22vw, 300px); pointer-events: none; }

  /* вторая карточка — светло-зелёная подложка */
  .svc__card--dark { background: var(--c-tint); }
  /* третья карточка (казначейство) — во всю ширину под парой, пункты в две колонки */
  .svc__card--wide { grid-column: 1 / -1; }
  .svc__card--wide .svc__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  @media (max-width: 760px) { .svc__card--wide .svc__list { grid-template-columns: minmax(0, 1fr); } }

  @media (max-width: 560px) { .svc__card { padding-right: clamp(24px, 3vw, 40px); padding-bottom: 190px; } .svc__art { width: 190px; } }
  @media (max-width: 860px) { .svc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
