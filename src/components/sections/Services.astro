---
import { services } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';
---

<section class="sec sec--roomy svc on-dark" id="uslugi" aria-labelledby="svc-title">
  <div class="wrap">
    <h2 id="svc-title">{typo(services.title)}</h2>

    <div class="svc__grid">
      {services.cards.map((c) => (
        <article class="svc__card">
          <h3>{typo(c.title)}</h3>
          <p class="svc__text">{typo(c.text)}</p>
          <ul class="list svc__list">
            {c.items.map((it) => <li>{typo(it)}</li>)}
          </ul>
          <a class="btn btn--light" href={u(c.href)}>{services.more}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .svc { background: var(--c-ink); color: var(--c-white); }
  .svc h2 { color: var(--c-white); margin-bottom: var(--head-gap); }
  .svc__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--card-gap);
  }
  .svc__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--glass-line);
    border-radius: var(--r-lg);
    background: var(--glass);
  }
  .svc__card h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); color: var(--c-white); }
  .svc__text { max-width: 40ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--c-white); }
  .svc__list { margin-bottom: 8px; color: var(--c-white); }
  .svc__list li::before { background: var(--c-blue); }
  .svc__card .btn { margin-top: auto; }
  @media (max-width: 860px) { .svc__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
