---
import { services } from '../../data/home';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

---

<!-- Главный блок сайта (правка №32, 30.10): заголовок прямо на фоне страницы, без плашки;
     три услуги — крупными плашками в ряд, без разделительных линий; кнопка прижата к тексту. -->
<section class="sec svc" id="uslugi" aria-labelledby="svc-title">
  <div class="wrap">
    <h2 id="svc-title">{typo(services.title)}</h2>

    <div class="svc__grid">
      {services.cards.map((c) => (
        <article class="svc__card">
          <div class="svc__body">
            <h3>{typo(c.title)}</h3>
            <p class="svc__text">{typo(c.text)}</p>
            <ul class="list svc__list">
              {c.items.map((it) => <li>{typo(it)}</li>)}
            </ul>
            <a class="btn" href={u(c.href)}>{services.more}</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .svc h2 { margin-bottom: var(--head-gap); max-width: 20ch; font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--tr-h1); }
  .svc__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  .svc__card {
    display: flex;
    padding: clamp(24px, 2.8vw, 40px);
    border-radius: var(--r-lg);
    background: var(--c-band);
    transition: background-color .25s;
  }
  .svc__card:hover { background: var(--c-tint); }
  .svc__body { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .svc__card h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); }
  .svc__text { font-size: var(--fs-lead); line-height: 1.4; }
  .svc__list li::before { background: var(--c-ink); }
  .svc__card .btn { margin-top: 8px; }
  @media (max-width: 1100px) { .svc__grid { grid-template-columns: minmax(0, 1fr); } .svc__text { max-width: 46ch; } }
</style>
