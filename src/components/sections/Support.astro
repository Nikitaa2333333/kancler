---
import { support } from '../../data/home';
import Sec from '../page/Sec.astro';
import IconList from '../page/IconList.astro';
import Programs from './Programs.astro';
/* «Параметры сопровождения» и программы — ответы клиента в доке «Структура главной» (№152) */
---

<Sec id="soprovozhdenie" title={support.title} lead={support.lead}>
  <div class="sup">
    <IconList items={support.items} />
    <Programs />
  </div>
</Sec>

<style>
  .sup { display: grid; gap: clamp(32px, 4vw, 56px); }
  /* 9 пунктов — сетка 3×3, строки выровнены, зазоры общие (№160) */
  .sup :global(.ilist) { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: none; gap: 20px clamp(24px, 3vw, 40px); }
  @media (max-width: 980px) { .sup :global(.ilist) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .sup :global(.ilist) { grid-template-columns: minmax(0, 1fr); } }
</style>
