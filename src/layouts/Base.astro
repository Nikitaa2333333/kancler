---
import '@fontsource-variable/lora';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { INDEXING } from '../lib/seo';
import { u } from '../lib/url';
import { company } from '../data/company';

interface Props {
  title: string;
  description: string;
  /* черновые страницы-варианты закрыты от индексации всегда, даже после запуска */
  noindex?: boolean;
  /* класс темы на <body>: страница-вариант подключает свой файл темы и ставит его класс */
  theme?: string;
}
const { title, description, noindex = false, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const metrika = import.meta.env.PUBLIC_METRIKA_ID;
/* schema.org: организация на каждой странице (05.11.2026). Из company.ts; пустые поля не выводим. */
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: company.name,
  description: 'Бухгалтерский и управленческий учёт для строительных компаний Москвы и Московской области',
  url: home,
  telephone: company.phoneHref || undefined,
  email: company.leadEmail || undefined,
  foundingDate: String(company.since),
  areaServed: [{ '@type': 'City', name: 'Москва' }, { '@type': 'AdministrativeArea', name: 'Московская область' }],
  priceRange: 'от 18 000 ₽',
};
---

<!doctype html>
<html lang="ru" data-metrika={metrika || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!INDEXING || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- обложка для превью ссылок в мессенджерах — кадр первого экрана (05.11.2026) -->
    <meta property="og:image" content={new URL(u('/og.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Канцлер" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- фавикон: белая «К» антиквой на синем (05.11.2026); ico и png — для Яндекса и старых браузеров -->
    <link rel="icon" href={u('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="manifest" href={u('/site.webmanifest')} />
    <meta name="theme-color" content="#141414" />
    {!theme && <script type="application/ld+json" set:html={JSON.stringify(org)} />}
    {metrika && (
      <!-- код счётчика — как выдаёт Метрика (05.11.2026), номер из PUBLIC_METRIKA_ID -->
      <script is:inline define:vars={{ metrika }}>
        (function(m,e,t,r,i,k,a){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=' + metrika, 'ym');
        ym(Number(metrika), 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
      </script>
    )}
  </head>
  <body class={theme}>
    {metrika && <noscript><div><img src={`https://mc.yandex.ru/watch/${metrika}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>}
    <slot />
    <script>
      // .sec--stack: блок прилипает, только когда показан до конца (высокий не прячется)
      const blocks = [...document.querySelectorAll<HTMLElement>('.sec--stack')];
      const setTops = () => {
        const hdr = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')) || 60;
        for (const b of blocks) b.style.setProperty('--stick-top', `${Math.min(hdr + 12, innerHeight - b.offsetHeight)}px`);
      };
      setTops();
      addEventListener('resize', setTops);
      addEventListener('load', setTops);

      // [data-reveal]: графики и маркеры кейсов запускают анимацию, когда видны
      const rv = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        rv.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { threshold: 0.35 });
        rv.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
