---
import '@fontsource-variable/lora';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { INDEXING } from '../lib/seo';
import { u } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /* черновые страницы-варианты закрыты от индексации всегда, даже после запуска */
  noindex?: boolean;
  /* класс темы на <body>: страница-вариант подключает свой файл темы и ставит его класс */
  theme?: string;
}
const { title, description, noindex = false, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const metrika = import.meta.env.PUBLIC_METRIKA_ID;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!INDEXING || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#2b2833" />
    {metrika && (
      <script is:inline define:vars={{ metrika }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
        ym(Number(metrika),'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
      </script>
    )}
  </head>
  <body class={theme}>
    <slot />
    <script>
      // .sec--stack: блок прилипает, только когда показан до конца (высокий не прячется)
      const blocks = [...document.querySelectorAll<HTMLElement>('.sec--stack')];
      const setTops = () => {
        const hdr = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')) || 60;
        for (const b of blocks) b.style.setProperty('--stick-top', `${Math.min(hdr + 12, innerHeight - b.offsetHeight)}px`);
      };
      setTops();
      addEventListener('resize', setTops);
      addEventListener('load', setTops);

      // [data-reveal]: графики и маркеры кейсов запускают анимацию, когда видны
      const rv = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        rv.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }), { threshold: 0.35 });
        rv.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
