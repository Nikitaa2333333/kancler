---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import PriceTable from '../../components/page/PriceTable.astro';
import Faq from '../../components/page/Faq.astro';
import FactorGrid from '../../components/page/FactorGrid.astro';
import IconNote from '../../components/page/IconNote.astro';
import Receipt from '../../components/page/Receipt.astro';
import OfficeIcon from '../../components/OfficeIcon.astro';
import CaseCards from '../../components/page/CaseCards.astro';
import Support from '../../components/sections/Support.astro';
import Process from '../../components/sections/Process.astro';
import Request from '../../components/sections/Request.astro';
import { buh } from '../../data/buh';
import { cases } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Порядок блоков — как в файле клиента (8 блоков + форма). Блок 4 «Как начинаем работу» —
   «дублируем квадратиками с первой страницы»: тот же компонент, что на главной. */
/* доп. услуги (№88): короткая единица («1 час») — в строку цены через «/»; цена «без НДС…, с НДС…» —
   две колонки */
const more = buh.more.items.map((it) => ({ it, short: !!it.unit && it.unit.length < 13, parts: it.price.split(/,\s(?=с НДС)/) }));
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const related = cases.filter((c) => c.slug === 'vozvrat-46-mln');
---

<Base title={buh.seo.title} description={buh.seo.description}>
  <Header />
  <main>
    <PageHero
      tone="blue"
      title={buh.hero.title}
      lead={buh.hero.lead}
      actions={[{ label: buh.hero.cta, href: '#zayavka' }, { label: 'Смотреть тарифы', href: '#tarify', light: true }]}
      /* №171: «от 18 000» — цена пакетных тарифов; на первом экране — от 2 900 ₽/мес.
         Подпись — наша, формулировку пришлёт заказчица */
      stat={{ value: 'от 2 900 ₽/мес.', label: 'ИП на УСН (без НДС)' }}  /* подпись — Ирина, 03.11.2026 */
    />

    <Sec id="cena" title={buh.price.title} white>
      <FactorGrid items={buh.price.factors} />

      <h3 class="subhead">{typo(buh.scope.title)}</h3>
      <!-- плашки с горизонтальной прокруткой (правка №94, 30.10) -->
      <ul class="scope">
        {buh.scope.items.map((it, i) => (
          <li class="scope__item">
            <span class="scope__ico"><OfficeIcon name={['doc', 'swap', 'upload', 'folder', 'briefcase'][i % 5]} /></span>
            <h4>{typo(it.title)}</h4>
            <p>{typo(it.text)}</p>
          </li>
        ))}
      </ul>
      <IconNote icon="plus">{typo(buh.scope.note)}</IconNote>
    </Sec>

    <Sec id="rezultat" title={buh.result.title} lead={buh.result.lead} center>
      <!-- №271: по центру, четыре пункта в ряд со знаком сверху, равные зазоры -->
      <ul class="checks" data-reveal>
        {buh.result.items.map((it, i) => <li style={`--i:${i}`}><span class="checks__ico"><OfficeIcon name={['upload', 'folder', 'chart', 'check'][i % 4]} /></span><span>{typo(it)}</span></li>)}
      </ul>
      <!-- оговорка — не пункт списка: отдельной строкой под ним, со ссылкой (правка №93, №271) -->
      <!-- оговорка и ссылка — одной строкой (№290, просьба пользователя; ссылка после фразы, не внутри) -->
      <p class="res-note" data-design-ok>{typo(buh.result.note)} <a class="mlink" href={u(buh.result.noteLink.href)}>{typo(buh.result.noteLink.label)}</a></p>
    </Sec>

    <Support />

    <Process />

    <Sec id="tarify" title={buh.tariffs.title} white>
      <!-- тарифы — карточки (№68). №91: подписи «Для кого / Объём» не повторяем в каждой
           карточке: под названием — для кого, ниже — объём строками, цена — внизу карточки -->
      <!-- №203: переключатель-пилюля, как тарифы у Яндекса 360. Без JS видно всё подряд -->
      <div class="tabs" role="tablist" aria-label="Цены" data-pill>
        <button type="button" role="tab" aria-selected="true" data-tab="t0">Базовые тарифы</button>
        <button type="button" role="tab" aria-selected="false" data-tab="t1">{typo(buh.extra.title)}</button>
        <button type="button" role="tab" aria-selected="false" data-tab="t2">{typo(buh.payroll.title)}</button>
        <button type="button" role="tab" aria-selected="false" data-tab="t3">{typo(buh.control.title)}</button>
      </div>
      <div class="tpanel" data-panel="t0">
      <div class="tcards bleed">
        {buh.tariffs.rows.map(([name, who, volume, price], i) => (
          <article class={`tcard ${price.startsWith('по') ? 'tcard--custom' : ''}`}>
            <span class="tcard__ico"><OfficeIcon name={['clip', 'folder', 'percent', 'split', 'star'][i % 5]} /></span>
            <h3>{typo(name.replace(/[«»]/g, ''))}</h3>
            <p class="tcard__who">{typo(who)}</p>
            <ul class="tcard__vol">
              {volume.split(', ').map((v) => <li>{typo(cap(v))}</li>)}
            </ul>
            <p class="tcard__price">{typo(price)}</p>
          </article>
        ))}
        </div>
        <ul class="notes">
        {buh.tariffs.notes.map((n) => <li>{typo(n)}</li>)}
        </ul>

      </div>
      <div class="tpanel" data-panel="t1"><PriceTable caption={buh.extra.title} head={buh.extra.head} rows={buh.extra.rows} /></div>
      <div class="tpanel" data-panel="t2">
        <PriceTable caption={buh.payroll.title} head={buh.payroll.head} rows={buh.payroll.rows} />
        <p class="notes notes--one">{typo(buh.payroll.note)}</p>
      </div>
      <div class="tpanel" data-panel="t3"><PriceTable caption={buh.control.title} head={buh.control.head} rows={buh.control.rows} /></div>
    </Sec>

    <Sec id="primer" title={buh.example.title} white center>
      <Receipt subject={buh.example.subject} params={buh.example.params} rows={buh.example.rows as [string, string][]} total={buh.example.total as [string, string]} after={buh.example.after as [string, string][]} />
    </Sec>

    <Sec id="dop" title={buh.more.title}>
      <!-- №88: плюсик, название, сразу под ним цена крупно, ещё плотнее — единица мелко;
           короткая единица — через косую черту в строке цены; «без НДС / с НДС» — две колонки -->
      <ul class="more bleed">
        {more.map(({ it, short, parts }) => (
            <li>
              <span class="more__ico"><OfficeIcon name="plus" /></span>
              <div class="more__body">
                <h3>{typo(it.title)}</h3>
                <!-- цена — якорем внизу плашки, во всех плашках ряда на одной линии (№274) -->
                <div class="more__foot">
                  {it.price && (parts.length > 1 ? (
                    <div class="more__split">{parts.map((pp) => <p class="more__price">{typo(pp)}</p>)}</div>
                  ) : (
                    <p class="more__price">{typo(it.price)}{short && <span class="more__per"> / {typo(it.unit)}</span>}</p>
                  ))}
                  {it.unit && !short && <p class="more__unit">{typo(it.unit)}</p>}
                </div>
              </div>
            </li>
        ))}
      </ul>
    </Sec>

    <Sec id="keys" title="Кейс по теме" white action={{ label: 'Все кейсы', href: u('/keysy/') }}>
      <CaseCards items={related} />
    </Sec>

    <Request topic={buh.topic} />

    <!-- частые вопросы — после формы (правка №95) -->
    <Sec id="voprosy" title={buh.faq.title} center>
      <Faq items={buh.faq.items} />
    </Sec>
  </main>
  <Crumbs items={[{ label: 'Бухгалтерский учёт' }]} />
  <Footer />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-pill]').forEach((pill) => {
    const root = pill.parentElement!;
    const tabs = [...pill.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const show = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== id; });
    };
    tabs.forEach((t) => t.addEventListener('click', () => {
      show(t.dataset.tab!);
      /* если переключатель уже прибит — вернуть к началу выбранной таблицы (№298) */
      const hdr = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--hdr-h')) || 60;
      if (pill.getBoundingClientRect().top <= hdr + 1) {
        const panel = root.querySelector<HTMLElement>(`[data-panel="${t.dataset.tab}"]`);
        if (panel) window.scrollTo({ top: panel.getBoundingClientRect().top + scrollY - hdr - pill.offsetHeight - 12, behavior: 'smooth' });
      }
    }));
    pill.classList.add('is-on');
    show('t0');
  });
</script>

<style>
  /* «Что входит в сопровождение»: подзаголовок крупно, пункты мельче и сразу под ним, без
     линий (правка №65, 30.10) */
  .subhead { margin: clamp(48px, 6vw, 80px) 0 clamp(16px, 2vw, 24px); font-size: var(--fs-h2); line-height: var(--lh-h2); letter-spacing: var(--tr-h2); }
  .scope { display: flex; gap: var(--card-gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    --edge: calc(var(--hero-frame) + max(var(--gutter), (100vw - 2 * var(--hero-frame) - var(--page-max)) / 2));
    /* --pad — первая карточка у края экрана, узко, как у «Последовательности работы» (№149) */
    --pad: var(--edge);  /* на компьютере — по линии текста; на телефоне узко (№149, №157) */
    margin-inline: calc(-1 * var(--edge)); padding: 0 var(--pad) 4px; scroll-padding-inline: var(--pad); }
  .scope::-webkit-scrollbar { display: none; }
  .scope__item { flex: 0 0 clamp(320px, 36vw, 460px); scroll-snap-align: start; display: grid; gap: 8px; align-content: start; padding: var(--card-pad); border-radius: var(--r-lg); background: var(--card-bg); }
  @media (max-width: 560px) { .scope__item { flex-basis: 86%; } }  /* на телефоне шире, без «столбика» текста (№121) */
  /* на компьютере — сеткой в линию текста, без выезда за край экрана (№162) */
  @media (min-width: 761px) {
    /* №270: без дыры — две широкие плашки сверху и три поменьше снизу (как плитки главной) */
    .scope { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding: 0; }
    .scope__item { grid-column: span 2; }
    .scope__item:nth-child(-n + 2) { grid-column: span 3; }
  }
  .scope__item h4 { font-size: var(--fs-h5); line-height: 1.2; letter-spacing: var(--tr-h5); }

  /* «Что получает заказчик»: галочка слева на уровне первой строки, текст крупный (№67) */
  /* №271: по центру — четыре пункта в ряд, знак сверху, текст под ним; зазоры одинаковые */
  .checks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px clamp(20px, 3vw, 40px); max-width: 1100px; margin-inline: auto; }
  .checks li { display: grid; justify-items: center; align-content: start; gap: 12px; text-align: center; font-size: var(--fs-lead); line-height: 1.4; }
  /* №287: блок — тёмно-синей плашкой, как «Компенсируем штраф» (--c-night), текст и знаки белые */
  :global(#rezultat) { background: var(--c-night); color: var(--c-white); padding-block: clamp(40px, 5vw, 72px); margin-bottom: var(--section-gap); }  /* следующий блок не прилипает (№289) */
  :global(#rezultat h2), :global(#rezultat .sx__lead) { color: var(--c-white); }
  :global(#rezultat) .checks__ico { color: var(--c-white); --icon-bg: var(--c-night); }
  :global(#rezultat) .res-note .mlink { color: var(--c-white); }
  :global(#rezultat) .res-note .mlink:hover { color: var(--c-tint); }
  /* №289: появление при прокрутке, как плашка гарантии — знак «впрыгивает», текст следом, пункты по очереди */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .checks li > * { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i, 0) * .12s + .2s); }
    .checks .checks__ico { transform: scale(.4) rotate(-12deg); transition: opacity .5s ease, transform .7s cubic-bezier(.3, 1.6, .5, 1); transition-delay: calc(var(--i, 0) * .12s); }
    .checks:global(.is-in) li > * { opacity: 1; transform: none; }
  }
  .checks__ico { display: block; width: 34px; color: var(--c-heading); }  /* знаки вместо галочек, синие (№179) */
  .res-note { max-width: 1200px; margin: clamp(32px, 4vw, 48px) auto 0; text-align: center; font-size: var(--fs-lead); line-height: 1.45; }
  .res-note .mlink { font-size: inherit; font-weight: inherit; white-space: nowrap; }  /* тем же кеглем и начертанием, что фраза (№299) */  /* без отступа слева — при переносе на телефоне ссылка встаёт ровно по краю (№297) */  /* текст и ссылка одного размера (№288) */
  .scope__ico { display: block; width: 30px; margin-bottom: 6px; color: var(--c-heading); --icon-bg: var(--card-bg); }

  /* тарифы: карточки одного вида — название, цена, «для кого», объём (№68) */
  .tcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: var(--card-gap); }  /* все карточки одного размера (№136) */
  .tcard__ico { display: block; width: 32px; color: var(--c-heading); --icon-bg: var(--card-bg); }  /* цветовой акцент тарифов — синие знак и цена (№179) */
  .tcard { display: flex; flex-direction: column; gap: 14px; padding: var(--card-pad); border-radius: var(--r-xl); background: var(--card-bg); }
  .tcard h3 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }
  /* «для кого» — крупно и впритык к названию (№99) */
  .tcard h3 + .tcard__who { margin-top: -6px; font-size: var(--fs-lead); font-weight: var(--w-semibold); }
  /* «Индивидуальный» — своим цветом (тон услуги), чтобы отличался (№99) */
  .tcard--custom { background: var(--c-night); color: var(--c-white); --icon-bg: var(--c-night); }  /* тёмная, чтобы отличалась (№204) */
  .tcard--custom :is(h3, p, li) { color: var(--c-white); }
  .tcard--custom .tcard__ico { color: var(--c-white); --icon-bg: var(--c-night); }
  .tcard--custom .tcard__vol li + li { border-top-color: rgb(255 255 255 / 0.25); }
  /* один кегль у «для кого» и у объёма (№91) */
  .tcard__who, .tcard__vol { line-height: 1.4; }
  .tcard__vol { display: grid; }
  .tcard__vol li { padding: 7px 0; }
  .tcard__vol li + li { border-top: 1px solid var(--line-subtle); }
  /* цена — не крупнее текста, в небольшой плашке (№100) */
  /* цена внизу карточки — просто текстом: без подложки (№124) и без жирной черты (№136) */
  .tcard__price { margin-top: auto; padding-top: 8px; font-size: var(--fs-h6); font-weight: var(--w-semibold); line-height: 1.3; }  /* цены чёрным, едино (№244) */

  .notes { display: grid; gap: 8px; margin-top: 20px; max-width: var(--measure-text); font-size: var(--fs-small); line-height: 1.4; }
  .notes--one { display: block; }
  /* пилюля-переключатель цен (№203) */
  /* №218: переключатель — явно нажимаемые кнопки во всю ширину: активная синяя, остальные
     с обводкой и реакцией на наведение */
  .tabs { display: none; gap: 8px; margin-bottom: clamp(20px, 2.4vw, 32px); }
  /* №273: пилюли по ширине текста, аккуратные, неактивные — с заливкой */
  .tabs.is-on { display: flex; flex-wrap: wrap; gap: 6px; }
  /* №298: переключатель прибит под шапкой, пока листаются тарифы этого блока */
  .tabs.is-on { position: sticky; top: var(--hdr-h); z-index: 5; padding-block: 10px; margin-top: -10px; background: var(--c-white-card); }
  .tabs button { min-height: 44px; padding: 8px 20px; border: 1.5px solid var(--c-band); border-radius: 999px; background: var(--c-band); color: var(--c-ink); font: inherit; font-size: 15px; font-weight: var(--w-semibold); line-height: 1.2; cursor: pointer; transition: border-color .2s, background-color .2s, color .2s; }
  .tabs button:hover { border-color: var(--c-primary); color: var(--c-primary); }
  .tabs button[aria-selected='true'] { border-color: var(--c-primary); background: var(--c-primary); color: var(--c-white); }
  .tpanel + .tpanel { margin-top: clamp(40px, 5vw, 64px); }
  .tabs.is-on ~ .tpanel + .tpanel { margin-top: 0; }
  /* телефон: пилюля в одну строку, листается вбок, а не столбик (№210) */
  /* телефон: лента до краёв экрана с обеих сторон, кнопки с заливкой, плотнее (№248) */
  @media (max-width: 760px) {
    .tabs.is-on { display: flex; flex-wrap: nowrap; gap: 6px; overflow-x: auto; scrollbar-width: none;
      --edge: calc(var(--hero-frame) + var(--gutter));
      margin-inline: calc(-1 * var(--edge)); padding-inline: var(--edge); scroll-padding-inline: var(--edge); }
    .tabs::-webkit-scrollbar { display: none; }
    .tabs button { flex: none; white-space: nowrap; }
  }
  .tables { display: grid; gap: clamp(48px, 6vw, 72px); margin-top: clamp(48px, 6vw, 80px); }


  /* доп. услуги — плашками, цена синим (№179) */
  .more { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  @media (min-width: 1101px) { .more { grid-template-columns: repeat(4, minmax(0, 1fr)); } }  /* 8 плашек — две ровные строки, без дыры (№274) */
  .more li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 14px; align-items: start; padding: var(--card-pad); border-radius: var(--r-lg); background: var(--card-bg); }
  .more__ico { padding-top: 0.15em; color: var(--c-heading); --icon-bg: var(--card-bg); }
  .more__body { align-self: stretch; display: flex; flex-direction: column; }
  .more__foot { margin-top: auto; padding-top: 16px; }
  .more h3 { font-family: var(--ff-body); font-weight: var(--w-semibold); font-size: var(--fs-lead); line-height: 1.35; letter-spacing: 0; }
  .more__price { margin-top: 0; font-size: var(--fs-h5); font-weight: var(--w-semibold); line-height: 1.25; }  /* чёрным (№244) */
  .more__per, .more__unit { font-size: var(--fs-small); font-weight: var(--w-body); }
  .more__unit { margin-top: 2px; }
  .more__split { display: grid; gap: 0; }  /* «без НДС / с НДС» — плотно друг под другом (№101) */
  .more__split .more__price + .more__price { margin-top: 0; }

  @media (max-width: 1100px) {
    .tcards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .checks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* телефон — по левому краю, знак слева от текста, как было (№281: центр — только для ПК) */
  @media (max-width: 760px) {
    .checks { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-inline: 0; }
    .checks li { grid-template-columns: 30px minmax(0, 1fr); justify-items: start; gap: 16px; text-align: left; }
    .checks__ico { width: 30px; padding-top: 0.1em; }
    .res-note { margin: 20px 0 0; text-align: left; }  /* без дыры после списка (№284) */
    .more { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .tcards, .more { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) { .adv__track, .scope { --pad: var(--hero-frame); } }
</style>
