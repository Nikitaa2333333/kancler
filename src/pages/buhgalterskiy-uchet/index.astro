---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import PriceTable from '../../components/page/PriceTable.astro';
import Faq from '../../components/page/Faq.astro';
import FactorGrid from '../../components/page/FactorGrid.astro';
import IconNote from '../../components/page/IconNote.astro';
import OfficeIcon from '../../components/OfficeIcon.astro';
import CaseCards from '../../components/page/CaseCards.astro';
import Process from '../../components/sections/Process.astro';
import Request from '../../components/sections/Request.astro';
import { buh } from '../../data/buh';
import { cases } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Порядок блоков — как в файле клиента (8 блоков + форма). Блок 4 «Как начинаем работу» —
   «дублируем квадратиками с первой страницы»: тот же компонент, что на главной. */
const related = cases.filter((c) => c.slug === 'vozvrat-46-mln');
---

<Base title={buh.seo.title} description={buh.seo.description}>
  <Header />
  <main>
    <PageHero
      title={buh.hero.title}
      lead={buh.hero.lead}
      actions={[{ label: buh.hero.cta, href: '#zayavka' }, { label: 'Смотреть тарифы', href: '#tarify', light: true }]}
      stat={{ value: 'от 18 000 ₽/мес.', label: 'базовый тариф «Подрядчик. УСН»' }}
    />

    <Sec id="cena" title={buh.price.title} white>
      <FactorGrid items={buh.price.factors} />

      <h3 class="subhead">{typo(buh.scope.title)}</h3>
      <div class="scope">
        {buh.scope.items.map((it) => (
          <div class="scope__item">
            <h4>{typo(it.title)}</h4>
            <p>{typo(it.text)}</p>
          </div>
        ))}
      </div>
      <IconNote icon="plus">{typo(buh.scope.note)}</IconNote>
    </Sec>

    <Sec id="rezultat" title={buh.result.title} lead={buh.result.lead}>
      <ul class="checks">
        {buh.result.items.map((it) => <li><span class="checks__ico"><OfficeIcon name="check" /></span><span>{typo(it)}</span></li>)}
      </ul>
      <IconNote icon="trend">
        {typo(buh.result.note)}{' '}<a class="link" href={u(buh.result.noteLink.href)}>{typo(buh.result.noteLink.label)} →</a>
      </IconNote>
    </Sec>

    <Process />

    <Sec id="tarify" title={buh.tariffs.title} white>
      <!-- тарифы — карточки для сравнения, а не таблица (правка №68, 30.10) -->
      <div class="tcards">
        {buh.tariffs.rows.map(([name, who, volume, price]) => (
          <article class="tcard">
            <h3>{typo(name)}</h3>
            <p class="tcard__price">{typo(price)}</p>
            <dl>
              <div><dt>Для кого</dt><dd>{typo(who)}</dd></div>
              <div><dt>Объём в месяц</dt><dd>{typo(volume)}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <ul class="notes">
        {buh.tariffs.notes.map((n) => <li>{typo(n)}</li>)}
      </ul>

      <div class="tables">
        <PriceTable caption={buh.extra.title} head={buh.extra.head} rows={buh.extra.rows} />
        <div>
          <PriceTable caption={buh.payroll.title} head={buh.payroll.head} rows={buh.payroll.rows} />
          <p class="notes notes--one">{typo(buh.payroll.note)}</p>
        </div>
        <PriceTable caption={buh.control.title} head={buh.control.head} rows={buh.control.rows} />
      </div>
    </Sec>

    <Sec id="primer" title={buh.example.title}>
      <div class="example">
        <div class="example__card">
          <p class="example__subj">{typo(buh.example.subject)}</p>
          <ul class="example__params">
            {buh.example.params.map((p) => <li>{typo(p)}</li>)}
          </ul>
        </div>
        <div class="example__calc">
          <PriceTable head={buh.example.head} rows={buh.example.rows} foot={[buh.example.total, ...buh.example.after]} />
        </div>
      </div>
    </Sec>

    <Sec id="dop" title={buh.more.title} white>
      <ul class="more">
        {buh.more.items.map((it) => (
          <li>
            <h3>{typo(it.title)}</h3>
            {it.unit && <p class="more__unit">{typo(it.unit)}</p>}
            {it.price && <p class="more__price">{typo(it.price)}</p>}
          </li>
        ))}
      </ul>
    </Sec>

    <Sec id="voprosy" title={buh.faq.title}>
      <Faq items={buh.faq.items} />
    </Sec>

    <Sec id="keys" title="Кейс по теме" white action={{ label: 'Все кейсы', href: u('/keysy/') }}>
      <CaseCards items={related} />
    </Sec>

    <Request topic={buh.topic} />
  </main>
  <Crumbs items={[{ label: 'Бухгалтерский учёт' }]} />
  <Footer />
</Base>

<style>
  /* «Что входит в сопровождение»: подзаголовок крупно, пункты мельче и сразу под ним, без
     линий (правка №65, 30.10) */
  .subhead { margin: clamp(48px, 6vw, 80px) 0 clamp(16px, 2vw, 24px); font-size: var(--fs-h2); line-height: var(--lh-h2); letter-spacing: var(--tr-h2); }
  .scope { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 32px) clamp(24px, 4vw, 64px); }
  .scope__item { display: grid; gap: 6px; align-content: start; }
  .scope__item h4 { font-size: var(--fs-h6); line-height: 1.25; letter-spacing: var(--tr-h6); }

  /* «Что получает заказчик»: галочка слева на уровне первой строки, текст крупный (№67) */
  .checks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px clamp(24px, 4vw, 64px); }
  .checks li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 16px; align-items: start; font-size: var(--fs-lead); line-height: 1.45; }
  .checks__ico { padding-top: 0.1em; color: var(--c-ink); }

  /* тарифы: карточки одного вида — название, цена, «для кого», объём (№68) */
  .tcards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  .tcard { display: flex; flex-direction: column; gap: 16px; padding: clamp(24px, 2.4vw, 32px); border-radius: var(--r-lg); background: var(--card-bg); }
  .tcard h3 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }
  .tcard__price { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h3); line-height: 1.1; letter-spacing: var(--tr-h3); }
  .tcard dl { display: grid; gap: 12px; margin-top: auto; }
  .tcard dt { font-size: var(--fs-small); font-weight: var(--w-semibold); }
  .tcard dd { margin: 2px 0 0; line-height: 1.4; }

  .notes { display: grid; gap: 8px; margin-top: 20px; max-width: var(--measure-text); font-size: var(--fs-small); line-height: 1.4; }
  .notes--one { display: block; }
  .tables { display: grid; gap: clamp(48px, 6vw, 72px); margin-top: clamp(48px, 6vw, 80px); }

  /* пример расчёта: параметры без тире, плотно; таблица без лишних линий сверху (№71) */
  .example { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .example__card { display: grid; gap: 12px; }
  .example__subj { font-family: var(--ff-display); font-weight: var(--w-display); font-size: var(--fs-h4); letter-spacing: var(--tr-h4); }
  .example__params { display: grid; font-size: var(--fs-lead); line-height: 1.35; }
  .example__params li { padding: 8px 0; }
  .example__params li + li { border-top: 1px solid var(--line-subtle); }

  .more { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(24px, 2.6vw, 36px) clamp(20px, 3vw, 40px); }
  .more li { display: flex; flex-direction: column; gap: 6px; }
  .more h3 { font-family: var(--ff-body); font-weight: var(--w-semibold); font-size: var(--fs-lead); line-height: 1.35; letter-spacing: 0; }
  .more__unit { font-size: var(--fs-small); }
  .more__price { margin-top: auto; padding-top: 4px; font-size: var(--fs-lead); font-weight: var(--w-semibold); }

  @media (max-width: 1100px) {
    .tcards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .more { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .scope, .example, .checks { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .tcards, .more { grid-template-columns: minmax(0, 1fr); }
  }
</style>
