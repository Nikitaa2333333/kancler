---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Audience from '../components/sections/Audience.astro';
import Problems from '../components/sections/Problems.astro';
import Services from '../components/sections/Services.astro';
import Advantages from '../components/sections/Advantages.astro';
import Cases from '../components/sections/Cases.astro';
import Process from '../components/sections/Process.astro';
import About from '../components/sections/About.astro';
import CostFactors from '../components/sections/CostFactors.astro';
import Request from '../components/sections/Request.astro';
import Sec from '../components/page/Sec.astro';
import Faq from '../components/page/Faq.astro';
import { buh } from '../data/buh';
---

<Base
  title="Канцлер — бухгалтерский и управленческий учёт для строительных компаний Москвы и МО"
  description="Бухгалтерский и финансовый учёт для строительных компаний Москвы и МО. Понятная прибыль по каждому объекту, порядок в учёте, налогах и платежах."
>
  <Header />
  <main>
    <Hero />
    <Audience />
    <Problems />
    <Services />
    <Advantages />
    <Cases />
    <Process />
    <About />
    <CostFactors />
    <Request />
    <!-- частые вопросы — те же, что на странице бухучёта (текст клиента), правка №72; после формы — №95 -->
    <Sec id="voprosy" title={buh.faq.title}>
      <Faq items={buh.faq.items} />
    </Sec>
  </main>
  <Footer />
</Base>
