---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import PriceTable from '../../components/page/PriceTable.astro';
import CaseCards from '../../components/page/CaseCards.astro';
import OfficeIcon from '../../components/OfficeIcon.astro';
import Receipt from '../../components/page/Receipt.astro';
import IconList from '../../components/page/IconList.astro';
import Request from '../../components/sections/Request.astro';
import { kazna } from '../../data/kazna';
import { cases } from '../../data/cases';
import { typo, item } from '../../lib/typo';
import { u } from '../../lib/url';

/* Порядок блоков — как в файле клиента. Кейс 3 (казначейский счёт, возврат НДС) —
   по теме страницы. */
const related = cases.filter((c) => c.slug === 'vozvrat-46-mln');
---

<Base title={kazna.seo.title} description={kazna.seo.description}>
  <Header />
  <main>
    <PageHero
      tone="sage"
      title={kazna.hero.title}
      lead={kazna.hero.lead}
      actions={[{ label: kazna.hero.primary, href: '#zayavka' }, { label: kazna.hero.secondary, href: '#zayavka', light: true }]}
      stat={{ value: 'от 45 000 ₽/мес.', label: 'сопровождение одного контракта без аванса' }}
    />

    <Sec id="tarify" title={kazna.monthly.title} lead={kazna.monthly.lead} white>
      <!-- №108: параметры — таблицей по левому краю, «Включено» — знаками, цена — пилюлей внизу -->
      <div class="tariffs bleed">
        {kazna.monthly.tariffs.map((t, i) => (
          <article class="tariff">
            <span class="tariff__ico"><OfficeIcon name={['doc', 'ruble', 'split'][i % 3]} /></span>
            <h3>{typo(t.name)}</h3>
            <p class="tariff__for">{typo(t.for)}</p>
            <dl class="tariff__params">
              {t.params.map(([k, v]) => (
                <div><dt>{typo(k)}</dt><dd>{typo(v)}</dd></div>
              ))}
            </dl>
            <p class="tariff__inc">Включено</p>
            <IconList items={t.included} />
            <p class="pill-price">{typo(t.price)}</p>
          </article>
        ))}
      </div>

      <div class="block-gap">
        <PriceTable caption={kazna.extra.title} head={kazna.extra.head} rows={kazna.extra.rows} />
      </div>
    </Sec>

    <Sec id="buhgalteriya" title={kazna.accounting.title} lead={kazna.accounting.lead}>
      <PriceTable head={kazna.accounting.head} rows={kazna.accounting.rows} />
    </Sec>

    <Sec id="pakety" title={kazna.packages.title} white>
      <!-- пакеты — плашками: что входит строками, итог — пилюлей внизу (№109) -->
      <div class="packs bleed">
        {kazna.packages.items.map((p) => (
          <article class="pack">
            <h3>{typo(p.name)}</h3>
            <p class="pack__for">{typo(p.for)}</p>
            <ul class="pack__rows">
              {p.rows.map(([k, v]) => <li><span>{typo(k)}</span><b>{typo(v)}</b></li>)}
            </ul>
            <p class="pill-price">{typo(`Итого ${p.total}`)}</p>
          </article>
        ))}
      </div>
    </Sec>

    <Sec id="primery" title={kazna.examples.title} white>
      <!-- примеры — «чеком», как на бухучёте (№105) -->
      <div class="examples">
        {kazna.examples.items.map((e) => (
          <Receipt subject={e.name} params={e.params} rows={e.rows} total={[e.rows.length ? 'Итого' : 'Стоимость', e.total]} />
        ))}
      </div>
    </Sec>

    <Sec id="cena" title={kazna.factors.title}>
      <!-- Manrope, линии между пунктами (№110) -->
      <ul class="factors">
        {kazna.factors.items.map((f) => <li>{item(f)}</li>)}
      </ul>
    </Sec>

    <Sec id="keys" title="Кейс по теме" white action={{ label: 'Все кейсы', href: u('/keysy/') }}>
      <CaseCards items={related} />
    </Sec>

    <Request topic={kazna.topic} />
  </main>
  <Crumbs items={[{ label: 'Казначейское сопровождение' }]} />
  <Footer />
</Base>

<style>
  .tariffs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  .tariff { display: flex; flex-direction: column; gap: 14px; padding: clamp(24px, 2.4vw, 32px); border-radius: var(--r-lg); background: var(--card-bg); }
  .tariff__ico { display: block; width: 32px; color: var(--c-ink); --icon-bg: var(--card-bg); }
  .tariff h3, .pack h3 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }
  .tariff h3 + .tariff__for, .pack h3 + .pack__for { margin-top: -6px; font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.4; }
  /* таблица параметров — обе колонки по левому краю, без дыр (№108) */
  .tariff__params { display: grid; }
  .tariff__params div { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 14px; padding: 8px 0; }
  .tariff__params div + div { border-top: 1px solid var(--line-subtle); }
  .tariff__params dt { font-size: var(--fs-small); line-height: 1.35; }
  .tariff__params dd { margin: 0; font-weight: var(--w-semibold); line-height: 1.35; }
  .tariff__inc { margin-top: 4px; font-weight: var(--w-semibold); }
  /* цена — пилюлей внизу карточки, как в тарифах бухучёта (№100) */
  /* цена внизу карточки — просто текстом, без подложки и черты (№124, №136) */
  .pill-price { margin-top: auto; padding-top: 8px; font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.3; }
  .tariff .ilist { margin-bottom: 8px; }
  .block-gap { margin-top: clamp(48px, 6vw, 80px); }

  .packs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--card-gap); }
  .pack { display: flex; flex-direction: column; gap: 14px; padding: clamp(24px, 2.4vw, 32px); border-radius: var(--r-lg); background: var(--card-bg); }
  .pack__rows { display: grid; margin-bottom: 8px; }
  .pack__rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 8px 0; line-height: 1.35; }
  .pack__rows li + li { border-top: 1px solid var(--line-subtle); }
  /* <b> — цена строки пакета, не выделение во фразе */
  .pack__rows b { flex: none; font-weight: var(--w-semibold); white-space: nowrap; }

  .examples { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--card-gap); align-items: start; }

  .factors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(24px, 4vw, 64px); max-width: 1000px; font-size: var(--fs-lead); line-height: 1.4; }
  .factors li { padding: 12px 0; }
  .factors li:nth-child(n + 3) { border-top: 1px solid var(--line-subtle); }

  @media (max-width: 1100px) { .tariffs { grid-template-columns: minmax(0, 1fr); max-width: 640px; } }
  @media (max-width: 860px) { .packs { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .factors { grid-template-columns: minmax(0, 1fr); }
    .factors li:nth-child(2) { border-top: 1px solid var(--line-subtle); }
    .pack__rows li { display: grid; gap: 2px; }
  }
  @media (max-width: 560px) { .tariff__params div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
