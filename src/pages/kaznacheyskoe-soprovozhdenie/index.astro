---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import PriceTable from '../../components/page/PriceTable.astro';
import OfficeIcon from '../../components/OfficeIcon.astro';
import Receipt from '../../components/page/Receipt.astro';
import IconList from '../../components/page/IconList.astro';
import Request from '../../components/sections/Request.astro';
import { kazna } from '../../data/kazna';
import { cases } from '../../data/cases';
import { typo, item } from '../../lib/typo';
import { u } from '../../lib/url';

/* Порядок блоков — как в файле клиента. Кейс 3 (казначейский счёт, возврат НДС) —
   по теме страницы. */
---

<Base title={kazna.seo.title} description={kazna.seo.description}>
  <Header />
  <main>
    <PageHero
      tone="sky"
      title={kazna.hero.title}
      lead={kazna.hero.lead}
      actions={[{ label: kazna.hero.primary, href: '#zayavka' }, { label: kazna.hero.secondary, href: '#zayavka', light: true }]}
      /* №171: цена сразу на первом экране — «от 2 000 ₽ за платёж», как у конкурентов (со встречи
         с заказчицей; звучали и 20–25 тыс. — уточнить). Пакетные тарифы — ниже по странице */
      stat={{ value: '2 000 ₽', label: 'за 1 поручение' }}  /* Ирина, 03.11.2026 */
    />

    <Sec id="tarify" title={kazna.monthly.title} lead={kazna.monthly.lead} white>
      <!-- №108: параметры — таблицей по левому краю, «Включено» — знаками, цена — пилюлей внизу -->
      <div class="tariffs bleed">
        {kazna.monthly.tariffs.map((t, i) => (
          <article class="tariff">
            <span class="tariff__ico"><OfficeIcon name={['doc', 'ruble', 'split'][i % 3]} /></span>
            <h3>{typo(t.name)}</h3>
            <p class="tariff__for">{typo(t.for)}</p>
            <dl class="tariff__params">
              {t.params.map(([k, v]) => (
                <div><dt>{typo(k)}</dt><dd>{typo(v)}</dd></div>
              ))}
            </dl>
            <p class="tariff__inc">Включено</p>
            <IconList items={t.included} />
            <p class="pill-price">{typo(t.price)}</p>
          </article>
        ))}
      </div>

      <div class="block-gap">
        <PriceTable caption={kazna.extra.title} head={kazna.extra.head} rows={kazna.extra.rows} />
      </div>
    </Sec>

    <Sec id="buhgalteriya" title={kazna.accounting.title} lead={kazna.accounting.lead}>
      <!-- №217: услуги — карточками, как тарифы и пакеты, а не таблицей -->
      <ul class="acc bleed">
        {kazna.accounting.rows.map(([name, what, price]) => (
          <li class="acc__card">
            <h3>{typo(name)}</h3>
            <p class="acc__what">{typo(what)}</p>
            <p class="pill-price">{typo(price)}</p>
          </li>
        ))}
      </ul>
    </Sec>

    <Sec id="pakety" title={kazna.packages.title} white>
      <!-- пакеты — плашками: что входит строками, итог — пилюлей внизу (№109) -->
      <div class="packs bleed">
        {kazna.packages.items.map((p, i) => (
          <article class="pack">
            <h3><span class="pack__ico"><OfficeIcon name={['check', 'ruble', 'briefcase', 'folder'][i % 4]} /></span>{typo(p.name)}</h3>
            <p class="pack__for">{typo(p.for)}</p>
            <ul class="pack__rows">
              {p.rows.map(([k, v]) => <li><span>{typo(k)}</span><b>{typo(v)}</b></li>)}
            </ul>
            <p class="pill-price">{typo(`Итого ${p.total}`)}</p>
          </article>
        ))}
      </div>
    </Sec>

    <Sec id="primery" title={kazna.examples.title} white center>
      <!-- №279: примеры переключаются пилюлями «Пример 1 / 2 / 3», виден один чек по центру —
           не сливаются. Без JS — все три друг под другом. Чек — как на бухучёте (№105) -->
      <div class="examples" data-ex>
        <div class="extabs" role="tablist" aria-label="Примеры расчёта">
          {kazna.examples.items.map((e, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ex-tab={String(i)}>{typo(e.name.replace(/^Пример \d+\.\s*/, ''))}</button>
          ))}
        </div>
        {kazna.examples.items.map((e, i) => (
          <div class="ex" data-ex-panel={String(i)}>
            <h3 class="ex__title">{typo(e.name)}</h3>
            <Receipt params={e.params} rows={e.rows} total={[e.rows.length ? 'Итого' : 'Стоимость', e.total]} />
          </div>
        ))}
      </div>
    </Sec>

    <Sec id="cena" title={kazna.factors.title}>
      <!-- Manrope, линии между пунктами (№110) -->
      <ul class="factors">
        {kazna.factors.items.map((f) => <li>{item(f)}</li>)}
      </ul>
    </Sec>

    <!-- кейс про возмещение НДС к казначейству не относится — снят, остался на бухучёте (№169) -->
    <Request topic={kazna.topic} />
  </main>
  <Crumbs items={[{ label: 'Казначейское сопровождение' }]} />
  <Footer />
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-ex]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-ex-tab]')];
    const show = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.exTab === id)));
      root.querySelectorAll<HTMLElement>('[data-ex-panel]').forEach((p) => { p.hidden = p.dataset.exPanel !== id; });
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.exTab!)));
    root.classList.add('is-on');
    show('0');
  });
</script>

<style>
  .tariffs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  .tariff { display: flex; flex-direction: column; gap: 10px; padding: var(--card-pad); border-radius: var(--r-xl); background: var(--card-bg); }
  .tariff__ico { display: block; width: 32px; color: var(--c-heading); --icon-bg: var(--card-bg); }
  .tariff h3, .pack h3 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }
  .tariff h3 + .tariff__for, .pack h3 + .pack__for { margin-top: -6px; font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.4; }
  /* таблица параметров — обе колонки по левому краю, без дыр (№108) */
  .tariff__params { display: grid; }
  .tariff__params div { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 14px; padding: 8px 0; }
  .tariff__params div + div { border-top: 1px solid var(--line-subtle); }
  .tariff__params dt { font-size: var(--fs-small); line-height: 1.35; }
  .tariff__params dd { margin: 0; font-weight: var(--w-semibold); line-height: 1.35; }
  .tariff__inc { margin-top: 6px; font-weight: var(--w-semibold); }  /* без дыр (№217) */
  .tariff__params { margin-top: 4px; }
  /* цена — пилюлей внизу карточки, как в тарифах бухучёта (№100) */
  /* цена внизу карточки — просто текстом, без подложки и черты (№124, №136) */
  .pill-price { margin-top: auto; padding-top: 8px; font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.3; }
  .tariff .ilist { margin-bottom: 4px; }
  .acc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  .acc__card { display: flex; flex-direction: column; gap: var(--card-in); padding: var(--card-pad); border-radius: var(--r-xl); background: var(--card-bg); }
  .acc__card h3 { font-family: var(--ff-body); font-size: var(--fs-lead); font-weight: var(--w-semibold); line-height: 1.3; letter-spacing: 0; }
  .acc__what { font-size: var(--fs-small); line-height: 1.4; }
  .acc__card h3 + .acc__what { margin-top: -4px; }  /* описание вплотную к заголовку (№245) */
  /* цена чёрным, как в пакетах и примерах (№244) */
  @media (max-width: 1000px) { .acc { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .acc { grid-template-columns: minmax(0, 1fr); } }
  .block-gap { margin-top: clamp(48px, 6vw, 80px); }

  .packs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--card-gap); }
  .pack { display: flex; flex-direction: column; gap: 10px; padding: var(--card-pad); border-radius: var(--r-xl); background: var(--card-bg); }
  /* знак — внутри заголовка, на уровне текста, без отдельной строки (№148) */
  .pack__ico { display: inline-block; width: 0.95em; margin-right: 0.35em; vertical-align: -0.12em; color: var(--c-heading); --icon-bg: var(--card-bg); }
  .pack__rows { display: grid; margin-bottom: 8px; }
  .pack__rows li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 8px 0; line-height: 1.35; }
  .pack__rows li + li { border-top: 1px solid var(--line-subtle); }
  /* <b> — цена строки пакета, не выделение во фразе */
  .pack__rows b { flex: none; font-weight: var(--w-semibold); white-space: nowrap; }

  /* №279: примеры — пилюли-переключатель по центру, один чек по центру; заголовок над чеком (№260) */
  .examples { display: grid; gap: clamp(28px, 3vw, 40px); }
  .extabs { display: none; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .examples.is-on .extabs { display: flex; }
  .examples.is-on .ex[hidden] { display: none; }
  .extabs button { min-height: 44px; padding: 8px 20px; border: 1.5px solid var(--c-band); border-radius: 999px; background: var(--c-band); color: var(--c-ink); font: inherit; font-size: 15px; font-weight: var(--w-semibold); line-height: 1.2; cursor: pointer; transition: border-color .2s, background-color .2s, color .2s; }
  .extabs button:hover { border-color: var(--c-primary); color: var(--c-primary); }
  .extabs button[aria-selected='true'] { border-color: var(--c-primary); background: var(--c-primary); color: var(--c-white); }
  @media (max-width: 760px) {
    /* телефон: пилюли лентой до краёв экрана, листаются вбок (как тарифы бухучёта, №248) */
    .examples.is-on .extabs { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; scrollbar-width: none;
      --edge: calc(var(--hero-frame) + var(--gutter)); margin-inline: calc(-1 * var(--edge)); padding-inline: var(--edge); }
    .extabs::-webkit-scrollbar { display: none; }
    .extabs button { flex: none; white-space: nowrap; }
  }
  .ex { display: grid; justify-items: center; gap: 14px; }
  .ex > :global(.receipt) { width: 100%; }
  .ex__title { max-width: 680px; text-align: center; font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }

  .factors { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(24px, 4vw, 64px); max-width: 1000px; font-size: var(--fs-lead); line-height: 1.4; }
  .factors li { padding: 12px 0; }
  .factors li:nth-child(n + 3) { border-top: 1px solid var(--line-subtle); }

  @media (max-width: 1100px) { .tariffs { grid-template-columns: minmax(0, 1fr); max-width: 640px; } }
  @media (max-width: 860px) { .packs { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .factors { grid-template-columns: minmax(0, 1fr); }
    .factors li:nth-child(2) { border-top: 1px solid var(--line-subtle); }
    .pack__rows li { display: grid; gap: 2px; }
  }
  @media (max-width: 560px) { .tariff__params div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
