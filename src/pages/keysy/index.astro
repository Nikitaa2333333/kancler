---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Sec from '../../components/page/Sec.astro';
import CaseCards from '../../components/page/CaseCards.astro';
import Request from '../../components/sections/Request.astro';
import { cases, casesPage } from '../../data/cases';
---

<Base title={casesPage.seo.title} description={casesPage.seo.description}>
  <Header />
  <main>
    <PageHero
      crumbs={[{ label: 'Кейсы' }]}
      title={casesPage.title}
      actions={[{ label: 'Получить консультацию', href: '#zayavka' }]}
      stat={{ value: '≈ 46 млн ₽', label: 'вернули в оборот строительной компании — кейс 3' }}
    />
    <Sec white>
      <CaseCards items={cases} />
    </Sec>
    <Request topic="Кейсы" />
  </main>
  <Footer />
</Base>
