---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Request from '../../components/sections/Request.astro';
import { company } from '../../data/company';

---

<Base
  title="Контакты — Канцлер, бухгалтерский и управленческий учёт для строительных компаний"
  description={`Контакты «Канцлера»: ${company.leadEmail}, ${company.hours}. ${company.region}, работаем дистанционно.`}
>
  <Header />
  <main>
    <PageHero
      title="Контакты"
      lead={`${company.remote}. ${company.region}, ${company.hours}.`}
    />
    <Request topic="Контакты" />
  </main>
  <Crumbs items={[{ label: 'Контакты' }]} />
  <Footer />
</Base>
