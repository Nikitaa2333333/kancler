---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Request from '../../components/sections/Request.astro';
import MaxIcon from '../../components/MaxIcon.astro';
import { company } from '../../data/company';

---

<Base
  title="Контакты — Канцлер, бухгалтерский и управленческий учёт для строительных компаний"
  description={`Контакты «Канцлера»: ${company.leadEmail}, ${company.hours}. ${company.region}, работаем дистанционно.`}
  writeUs={false}
>
  <Header />
  <main>
    <PageHero
      title="Контакты"
      lead={`${company.remote}. ${company.region}, ${company.hours}.`}
    />
    {/* Макс — блоком на странице вместо плавающей кнопки (10.11.2026, пользователь) */}
    {company.max && (
      <section class="sec mx" aria-labelledby="mx-title">
        <div class="wrap mx__row">
          <h2 id="mx-title" class="mx__title">Напишите нам в&nbsp;Максе</h2>
          <a class="btn mx__btn" href={company.max} target="_blank" rel="noopener">
            <span class="mx__ic"><MaxIcon /></span>Написать в&nbsp;Максе
          </a>
        </div>
      </section>
    )}
    <Request topic="Контакты" />
  </main>
  <Crumbs items={[{ label: 'Контакты' }]} />
  <Footer />
</Base>

<style>
  .mx__row { display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; }
  .mx__title { margin: 0; }
  .mx__btn { gap: 12px; padding-left: 8px; }
  .mx__ic {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--c-white);
    color: var(--c-primary);
  }
  .mx__ic :global(svg) { width: 22px; height: 22px; }
  @media (max-width: 640px) {
    .mx__row { flex-direction: column; align-items: stretch; }
    /* кнопка по краям плашек (6 px от экрана), а не во всю ширину */
    .mx__row .mx__btn { width: calc(100% + 2 * var(--gutter) - 2 * var(--hero-frame)); margin-inline: calc(var(--hero-frame) - var(--gutter)); }
  }
</style>
