---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';

/* №313: политика обработки персональных данных — ШАБЛОН по 152-ФЗ. Реквизиты оператора берутся
   из company.ts; пока клиент их не прислала, на их месте жёлтая пометка «уточняется» (видно, что
   заменить, ничего не выдумано). Перед запуском — сверить с юристом клиента и заполнить
   legalName / inn / ogrn и адрес. Страница закрыта от индексации до заполнения. */
const filled = Boolean(company.legalName && company.inn && company.ogrn);
const todo = (what: string) => `<mark class="todo" data-design-ok>уточняется: ${what}</mark>`;
const operator = company.legalName || todo('наименование оператора (юрлицо или ИП)');
const inn = company.inn || todo('ИНН');
const ogrn = company.ogrn || todo('ОГРН / ОГРНИП');
const email = company.leadEmail;
const sections: { h: string; id?: string; p: string[] }[] = [
  { h: '1. Общие положения', p: [
    `Настоящая политика определяет порядок обработки и защиты персональных данных пользователей сайта «${company.name}» в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных».`,
    `Оператор персональных данных — ${operator}, ИНН ${inn}, ОГРН ${ogrn}, адрес: ${todo('юридический адрес')}. Электронная почта для обращений: ${email}.`,
    'Отправляя форму на сайте, пользователь подтверждает согласие с настоящей политикой.',
  ] },
  { h: '2. Какие данные мы обрабатываем', id: 'cookie', p: [
    'Имя и номер телефона, которые пользователь указывает в форме заявки, а также текст сообщения, если он его оставил.',
    'Технические данные о посещении сайта: файлы cookie, IP-адрес, сведения о браузере и устройстве, страницы и время посещения. Эти данные собирает сервис веб-аналитики «Яндекс Метрика» в обезличенном виде.',
  ] },
  { h: '3. Цели обработки', p: [
    'Связаться с пользователем по его заявке, ответить на вопрос, подготовить предложение об оказании услуг.',
    'Анализировать посещаемость и улучшать работу сайта.',
  ] },
  { h: '4. Правовые основания', p: [
    'Согласие пользователя на обработку персональных данных, которое он даёт, отмечая галочку в форме заявки (п. 1 ч. 1 ст. 6 № 152-ФЗ).',
  ] },
  { h: '5. Как мы обрабатываем и храним данные', p: [
    'Данные из формы поступают оператору на электронную почту и обрабатываются только сотрудниками, которым они нужны для ответа на заявку.',
    'Персональные данные граждан Российской Федерации записываются, систематизируются и хранятся в базах данных, находящихся на территории Российской Федерации (ч. 5 ст. 18 № 152-ФЗ).',
    'Данные хранятся до достижения цели обработки или до отзыва согласия, после чего уничтожаются.',
    'Оператор принимает правовые, организационные и технические меры для защиты данных от неправомерного доступа, изменения, распространения и уничтожения.',
  ] },
  { h: '6. Передача третьим лицам', p: [
    'Оператор не продаёт и не передаёт персональные данные третьим лицам, кроме случаев, предусмотренных законодательством Российской Федерации.',
    'Обезличенные технические данные обрабатывает ООО «Яндекс» как сервис веб-аналитики «Яндекс Метрика».',
  ] },
  { h: '7. Права пользователя', p: [
    `Пользователь вправе получить сведения об обработке своих данных, потребовать их уточнения, блокирования или уничтожения, а также отозвать согласие, направив письмо на ${email}. Оператор отвечает в течение 10 рабочих дней.`,
    'Отключить cookie можно в настройках браузера; часть функций сайта при этом может работать некорректно.',
  ] },
  { h: '8. Изменение политики', p: [
    `Оператор может обновлять политику; новая редакция действует с момента публикации на этой странице. Дата редакции: ${todo('дата')}.`,
  ] },
];
---

<Base title="Политика обработки персональных данных — Канцлер" description="Политика обработки персональных данных пользователей сайта «Канцлер»." noindex={!filled}>
  <Header />
  <main>
    <PageHero title="Политика обработки персональных данных" />
    <Sec white>
      {!filled && (
        <p class="pol__note">{typo('Шаблон: реквизиты оператора и дата редакции появятся, когда их пришлёт заказчик. До этого страница закрыта от поисковиков.')}</p>
      )}
      <div class="pol">
        {sections.map((s) => (
          <section id={s.id}>
            <h2>{typo(s.h)}</h2>
            {s.p.map((t) => <p set:html={typo(t)} />)}
          </section>
        ))}
      </div>
    </Sec>
  </main>
  <Crumbs items={[{ label: 'Политика обработки персональных данных' }]} />
  <Footer />
</Base>

<style>
  .pol { display: grid; gap: clamp(28px, 3vw, 40px); max-width: var(--measure-text); }
  .pol section { display: grid; gap: 12px; }
  .pol h2 { font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--tr-h4); }
  .pol p { font-size: var(--fs-lead); line-height: 1.55; }
  .pol__note { max-width: var(--measure-text); margin-bottom: clamp(24px, 3vw, 36px); padding: 14px 18px; border-radius: var(--r-md); background: var(--c-band); font-size: var(--fs-body); }
  .pol :global(mark.todo) { padding: 0 4px; border-radius: 4px; background: #fff1b8; color: var(--c-ink); }
</style>
