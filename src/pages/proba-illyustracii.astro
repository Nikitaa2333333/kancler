---
/* Проба стилей иллюстраций (№195, 02.11.2026): блок «Типичные ситуации» в двух вариантах —
   3D-модельки и 2D-иллюстрации. Картинки сгенерированы в Figma (файл «Канцлер — иллюстрации
   (тест стилей)»), фон вырезан. Страница служебная: в меню нет. */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Problems from '../components/sections/Problems.astro';
---

<Base title="Проба иллюстраций — Канцлер" description="Служебная страница: сравнение стилей иллюстраций.">
  <Header />
  <main class="proba">
    <Problems art="3d" id="v3d" title="Вариант А — 3D: типичные ситуации, с которыми приходят строительные компании" />
    <Problems art="2d" id="v2d" title="Вариант Б — 2D: типичные ситуации, с которыми приходят строительные компании" />
    <Problems id="vicons" title="Сейчас на сайте — знаки: типичные ситуации, с которыми приходят строительные компании" />
  </main>
  <Footer />
</Base>

<style>
  .proba { padding-top: var(--hdr-h); }
</style>
