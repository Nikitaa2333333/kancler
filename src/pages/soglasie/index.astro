---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import { company } from '../../data/company';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

/* Согласие посетителя на обработку ПД — текст клиента дословно (файл
   «2_согласие_посетителей_сайта_на_обработку_персональных_данных.docx», Ирина, 06.11.2026).
   С 01.09.2025 согласие по 152-ФЗ — отдельный документ, не часть политики; на него ведёт
   галочка в форме заявки. Единственная правка: «ОГРНИП» → «ОГРН» (у ООО — ОГРН). */
const email = company.leadEmail;
const blocks: (string | string[])[] = [
  `Субъект персональных данных — посетитель сайта https://kancler-fin.ru/ (далее — Сайт), даёт согласие ${company.legalNameFull} (ИНН: ${company.inn}, ОГРН ${company.ogrn}, адрес: г. Москва, ул. Юлиана Семенова, д. 8, к. 1, кв. 588) на обработку с использованием средств автоматизации и без использования таковых путём сбора; записи; систематизации; накопления; хранения; уточнения (обновления, изменения); извлечения; использования; передачи (предоставления, доступа), блокирования; удаления; уничтожения персональных данных:`,
  ['в целях направления заявки для записи на консультацию с помощью функционала Сайта — ФИО (имя); контактный телефон; адрес электронной почты.'],
  'Субъект соглашается с передачей его персональных данных, указанных в настоящем Согласии:',
  ['Обществу с ограниченной ответственностью «Яндекс», ИНН 7736207543;', 'Обществу с ограниченной ответственностью «ВК», ИНН 7743001840.'],
  'Обработка персональных данных может быть прекращена по запросу субъекта персональных данных.',
  `Отзыв Согласия на обработку персональных данных может быть осуществлён путём направления соответствующего уведомления посредством электронной почты на электронный адрес Оператора: ${email} с пометкой «Отзыв согласия на обработку персональных данных».`,
  'В случае отзыва Пользователем согласия на обработку своих персональных данных Оператор обязан прекратить обработку персональных данных и уничтожить персональные данные. Об уничтожении персональных данных Оператор обязан уведомить субъекта персональных данных.',
  'Срок действия согласия — до отзыва согласия Пользователем.',
];
---

<Base title="Согласие на обработку персональных данных — Канцлер" description="Согласие посетителя сайта «Канцлер» на обработку персональных данных.">
  <Header />
  <main>
    <PageHero title="Согласие посетителя сайта на обработку персональных данных" />
    <Sec white>
      <div class="sog">
        {blocks.map((b) => Array.isArray(b)
          ? <ul>{b.map((li) => <li>{typo(li)}</li>)}</ul>
          : <p>{typo(b)}</p>)}
        <p set:html={typo(`Как мы обрабатываем и защищаем данные — в <a href="${u('/politika/')}">политике обработки персональных данных</a>.`)} />
      </div>
    </Sec>
  </main>
  <Crumbs items={[{ label: 'Согласие на обработку персональных данных' }]} />
  <Footer />
</Base>

<style>
  .sog { display: grid; gap: 16px; max-width: var(--measure-text); }
  .sog p, .sog li { font-size: var(--fs-lead); line-height: 1.55; }
  .sog ul { display: grid; gap: var(--bullet-gap-short); }
  .sog li { position: relative; padding-left: var(--bullet-indent); }
  /* маркер проекта — тонкое тире на токенах (tokens.css, «Перечисления») */
  .sog li::before { content: ''; position: absolute; left: 0; top: 0.78em; width: var(--bullet-size); height: 1.5px; background: currentColor; }
</style>
