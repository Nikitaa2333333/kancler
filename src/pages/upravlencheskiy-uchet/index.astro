---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/page/PageHero.astro';
import Crumbs from '../../components/page/Crumbs.astro';
import Sec from '../../components/page/Sec.astro';
import PriceTable from '../../components/page/PriceTable.astro';
import CaseCards from '../../components/page/CaseCards.astro';
import Request from '../../components/sections/Request.astro';
import { upr } from '../../data/upr';
import { cases } from '../../data/cases';
import { typo } from '../../lib/typo';
import { u } from '../../lib/url';

const related = cases.filter((c) => c.slug !== 'vozvrat-46-mln');
---

<Base title={upr.seo.title} description={upr.seo.description}>
  <Header />
  <main>
    <PageHero
      title={upr.hero.title}
      lead={upr.hero.lead}
      actions={[{ label: upr.hero.primary, href: '#zayavka' }, { label: upr.hero.secondary, href: '#stoimost', light: true }]}
      stat={{ value: 'от 30 000 ₽', label: 'отчёт о движении денежных средств (ОДДС)' }}
    />

    <Sec id="napravleniya" title={upr.blocks.title} white>
      <div class="blocks bleed">
        {upr.blocks.items.map((b, i) => (
          <article class={`blk blk--${['blue', 'sand', 'sage'][i % 3]}`}>
            <h3>{`${i + 1}. `}{typo(b.title)}</h3>
            {b.tagline && <p class="blk__tag">{typo(b.tagline)}</p>}
            {b.text.map((t) => <p>{typo(t)}</p>)}
          </article>
        ))}
      </div>
    </Sec>

    <Sec id="kak-rabotaem" title={upr.sequences.title} white>
      <!-- три последовательности — плашками в ряд, на телефоне листаются вбок (№142) -->
      <div class="seqs bleed">
        {upr.sequences.items.map((s) => (
          <div class="seq">
            <h3>{typo(s.title)}</h3>
            <ol>
              {s.steps.map((st, i) => (
                <li>
                  <h4>{`${i + 1}. `}{typo(st.title)}</h4>
                  {st.text && <p>{typo(st.text)}</p>}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </Sec>

    <Sec id="stoimost" title={upr.prices.title} white>
      <PriceTable head={upr.prices.head} rows={upr.prices.rows} />
    </Sec>

    <Sec id="podhod">
      <div class="about">
        <h2>{typo(upr.about.title)}</h2>
        <div class="about__text">
          {upr.about.text.map((t) => <p class="lead">{typo(t)}</p>)}
        </div>
      </div>
    </Sec>

    <Sec id="keysy" title="Кейсы по теме" white action={{ label: 'Все кейсы', href: u('/keysy/') }}>
      <CaseCards items={related} />
    </Sec>

    <Request topic={upr.topic} />
  </main>
  <Crumbs items={[{ label: 'Управленческий учёт' }]} />
  <Footer />
</Base>

<style>
  .blocks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); }
  /* три направления — плашки с крупной цифрой (№111) */
  /* компактнее внутри (№140) */
  .blk { display: flex; flex-direction: column; gap: 8px; padding: clamp(18px, 1.8vw, 24px); border-radius: var(--r-lg); background: var(--card-bg); }
  /* знак вместо одинокой цифры, номер — внутри заголовка (№133, №135) */
  /* заголовок крупнее, без значков; цвет — как плашки услуг на главной (№141) */
  .blk h3 { font-size: clamp(26px, 2.4vw, 32px); line-height: var(--lh-h3); letter-spacing: var(--tr-h3); }
  .blk--blue { background: var(--c-tone-blue); }
  .blk--sand { background: var(--c-tone-sand); }
  .blk--sage { background: var(--c-tone-sage); }
  .blk p { line-height: 1.45; }
  .blk__tag { font-weight: var(--w-semibold); line-height: 1.35; }  /* плотнее (№134) */

  .seqs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--card-gap); align-items: stretch; }
  .seq { display: grid; align-content: start; padding: clamp(18px, 1.8vw, 24px); border-radius: var(--r-lg); background: var(--card-bg); }
  .seq h3 { margin-bottom: 8px; font-size: var(--fs-h5); line-height: 1.2; letter-spacing: var(--tr-h5); }
  .seq ol { display: grid; }
  .seq li { display: grid; padding: 10px 0; }
  .seq li + li { border-top: 1px solid var(--line-subtle); }
  /* номер внутри заголовка «1. …», заголовок плотнее, отступ до описания больше (№133) */
  .seq h4 { font-family: var(--ff-body); font-size: var(--fs-lead); font-weight: var(--w-semibold); letter-spacing: 0; line-height: 1.25; }
  .seq p { margin-top: 8px; line-height: 1.45; }

  .about { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .about__text { display: grid; gap: 16px; }

  @media (max-width: 1100px) { .blocks { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 860px) {
    .seqs { display: flex; gap: var(--card-gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .seqs::-webkit-scrollbar { display: none; }
    .seq { flex: 0 0 86%; scroll-snap-align: start; }
  }
  @media (max-width: 860px) { .about { grid-template-columns: minmax(0, 1fr); } }
</style>
